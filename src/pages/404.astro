---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import I18nText from '@/components/I18nText.astro';
import { getOrderedProjects, projectPath } from '@/lib/projects';
import { getProjectImage } from '@/lib/images';

// A storyboard sheet with one panel missing. The shots before and after it
// are real projects, drawn at random on each visit.
const projects = await getOrderedProjects();
const shots = projects.map((project) => ({
  id: project.id,
  title: project.data.title,
  alt: project.data.coverAlt.en,
  img: getProjectImage(project.id, project.data.cover),
}));
---

<Base path="/404" title="Page not found, Menghan LI" description="This page is not in the film." bodyClass="not-found" noindex>
  <section class="lost" data-lost>
    <h1>
      <span class="lost-code"><I18nText en="404?" fr="404 ?" zh="404？" /></span>
      <I18nText en="I never drew this shot." fr="Ce plan, je ne l'ai jamais dessiné." zh="这个镜头我没有画过。" />
    </h1>

    <div class="sheet">
      <div class="sheet-head" aria-hidden="true">
        <span><I18nText en="shot" fr="plan" zh="镜号" /></span>
        <span><I18nText en="frame" fr="image" zh="画面" /></span>
        <span><I18nText en="action" fr="action" zh="内容" /></span>
        <span><I18nText en="dialogue" fr="dialogue" zh="台词" /></span>
      </div>

      {[403, 404, 405].map((num) => (
        <div class:list={['row', { 'is-missing': num === 404 }]}>
          <span class="row-num">{num}</span>
          {num === 404 ? (
            <>
              <div class="row-frame" aria-hidden="true">
                <div class="frame frame-empty">
                  <svg viewBox="0 0 160 90">
                    <path class="x x1" d="M4 5 C 50 32, 104 58, 156 85" pathLength="1" />
                    <path class="x x2" d="M155 4 C 108 34, 56 60, 5 86" pathLength="1" />
                  </svg>
                </div>
              </div>
              <p class="row-action">
                <I18nText
                  en="Empty frame. The page you are looking for is not in this film."
                  fr="Case vide. La page que tu cherches n'est pas dans ce film."
                  zh="空镜。你要找的页面不在这部片子里。"
                />
              </p>
              <p class="row-line">
                <I18nText en="(off screen) Anyone there?" fr="(hors champ) Il y a quelqu'un ?" zh="（画外）有人吗？" />
              </p>
            </>
          ) : (
            <>
              <div class="row-frame">
                <div class="frame" data-shot-slot>
                  {shots.map((shot, i) => (
                    <a href={projectPath(shot.id)} data-shot={i} hidden={i !== (num === 403 ? 0 : 1)} tabindex="-1" aria-hidden="true" data-cursor-hover>
                      <Image src={shot.img} alt={shot.alt} width={480} loading="lazy" />
                    </a>
                  ))}
                </div>
              </div>
              <p class="row-action" data-shot-slot>
                {shots.map((shot, i) => (
                  <a href={projectPath(shot.id)} data-shot={i} hidden={i !== (num === 403 ? 0 : 1)}>
                    {num === 403 ? (
                      <I18nText en={`Previous shot: ${shot.title}`} fr={`Plan précédent : ${shot.title}`} zh={`上一个镜头：${shot.title}`} />
                    ) : (
                      <I18nText en={`Next shot: ${shot.title}`} fr={`Plan suivant : ${shot.title}`} zh={`下一个镜头：${shot.title}`} />
                    )}
                  </a>
                ))}
              </p>
              <p class="row-line" aria-hidden="true"></p>
            </>
          )}
        </div>
      ))}
    </div>

    <a class="lost-back" href={import.meta.env.BASE_URL} data-cursor-hover>
      <I18nText en="Back to all my work" fr="Revenir à tous mes projets" zh="回到我的全部作品" />
    </a>
  </section>
</Base>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: calc(var(--space-6) + 2rem) var(--edge) var(--space-6);
    text-align: center;
  }

  .lost h1 {
    font-size: var(--text-2xl);
    line-height: 1.05;
    max-width: 20ch;
    text-wrap: balance;
  }

  .lost-code {
    color: var(--gold);
  }

  /* the paper: off-white, graphite lines, a little crooked on the desk */
  .sheet {
    --ink: #3c3a37;
    --rule: #b9b3a8;
    --blue: #2f63c9;
    width: min(100%, 60rem);
    margin-top: var(--space-2);
    padding: clamp(0.8rem, 2vw, 1.4rem);
    background: #f4f0e8;
    color: var(--ink);
    text-align: left;
    rotate: -0.6deg;
    box-shadow: 0 2.5rem 5rem -2rem rgb(0 0 0 / 80%), 0 0 0 1px rgb(0 0 0 / 8%);
  }

  .sheet-head,
  .row {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 0.8fr);
    border: 1px solid var(--rule);
    border-top: 0;
  }

  .sheet-head {
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7b766d;
  }

  .sheet-head > span,
  .row > * {
    padding: 0.55rem 0.7rem;
    border-left: 1px solid var(--rule);
  }

  .sheet-head > span:first-child,
  .row > :first-child {
    border-left: 0;
  }

  .row-num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: #7b766d;
  }

  .is-missing .row-num {
    color: var(--blue);
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1.5px solid var(--ink);
    overflow: hidden;
    background: #e9e4da;
  }

  [data-shot][hidden] {
    display: none !important;
  }

  .frame a,
  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .frame :global(img) {
    object-fit: cover;
    filter: grayscale(1) contrast(1.05) brightness(1.08);
    mix-blend-mode: multiply;
    transition: filter 0.5s var(--ease-out-expo);
  }

  .frame a:hover :global(img),
  .frame a:focus-visible :global(img) {
    filter: none;
    mix-blend-mode: normal;
  }

  .frame-empty {
    background: transparent;
  }

  .frame-empty svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* blue pencil crossing out the empty frame, the way a board marks a cut shot */
  .x {
    fill: none;
    stroke: var(--blue);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: pencil 0.7s cubic-bezier(0.6, 0, 0.3, 1) forwards;
    animation-delay: 0.6s;
  }

  .x2 {
    animation-delay: 1.35s;
  }

  @keyframes pencil {
    to { stroke-dashoffset: 0; }
  }

  .row-action,
  .row-line {
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .row-action a {
    color: var(--ink);
    text-decoration-color: color-mix(in srgb, var(--ink) 35%, transparent);
    text-underline-offset: 0.2em;
  }

  .row-action a:hover {
    text-decoration-color: var(--ink);
  }

  .is-missing .row-action,
  .is-missing .row-line {
    color: var(--blue);
    font-family: var(--font-display);
    font-style: italic;
  }

  .lost-back {
    margin-top: var(--space-3);
    padding: 0.7em 1.4em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bone);
    border: 1px solid color-mix(in srgb, var(--gold) 60%, transparent);
    border-radius: 999px;
    transition: background-color var(--dur-fast), color var(--dur-fast);
  }

  .lost-back:hover,
  .lost-back:focus-visible {
    color: var(--void);
    background: var(--gold);
  }

  /* phone: the action and dialogue go under the frame, like a board read in one column */
  @media (max-width: 640px) {
    .sheet-head {
      display: none;
    }

    .row {
      grid-template-columns: 2.8rem minmax(0, 1fr);
      border-top: 1px solid var(--rule);
      margin-top: -1px;
    }

    .row-action,
    .row-line {
      grid-column: 2;
      border-top: 1px dashed var(--rule);
    }

    .row-line:empty {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .x {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  :global(html[data-motion='still']) .x {
    animation: none;
    stroke-dashoffset: 0;
  }
</style>

<script>
  import { localizeHref, PREFIXED, type Lang } from '@/lib/lang';

  // this one page answers every missing URL, /fr/ and /zh/ ones included:
  // its links follow the language of the address that was asked for
  function localizeLinks() {
    const base = document.documentElement.dataset.base ?? '';
    const lang = location.pathname.slice(base.length).match(/^\/(fr|zh)(?=\/|$)/)?.[1] as Lang | undefined;
    if (!lang || !PREFIXED.includes(lang) || !document.querySelector('[data-lost]')) return;
    document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
      link.setAttribute('href', localizeHref(link.getAttribute('href') ?? '', lang));
    });
  }

  function pickShots() {
    const root = document.querySelector('[data-lost]');
    if (!root) return;
    const count = root.querySelector('[data-shot-slot]')?.querySelectorAll('[data-shot]').length ?? 0;
    if (count < 2) return;
    const first = Math.floor(Math.random() * count);
    const second = (first + 1 + Math.floor(Math.random() * (count - 1))) % count;
    const slots = root.querySelectorAll<HTMLElement>('[data-shot-slot]');
    slots.forEach((slot, i) => {
      const pick = i < 2 ? first : second;
      slot.querySelectorAll<HTMLElement>('[data-shot]').forEach((item) => {
        item.hidden = Number(item.dataset.shot) !== pick;
      });
    });
  }

  document.addEventListener('astro:page-load', () => {
    localizeLinks();
    pickShots();
  });
</script>
