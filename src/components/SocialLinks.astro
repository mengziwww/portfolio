---
// Small marks drawn for this site, not the official brand logos.
---

<nav class="socials" aria-label="Social">
  <a
    class="social"
    href="https://www.instagram.com/mengziwww/"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Instagram"
    data-cursor-hover
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="4.2" y="4.2" width="15.6" height="15.6" rx="5" fill="none" stroke="currentColor" stroke-width="1.5" />
      <circle cx="12" cy="12" r="3.3" fill="none" stroke="currentColor" stroke-width="1.5" />
      <circle cx="16.7" cy="7.4" r="0.85" fill="currentColor" />
    </svg>
  </a>
  <a
    class="social"
    href="https://space.bilibili.com/333172997"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Bilibili"
    data-cursor-hover
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M8.2 7.2 6.2 4.6M15.8 7.2 17.8 4.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <rect x="3.8" y="7.4" width="16.4" height="12" rx="3.2" fill="none" stroke="currentColor" stroke-width="1.5" />
      <circle cx="9.1" cy="13.2" r="1.05" fill="currentColor" />
      <circle cx="14.9" cy="13.2" r="1.05" fill="currentColor" />
    </svg>
  </a>
  <a
    class="social"
    href="https://www.linkedin.com/in/menghan-li-0522b5339/"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="LinkedIn"
    data-cursor-hover
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="4.2" y="4.2" width="15.6" height="15.6" rx="3" fill="none" stroke="currentColor" stroke-width="1.5" />
      <path
        d="M8.2 10.6v5.6M8.2 7.9v.15M11.6 16.2v-3.2c0-1.15.7-1.9 1.75-1.9 1.05 0 1.7.75 1.7 1.9v3.2"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </a>
</nav>

<style>
  .socials {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .social {
    display: grid;
    color: var(--bone);
    line-height: 0;
  }

  .social svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .social[aria-label='Instagram']:hover {
    color: #e1306c;
  }

  .social[aria-label='Bilibili']:hover {
    color: #00a1d6;
  }

  .social[aria-label='LinkedIn']:hover {
    color: #0a66c2;
  }
</style>
