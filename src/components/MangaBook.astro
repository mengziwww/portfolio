---
import { Image, getImage } from 'astro:assets';
import { getProjectImage, responsiveWidths } from '@/lib/images';
import I18nText from '@/components/I18nText.astro';
import { langOf } from '@/lib/lang';

type Item = { file: string; alt: { en: string; fr: string; zh: string } };
interface Props {
  projectId: string;
  items: Item[];
}
const { projectId, items } = Astro.props;

const pages = await Promise.all(
  items.map(async (item) => {
    const src = getProjectImage(projectId, item.file);
    const [sm, lg] = await Promise.all([
      getImage({ src, width: Math.min(1000, src.width), format: 'webp' }),
      getImage({ src, width: Math.min(1400, src.width), format: 'webp' }),
    ]);
    return { item, src, sm: sm.src, lg: lg.src };
  }),
);
const helpId = `manga-help-${projectId}`;
const pageLang = langOf(Astro.url);
---

<div class="mb" data-manga-book>
  <div
    class="mb-stage"
    data-mb-stage
    data-artwork
    tabindex="0"
    role="group"
    aria-roledescription="book"
    aria-describedby={helpId}
  >
    <canvas class="mb-canvas" aria-hidden="true"></canvas>
  </div>
  <p id={helpId} class="visually-hidden">
    <I18nText
      en="Manga, read right to left. Take the left page by its edge and drag it to the right to turn it, or use the left arrow key for the next page and the right arrow key to go back."
      fr="Manga, lu de droite à gauche. Prends la page de gauche par le bord et fais-la glisser vers la droite pour la tourner, ou utilise la flèche gauche pour avancer et la flèche droite pour revenir."
      zh="漫画，从右往左读。按住左页边缘向右拖动即可翻页，也可以用左方向键前进、右方向键后退。"
    />
  </p>
  <p class="visually-hidden" aria-live="polite" data-mb-status></p>

  <!-- shown over the book the first time it comes into view -->
  <div class="mb-guide" data-mb-guide hidden>
    <div class="mb-guide-card" role="dialog" aria-labelledby={`${helpId}-guide`}>
      <div class="mb-guide-demo" aria-hidden="true">
        <span class="mb-guide-page is-r"></span>
        <span class="mb-guide-page is-l"><span class="mb-guide-flap"></span></span>
        <span class="mb-guide-finger"></span>
      </div>
      <p class="mb-guide-title" id={`${helpId}-guide`}>
        <I18nText en="How to read it" fr="Comment le lire" zh="怎么翻页" />
      </p>
      <p class="mb-guide-text is-touch">
        <I18nText
          en="A manga reads from right to left. To turn the page, swipe it to the right, tap its left edge, or use the buttons under the book."
          fr="Un manga se lit de droite à gauche. Pour tourner la page, fais-la glisser vers la droite, touche son bord gauche, ou utilise les boutons sous le livre."
          zh="漫画从右往左读。翻页时，把页面向右滑，或者点页面的左边缘，也可以用书下面的按钮。"
        />
      </p>
      <p class="mb-guide-text is-mouse">
        <I18nText
          en="A manga reads from right to left. Take the left page by its edge and drag it to the right, click that edge, or press the ← key."
          fr="Un manga se lit de droite à gauche. Prends la page de gauche par le bord et tire-la vers la droite, clique sur ce bord, ou appuie sur la touche ←."
          zh="漫画从右往左读。按住左页的边缘向右拖，或者点击这个边缘，也可以按键盘上的 ← 键。"
        />
      </p>
      <button type="button" class="mb-guide-ok" data-mb-guide-ok>
        <I18nText en="Got it" fr="Compris" zh="知道了" />
      </button>
    </div>
  </div>

  <div class="mb-controls" data-mb-controls>
    <button type="button" class="mb-btn is-next" data-mb-next>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      <span><I18nText en="next page" fr="page suivante" zh="下一页" /></span>
    </button>
    <p class="mb-where" aria-hidden="true" data-mb-where></p>
    <button type="button" class="mb-btn is-prev" data-mb-prev>
      <span><I18nText en="previous" fr="précédente" zh="上一页" /></span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>
  <p class="mb-hint">
    <I18nText
      en="A manga reads from right to left: swipe the page to the right, tap its left edge, or use the buttons."
      fr="Un manga se lit de droite à gauche : fais glisser la page vers la droite, touche son bord gauche, ou utilise les boutons."
      zh="漫画从右往左读：把页面向右滑、点左侧边缘，或者用下面的按钮翻页。"
    />
  </p>

  <div class="mb-sources">
    {pages.map((p) => (
      <figure data-mb-src data-artwork data-sm={p.sm} data-lg={p.lg}>
        <Image
          src={p.src}
          alt={p.item.alt[pageLang]}
          widths={responsiveWidths(p.src, [320, 640])}
          sizes="(max-width: 700px) 30vw, 10rem"
          loading="lazy"
        />
      </figure>
    ))}
  </div>
</div>

<style>
  .mb {
    position: relative;
    width: min(66rem, 96vw);
    margin: 0 auto var(--space-4);
  }

  .mb-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    max-height: 86vh;
    z-index: 1;
    outline: none;
    border-radius: 6px;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .mb-stage::before {
    content: '';
    position: absolute;
    inset: -6% -4%;
    pointer-events: none;
    background:
      radial-gradient(ellipse 46% 44% at 50% 56%, rgb(216 167 94 / 11%), transparent 70%),
      radial-gradient(ellipse 70% 60% at 50% 60%, rgb(10 8 14 / 55%), transparent 75%);
  }

  .mb-stage:focus-visible {
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--gold) 70%, transparent);
  }

  /* bleeds past the stage so a page lifted mid-turn is not cut off; the
     stage itself takes the pointer, so the bleed never covers the text
     around it */
  .mb-canvas {
    position: absolute;
    inset: -14% -4%;
    width: 108%;
    height: 128%;
    display: block;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.9s ease;
  }

  .mb.is-ready .mb-canvas {
    opacity: 1;
  }

  .mb-guide {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    z-index: 5;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: rgb(8 7 12 / 62%);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    border-radius: 6px;
    opacity: 0;
    transition: opacity 0.35s ease;
    cursor: pointer;
  }

  .mb-guide.is-on {
    opacity: 1;
  }

  .mb-guide-card {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    max-width: 21rem;
    padding: 1.3rem 1.3rem 1.2rem;
    text-align: center;
    border: 1px solid color-mix(in srgb, var(--gold) 50%, transparent);
    border-radius: 14px;
    background: rgb(14 12 18 / 92%);
    box-shadow: 0 1.2rem 3rem -1rem rgb(0 0 0 / 80%);
    cursor: default;
  }

  .mb-guide-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--bone);
  }

  .mb-guide-text {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--bone-soft);
  }

  .mb-guide-text.is-touch {
    display: none;
  }

  @media (hover: none), (max-width: 900px) {
    .mb-guide-text.is-touch {
      display: block;
    }

    .mb-guide-text.is-mouse {
      display: none;
    }
  }

  .mb-guide-ok {
    margin-top: 0.2rem;
    min-height: 2.75rem;
    padding: 0.55rem 1.4rem;
    border: 1px solid var(--gold);
    border-radius: 999px;
    background: color-mix(in srgb, var(--gold) 16%, transparent);
    color: var(--gold);
    font-family: var(--font-mono);
    font-size: max(var(--text-xs), 0.8rem);
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  /* a tiny open book: the left page lifts and turns to the right, a
     fingertip pulling it along */
  .mb-guide-demo {
    position: relative;
    width: 7.4rem;
    height: 4.6rem;
    perspective: 18rem;
  }

  .mb-guide-page {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    border: 1px solid rgb(255 255 255 / 30%);
    background: #efe8da;
  }

  .mb-guide-page.is-r {
    right: 0;
    border-radius: 0 4px 4px 0;
  }

  .mb-guide-page.is-l {
    left: 0;
    border-radius: 4px 0 0 4px;
    background: #e2d9c7;
  }

  .mb-guide-flap {
    position: absolute;
    inset: -1px;
    border-radius: 4px 0 0 4px;
    background: #f6f0e4;
    border: 1px solid rgb(0 0 0 / 15%);
    transform-origin: right center;
    animation: guide-flap 2.6s ease-in-out infinite;
  }

  .mb-guide-finger {
    position: absolute;
    top: 58%;
    left: 6%;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 0.35rem color-mix(in srgb, var(--gold) 30%, transparent);
    animation: guide-finger 2.6s ease-in-out infinite;
  }

  @keyframes guide-flap {
    0%, 15% { transform: rotateY(0deg); }
    60%, 80% { transform: rotateY(180deg); }
    100% { transform: rotateY(180deg); opacity: 0; }
  }

  @keyframes guide-finger {
    0% { left: 6%; opacity: 0; }
    12% { left: 6%; opacity: 1; }
    60% { left: 86%; opacity: 1; }
    80%, 100% { left: 86%; opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mb-guide-flap,
    .mb-guide-finger {
      animation: none;
    }
  }

  :global(html[data-motion='still']) .mb-guide-flap,
  :global(html[data-motion='still']) .mb-guide-finger {
    animation: none;
  }

  /* the buttons are there for touch screens, where there is no hover to
     show that a page can be taken by its edge */
  .mb-controls,
  .mb-hint {
    display: none;
  }

  @media (hover: none), (max-width: 900px) {
    .mb.is-ready .mb-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.6rem;
      width: min(100%, 30rem);
      margin: 0.4rem auto 0;
      position: relative;
      z-index: 2;
    }

    .mb.is-ready .mb-hint {
      display: block;
      max-width: 30rem;
      margin: 0.7rem auto 0;
      text-align: center;
      font-size: var(--text-xs);
      line-height: 1.5;
      color: var(--bone-soft);
    }
  }

  .mb-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.9rem;
    padding: 0.55rem 1rem;
    border: 1px solid color-mix(in srgb, var(--gold) 50%, transparent);
    border-radius: 999px;
    background: rgb(9 8 10 / 70%);
    color: var(--bone);
    font-family: var(--font-mono);
    font-size: max(var(--text-xs), 0.78rem);
    letter-spacing: 0.06em;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: border-color var(--dur-fast), color var(--dur-fast), opacity var(--dur-fast);
  }

  .mb-btn.is-next {
    border-color: var(--gold);
    color: var(--gold);
  }

  .mb-btn:active {
    background: rgb(40 32 20 / 80%);
  }

  .mb-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .mb-btn svg {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mb-where {
    margin: 0;
    font-family: var(--font-mono);
    font-size: max(var(--text-xs), 0.78rem);
    color: var(--bone-soft);
    white-space: nowrap;
    text-align: center;
  }

  .mb-sources {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .mb.is-fallback .mb-sources {
    position: static;
    width: auto;
    height: auto;
    overflow: visible;
    clip-path: none;
    white-space: normal;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
    gap: 0.6rem;
    margin-top: var(--space-3);
  }

  .mb.is-fallback .mb-stage {
    display: none;
  }

  .mb.is-fallback .mb-sources {
    grid-template-columns: 1fr;
    max-width: 34rem;
    margin-inline: auto;
  }

  .mb-sources figure {
    margin: 0;
    background: #f3eee4;
  }

  .mb-sources :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 640px) {
    .mb-stage {
      aspect-ratio: 3 / 4;
      max-height: 80vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mb-canvas {
      transition: none;
    }
  }
</style>

<script>
  import type { BookStatus } from '@/lib/manga-book';

  const WORDS = {
    en: { cover: 'Cover', back: 'Back cover', end: 'End of the volume', pages: (p: number[]) => `Page ${p.join(' and ')}` },
    fr: { cover: 'Couverture', back: 'Quatrième de couverture', end: 'Fin du volume', pages: (p: number[]) => `Page ${p.join(' et ')}` },
    zh: { cover: '封面', back: '封底', end: '本卷完', pages: (p: number[]) => `第${p.join('、')}页` },
  };

  function wordsNow() {
    const lang = (document.documentElement.getAttribute('lang') || 'en').slice(0, 2) as keyof typeof WORDS;
    return WORDS[lang] ?? WORDS.en;
  }

  // the short line between the buttons: "Cover", "3-4 / 24"
  function where(status: BookStatus, total: number) {
    const words = wordsNow();
    if (status.kind === 'cover') return words.cover;
    if (status.kind === 'back') return words.back;
    if (status.kind === 'end') return words.end;
    const text = `${status.pages.join('–')} / ${total}`;
    return text;
  }

  function describe(status: BookStatus) {
    const lang = (document.documentElement.getAttribute('lang') || 'en').slice(0, 2) as keyof typeof WORDS;
    const words = WORDS[lang] ?? WORDS.en;
    if (status.kind === 'cover') return words.cover;
    if (status.kind === 'back') return words.back;
    if (status.kind === 'end') return words.end;
    const text = words.pages(status.pages);
    return document.documentElement.lang === 'zh-Hant' ? text.replace('页', '頁') : text;
  }

  const cleanups: Array<() => void> = [];
  const GUIDE_KEY = 'menghan-manga-guide';

  function guideSeen() {
    try {
      return localStorage.getItem(GUIDE_KEY) === '1';
    } catch {
      return false;
    }
  }

  function setupGuide(root: HTMLElement, stage: HTMLElement) {
    const guide = root.querySelector<HTMLElement>('[data-mb-guide]');
    if (!guide || guideSeen()) return () => {};
    let open = false;
    const close = () => {
      if (!open) return;
      open = false;
      try {
        localStorage.setItem(GUIDE_KEY, '1');
      } catch {
        /* private mode */
      }
      guide.classList.remove('is-on');
      window.setTimeout(() => (guide.hidden = true), 350);
      document.removeEventListener('keydown', onKey);
    };
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') close();
    };
    const show = () => {
      if (guideSeen()) return;
      guide.style.top = `${stage.offsetTop}px`;
      guide.style.height = `${stage.offsetHeight}px`;
      guide.hidden = false;
      open = true;
      requestAnimationFrame(() => guide.classList.add('is-on'));
      document.addEventListener('keydown', onKey);
    };
    guide.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('.mb-guide-card') || (e.target as Element).closest('[data-mb-guide-ok]')) close();
    });
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((en) => en.isIntersecting)) return;
        io.disconnect();
        show();
      },
      { threshold: 0.5 },
    );
    io.observe(stage);
    cleanups.push(() => {
      io.disconnect();
      document.removeEventListener('keydown', onKey);
    });
    return close;
  }

  async function mount(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('[data-mb-stage]');
    const canvas = root.querySelector<HTMLCanvasElement>('.mb-canvas');
    const status = root.querySelector<HTMLElement>('[data-mb-status]');
    const whereLine = root.querySelector<HTMLElement>('[data-mb-where]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-mb-next]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-mb-prev]');
    if (!stage || !canvas) return;
    const sources = [...root.querySelectorAll<HTMLElement>('[data-mb-src]')].map((fig) => ({
      sm: fig.dataset.sm || '',
      lg: fig.dataset.lg || '',
    }));
    const motion = document.documentElement.dataset.motion;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches || motion === 'still';
    const calm = reduced || motion === 'quiet';
    let first = true;
    let closeGuide = () => {};
    try {
      const { createBook } = await import('@/lib/manga-book');
      const book = createBook({
        stage,
        canvas,
        sources,
        reduced,
        calm,
        onReady: () => {
          root.classList.add('is-ready');
          closeGuide = setupGuide(root, stage);
        },
        onStatus: (s) => {
          if (whereLine) whereLine.textContent = where(s, sources.length);
          if (prevBtn) prevBtn.disabled = s.kind === 'cover';
          if (nextBtn) nextBtn.disabled = s.kind === 'back';
          if (first) {
            first = false;
            return;
          }
          closeGuide();
          if (status) status.textContent = describe(s);
        },
      });
      if (!book) {
        root.classList.add('is-fallback');
        return;
      }
      nextBtn?.addEventListener('click', () => book.forward());
      prevBtn?.addEventListener('click', () => book.back());
      cleanups.push(() => book.destroy());
    } catch {
      root.classList.add('is-fallback');
    }
  }

  function initBooks() {
    document.querySelectorAll<HTMLElement>('[data-manga-book]').forEach((root) => {
      if (root.dataset.bookInit === '1') return;
      root.dataset.bookInit = '1';
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          io.disconnect();
          mount(root);
        },
        { rootMargin: '900px 0px' },
      );
      io.observe(root);
      cleanups.push(() => io.disconnect());
    });
  }

  document.addEventListener('astro:page-load', initBooks);
  document.addEventListener('astro:before-swap', () => {
    cleanups.splice(0).forEach((fn) => fn());
  });
</script>
