---
// Not a night sky — a studio. Menghan's medium is graphite and paper, not
// stars, so the ambient layer behind the whole homepage is reframed as
// that: dust and shavings drifting slowly through track-lighting, the way
// they actually do in a room where someone draws for a living. Most
// particles are a warm, quiet grey; a handful catch the light and glow
// gold for a moment as they drift past it, then fade back.
// Degrades silently to nothing if WebGL is unavailable.
---

<canvas class="dustfield" data-dustfield aria-hidden="true"></canvas>

<style>
  .dustfield {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    display: block;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  import * as THREE from 'three';

  const VERTEX = /* glsl */ `
    attribute float aSize;
    attribute float aGlow;
    uniform float uScale;
    varying float vGlow;
    void main() {
      vGlow = aGlow;
      vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
      gl_PointSize = aSize * (1.0 + vGlow * 2.2) * (uScale / -mvPosition.z);
      gl_Position = projectionMatrix * mvPosition;
    }
  `;

  const FRAGMENT = /* glsl */ `
    precision mediump float;
    uniform vec3 uColorA;
    uniform vec3 uColorB;
    varying float vGlow;
    void main() {
      vec2 uv = gl_PointCoord - 0.5;
      float d = length(uv);
      float alpha = smoothstep(0.5, 0.0, d);
      vec3 color = mix(uColorA, uColorB, clamp(vGlow, 0.0, 1.0));
      gl_FragColor = vec4(color, alpha * (0.62 + vGlow * 0.7));
    }
  `;

  function initDustField() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-dustfield]');
    if (!canvas || canvas.dataset.dustfieldInit === '1') return;
    canvas.dataset.dustfieldInit = '1';

    const motion = document.documentElement.dataset.motion;
    if (motion === 'quiet' || motion === 'still') return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    } catch {
      return; // no WebGL — the page reads fine without this layer
    }

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(55, 1, 1, 2000);
    camera.position.z = 600;

    const COUNT = 1300;
    const TOP = 520;
    const BOTTOM = -520;
    const positions = new Float32Array(COUNT * 3);
    const sizes = new Float32Array(COUNT);
    const glow = new Float32Array(COUNT);
    // CPU-side drift bookkeeping — kept out of the GPU buffers since only
    // this loop needs them, one entry per particle.
    const baseX = new Float32Array(COUNT);
    const speed = new Float32Array(COUNT);
    const swayAmp = new Float32Array(COUNT);
    const swayFreq = new Float32Array(COUNT);
    const swayPhase = new Float32Array(COUNT);

    for (let i = 0; i < COUNT; i++) {
      const x = (Math.random() - 0.5) * 1400;
      const y = TOP - Math.random() * (TOP - BOTTOM);
      const z = -700 + Math.random() * 800;
      positions[i * 3] = x;
      positions[i * 3 + 1] = y;
      positions[i * 3 + 2] = z;
      sizes[i] = 2.4 + Math.random() * 2.6;
      glow[i] = 0;
      baseX[i] = x;
      speed[i] = 4 + Math.random() * 9;
      swayAmp[i] = 6 + Math.random() * 18;
      swayFreq[i] = 0.08 + Math.random() * 0.14;
      swayPhase[i] = Math.random() * Math.PI * 2;
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    const sizeAttr = new THREE.BufferAttribute(sizes, 1);
    geometry.setAttribute('aSize', sizeAttr);
    const glowAttr = new THREE.BufferAttribute(glow, 1);
    geometry.setAttribute('aGlow', glowAttr);

    const material = new THREE.ShaderMaterial({
      uniforms: {
        uScale: { value: 420 },
        uColorA: { value: new THREE.Color('#ab9f8a') },
        uColorB: { value: new THREE.Color('#e8c07d') },
      },
      vertexShader: VERTEX,
      fragmentShader: FRAGMENT,
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
    });

    const points = new THREE.Points(geometry, material);
    scene.add(points);

    const bone = new THREE.Color('#f0ebe0');
    const gold = new THREE.Color('#e8c07d');
    const planetGroup = new THREE.Group();

    function addPlanet(x: number, y: number, z: number, radius: number, ring: boolean) {
      const group = new THREE.Group();
      const fill = new THREE.Mesh(
        new THREE.CircleGeometry(radius, 48),
        new THREE.MeshBasicMaterial({ color: bone, transparent: true, opacity: 0.07, depthWrite: false })
      );
      const edge = new THREE.Mesh(
        new THREE.RingGeometry(radius * 0.9, radius, 48),
        new THREE.MeshBasicMaterial({ color: ring ? gold : bone, transparent: true, opacity: ring ? 0.42 : 0.28, depthWrite: false, side: THREE.DoubleSide })
      );
      group.add(fill, edge);
      if (ring) {
        const halo = new THREE.Mesh(
          new THREE.RingGeometry(radius * 1.35, radius * 1.52, 64),
          new THREE.MeshBasicMaterial({ color: gold, transparent: true, opacity: 0.32, depthWrite: false, side: THREE.DoubleSide })
        );
        halo.rotation.x = 1.15;
        halo.rotation.z = -0.35;
        group.add(halo);
      }
      group.position.set(x, y, z);
      planetGroup.add(group);
    }

    addPlanet(460, 210, -240, 22, true);
    addPlanet(-620, -340, -160, 11, false);
    addPlanet(80, -380, -380, 7, false);
    scene.add(planetGroup);

    type Streak = {
      line: THREE.Line;
      life: number;
      dur: number;
      vx: number;
      vy: number;
    };
    const streaks: Streak[] = [];
    let nextStreak = 1.6;

    function spawnStreak() {
      const x = -120 + Math.random() * 780;
      const y = 40 + Math.random() * 340;
      const z = -160;
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(new Float32Array([x, y, z, x, y, z]), 3));
      const mat = new THREE.LineBasicMaterial({ color: bone, transparent: true, opacity: 0 });
      const line = new THREE.Line(geo, mat);
      scene.add(line);
      streaks.push({
        line,
        life: 0,
        dur: 0.5 + Math.random() * 0.35,
        vx: -(340 + Math.random() * 180),
        vy: -(60 + Math.random() * 80),
      });
    }

    let width = 0;
    let height = 0;
    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      renderer.setSize(width, height, false);
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      camera.aspect = width / Math.max(height, 1);
      camera.updateProjectionMatrix();
      material.uniforms.uScale.value = height * 1.05;
    }
    resize();
    window.addEventListener('resize', resize);

    let targetX = 0;
    let targetY = 0;
    window.addEventListener('mousemove', (e) => {
      targetX = (e.clientX / window.innerWidth - 0.5) * 60;
      targetY = (e.clientY / window.innerHeight - 0.5) * 40;
    });

    // a handful of particles catching the light at any moment, each a
    // short-lived pulse rather than a single line crossing the whole sky
    type Pulse = { index: number; start: number; duration: number };
    const pulses: Pulse[] = [];
    let nextPulseAt = 600;

    let raf = 0;
    let elapsed = 0;
    let last = performance.now();
    function tick(now: number) {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      elapsed += dt * 1000;

      camera.position.x += (targetX - camera.position.x) * 0.02;
      camera.position.y += (-targetY - camera.position.y) * 0.02;
      camera.lookAt(0, 0, -400);

      planetGroup.children.forEach((planet, i) => {
        if (planet.userData.baseY === undefined) planet.userData.baseY = planet.position.y;
        planet.position.y = planet.userData.baseY + Math.sin(elapsed * 0.00045 + i * 1.4) * 10;
      });

      if (!reduced && elapsed / 1000 > nextStreak && streaks.length < 2) {
        spawnStreak();
        nextStreak = elapsed / 1000 + 2.4 + Math.random() * 2.8;
      }
      for (let s = streaks.length - 1; s >= 0; s--) {
        const streak = streaks[s];
        streak.life += dt;
        const attr = streak.line.geometry.getAttribute('position') as THREE.BufferAttribute;
        const hx = attr.getX(0) + streak.vx * dt;
        const hy = attr.getY(0) + streak.vy * dt;
        const z = attr.getZ(0);
        attr.setXYZ(0, hx, hy, z);
        attr.setXYZ(1, hx - streak.vx * 0.11, hy - streak.vy * 0.11, z);
        attr.needsUpdate = true;
        const t = streak.life / streak.dur;
        const mat = streak.line.material as THREE.LineBasicMaterial;
        mat.opacity = t < 0.12 ? (t / 0.12) * 0.7 : Math.max(0, 1 - t) * 0.7;
        if (t >= 1) {
          scene.remove(streak.line);
          streak.line.geometry.dispose();
          mat.dispose();
          streaks.splice(s, 1);
        }
      }

      if (!reduced) {
        for (let i = 0; i < COUNT; i++) {
          let y = positions[i * 3 + 1] - speed[i] * dt;
          if (y < BOTTOM) {
            y = TOP;
            baseX[i] = (Math.random() - 0.5) * 1400;
          }
          positions[i * 3 + 1] = y;
          positions[i * 3] = baseX[i] + Math.sin(elapsed * 0.001 * swayFreq[i] + swayPhase[i]) * swayAmp[i];
        }
        geometry.attributes.position.needsUpdate = true;

        if (elapsed > nextPulseAt && pulses.length < 6) {
          pulses.push({ index: Math.floor(Math.random() * COUNT), start: elapsed, duration: 1800 + Math.random() * 1400 });
          nextPulseAt = elapsed + 260 + Math.random() * 500;
        }
        for (let p = pulses.length - 1; p >= 0; p--) {
          const pulse = pulses[p];
          const t = (elapsed - pulse.start) / pulse.duration;
          if (t >= 1) {
            glow[pulse.index] = 0;
            pulses.splice(p, 1);
            continue;
          }
          glow[pulse.index] = Math.sin(t * Math.PI);
        }
        glowAttr.needsUpdate = true;
      }

      renderer.render(scene, camera);
      raf = requestAnimationFrame(tick);
    }
    raf = requestAnimationFrame(tick);

    document.addEventListener(
      'astro:before-swap',
      () => {
        cancelAnimationFrame(raf);
        renderer.dispose();
        geometry.dispose();
        material.dispose();
        planetGroup.traverse((obj) => {
          const mesh = obj as THREE.Mesh;
          mesh.geometry?.dispose();
          const mat = mesh.material as THREE.Material | undefined;
          mat?.dispose();
        });
        streaks.forEach((streak) => {
          streak.line.geometry.dispose();
          (streak.line.material as THREE.Material).dispose();
        });
        window.removeEventListener('resize', resize);
      },
      { once: true }
    );
  }

  document.addEventListener('astro:page-load', initDustField);
</script>
