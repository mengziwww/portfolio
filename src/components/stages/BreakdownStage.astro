---
// Bajiajiang: the early stage of a film about a New Year procession in
// Fujian. The page is the procession itself: the poster stands in a temple
// gate, and each step of the pipeline is a station on the route, stamped
// with a seal as you reach it, while an incense stick burns down beside it.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getProjectImage, responsiveWidths } from '@/lib/images';
import ProjectFooter from './ProjectFooter.astro';
import ScrollCue from '@/components/ScrollCue.astro';
import I18nText from '@/components/I18nText.astro';
import { trAll } from '@/i18n/ui';
import { vividOf } from '@/lib/color';
import { charReveal } from '@/lib/reveal-text';
import ProjectIntro from '@/components/ProjectIntro.astro';
import VideoPlayer from '@/components/VideoPlayer.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}
const { project, next } = Astro.props;
const { title, subtitle, description, year, roles, category, client, cover, coverAlt, gallery, accentFrom, accentTo, video, links } = project.data;
const glow = vividOf(accentFrom, accentTo);
const coverImg = getProjectImage(project.id, cover);
const categoryLabel = trAll(`category.${category}` as const);
const clientLabel = trAll('project.client');

type Item = (typeof gallery)[number];
type Station = { label: { en: string; fr: string; zh: string }; items: Item[]; video?: string };

const stations: Station[] = [];
for (const item of gallery) {
  const last = stations[stations.length - 1];
  const label = item.chapter ?? { en: '', fr: '', zh: '' };
  if (last && last.label.en === label.en) last.items.push(item);
  else stations.push({ label, items: [item] });
}
if (video) {
  const reel: Station = { label: { en: 'Storyboard', fr: 'Storyboard', zh: '分镜' }, items: [], video };
  const extra = stations.findIndex((s) => s.label.en === 'more from this project');
  stations.splice(extra === -1 ? stations.length : extra, 0, reel);
}
const numerals = ['壹', '贰', '叁', '肆', '伍', '陆', '柒', '捌', '玖'];

const smoke = Array.from({ length: 5 }, (_, i) => ({
  left: `${8 + i * 21}%`,
  delay: `${i * 3.4}s`,
  dur: `${24 + (i % 3) * 6}s`,
  scale: 0.7 + (i % 3) * 0.25,
}));
const embers = Array.from({ length: 16 }, (_, i) => ({
  left: `${(i * 47) % 100}%`,
  delay: `${(i % 8) * 1.4}s`,
  dur: `${9 + (i % 5) * 2}s`,
}));
const bits = Array.from({ length: 12 }, (_, i) => ({
  a: Math.round((i / 12) * 360 + ((i * 29) % 17)),
  d: 3.5 + ((i * 7) % 5) * 0.8,
  r: ((i * 53) % 360) - 180,
  gold: i % 4 === 0,
}));
const crackers = Array.from({ length: 9 }, (_, i) => i);
---

<article class="breakdown" style={`--mood-a:${accentFrom}; --mood-b:${accentTo}; --mood-glow:${glow};`} data-breakdown data-reveal-root>
  <div class="bd-lattice" aria-hidden="true"></div>
  <div class="bd-smoke" aria-hidden="true">
    {smoke.map((s) => (
      <span class="smoke-wisp" style={`left:${s.left}; animation-delay:${s.delay}; animation-duration:${s.dur}; --scale:${s.scale};`}></span>
    ))}
  </div>
  <div class="bd-embers" aria-hidden="true">
    {embers.map((e) => (
      <span class="bd-ember" style={`left:${e.left}; animation-delay:${e.delay}; animation-duration:${e.dur};`}></span>
    ))}
  </div>

  <header class="bd-hero">
    <div class="bd-gate">
      <svg class="bd-gate-roof" viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 48 Q50 46 70 22 L330 22 Q350 46 400 48 L400 60 L0 60 Z" fill="#241010" />
        <path d="M0 48 Q50 46 70 22 L330 22 Q350 46 400 48" fill="none" stroke="#c9a24a" stroke-width="2" />
        <path d="M70 22 L330 22" stroke="#c9a24a" stroke-width="4" />
        <path d="M140 22 L200 4 L260 22" fill="#241010" stroke="#c9a24a" stroke-width="2" />
        <circle cx="200" cy="12" r="4" fill="#e04a2a" />
      </svg>
      <p class="bd-plaque" lang="zh" data-zh aria-hidden="true">八家将</p>
      <span class="bd-crackers is-l" aria-hidden="true">
        {crackers.map((c) => <i style={`--c:${c}`}></i>)}
      </span>
      <span class="bd-crackers is-r" aria-hidden="true">
        {crackers.map((c) => <i style={`--c:${c}`}></i>)}
      </span>
      <p class="bd-pillar is-l" lang="zh" data-zh aria-hidden="true">与神同行</p>
      <figure class="bd-door">
        <Image
          src={coverImg}
          alt={coverAlt.en}
          widths={responsiveWidths(coverImg, [420, 640, 900])}
          sizes="(max-width: 700px) 64vw, 22rem"
          loading="eager"
          fetchpriority="high"
          transition:name={`project-cover-${project.id}`}
        />
      </figure>
      <p class="bd-pillar is-r" lang="zh" data-zh aria-hidden="true">简单快乐</p>
      <span class="bd-step" aria-hidden="true"></span>
    </div>

    <div class="bd-hero-copy">
      <p class="hero-eyebrow eyebrow">
        <I18nText {...categoryLabel} /> · {year}{client ? (
          <>
            {' · '}<I18nText {...clientLabel} /> {client}
          </>
        ) : null}
      </p>
      <h1 class="bd-hero-title" transition:name={`project-title-${project.id}`} set:html={charReveal(title, 120, 22)} />
      <p class="bd-hero-subtitle">
        <I18nText en={subtitle.en} fr={subtitle.fr} zh={subtitle.zh} />
      </p>
      <ProjectIntro description={description} links={links} />
      <ul class="hero-roles">
        {roles.en.map((_, i) => (
          <li style={`--i:${i}`}>
            <I18nText en={roles.en[i]} fr={roles.fr[i]} zh={roles.zh[i]} />
          </li>
        ))}
      </ul>
    </div>
    <div class="bd-hero-cue">
      <ScrollCue />
    </div>
  </header>

  <div class="bd-route" data-bd-route>
    <div class="bd-incense" data-bd-incense aria-hidden="true">
      <span class="bd-incense-smoke"></span>
      <span class="bd-incense-stick"><span class="bd-incense-ember"></span></span>
      <span class="bd-incense-pot"></span>
    </div>

    <p class="bd-route-head eyebrow">
      <I18nText en="the route, from concept to storyboard" fr="le parcours, du concept au storyboard" zh="一路走来：从概念到分镜" />
    </p>

    {stations.map((s, i) => (
      <section class:list={['bd-station', { 'is-flip': i % 2 === 1, 'is-reel': !!s.video, 'is-many': s.items.length > 1 }]} data-bd-station>
        <div class="bd-station-meta">
          <span class="bd-seal" aria-hidden="true">
            <span class="bd-seal-mark" lang="zh">{numerals[i] ?? i + 1}</span>
            <span class="bd-bits">
              {bits.map((b) => (
                <i class:list={{ 'is-gold': b.gold }} style={`--a:${b.a}deg; --d:${b.d}rem; --r:${b.r}deg;`}></i>
              ))}
            </span>
          </span>
          <p class="bd-station-index">{String(i + 1).padStart(2, '0')} / {String(stations.length).padStart(2, '0')}</p>
          <h2 class="bd-station-title">
            <I18nText en={s.label.en} fr={s.label.fr} zh={s.label.zh} />
          </h2>
          {s.items.length === 1 && (
            <p class="bd-station-note">
              <I18nText en={s.items[0].alt.en} fr={s.items[0].alt.fr} zh={s.items[0].alt.zh} />
            </p>
          )}
        </div>

        <div class="bd-station-body">
          {s.video ? (
            <VideoPlayer src={s.video} skin="temple" />
          ) : (
            s.items.map((item) => (
              <figure class="bd-panel" data-artwork data-note-id={`${project.id}:${item.file}`}>
                <span class="bd-panel-frame">
                  <Image
                    src={getProjectImage(project.id, item.file)}
                    alt={item.alt.en}
                    widths={responsiveWidths(getProjectImage(project.id, item.file), [480, 800, 1200])}
                    sizes="(max-width: 800px) 90vw, 44rem"
                    loading="lazy"
                  />
                </span>
                <span class="bd-tassel" aria-hidden="true"></span>
                {s.items.length > 1 && (
                  <figcaption>
                    <I18nText en={item.alt.en} fr={item.alt.fr} zh={item.alt.zh} />
                  </figcaption>
                )}
              </figure>
            ))
          )}
        </div>
      </section>
    ))}
  </div>

  <ProjectFooter project={project} next={next} />
</article>

<style>
  .breakdown {
    --lacquer: #7a1511;
    --lacquer-deep: #3e0807;
    --temple-gold: #d9b45c;
    position: relative;
    background:
      radial-gradient(ellipse 75% 50% at 50% 0%, color-mix(in srgb, var(--mood-a) 34%, transparent), transparent 70%),
      radial-gradient(ellipse 60% 40% at 12% 45%, rgb(160 30 20 / 18%), transparent 70%),
      radial-gradient(ellipse 60% 40% at 88% 75%, color-mix(in srgb, var(--mood-a) 14%, transparent), transparent 70%),
      linear-gradient(180deg, #1b0d0b, #120a09 60%, #0d0807);
    overflow: hidden;
  }

  .bd-lattice {
    position: fixed;
    inset: -10%;
    z-index: 0;
    pointer-events: none;
    opacity: 0.12;
    background-image:
      repeating-linear-gradient(55deg, #000 0 3px, transparent 3px 11rem),
      repeating-linear-gradient(-55deg, #000 0 3px, transparent 3px 11rem);
    animation: lattice-drift 90s linear infinite;
  }

  @keyframes lattice-drift {
    to { transform: translate(-11rem, -11rem); }
  }

  .bd-smoke,
  .bd-embers {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .smoke-wisp {
    position: absolute;
    bottom: -10%;
    width: 14rem;
    height: 60svh;
    background: radial-gradient(ellipse 50% 100% at 50% 100%, color-mix(in srgb, var(--mood-a) 10%, transparent), transparent 75%);
    animation: smoke-rise linear infinite;
  }

  @keyframes smoke-rise {
    0% { transform: translate(0, 0) scale(var(--scale, 1)); opacity: 0; }
    12% { opacity: 0.55; }
    88% { opacity: 0.3; }
    100% { transform: translate(3rem, -70svh) scale(var(--scale, 1)); opacity: 0; }
  }

  .bd-ember {
    position: absolute;
    bottom: -1rem;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 5px 1px color-mix(in srgb, var(--gold) 70%, transparent);
    animation: bd-ember-rise linear infinite;
  }

  @keyframes bd-ember-rise {
    0% { transform: translate(0, 0); opacity: 0; }
    10% { opacity: 0.8; }
    85% { opacity: 0.4; }
    100% { transform: translate(-1.5rem, -90svh); opacity: 0; }
  }

  /* ---- hero: the temple gate ---- */
  .bd-hero {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    padding: calc(var(--space-6) + 1rem) var(--edge) var(--space-5);
  }

  .bd-gate {
    position: relative;
    flex: none;
    display: grid;
    grid-template-columns: 2.6rem clamp(13rem, 30vw, 28rem) 2.6rem;
    grid-template-rows: auto auto auto;
    column-gap: 0.7rem;
    padding-top: 2.4rem;
  }

  .bd-gate-roof {
    position: absolute;
    left: -2.4rem;
    right: -2.4rem;
    top: -1.2rem;
    width: calc(100% + 4.8rem);
    height: 3.6rem;
    filter: drop-shadow(0 0.5rem 0.6rem rgb(0 0 0 / 55%));
  }

  .bd-plaque {
    position: relative;
    grid-column: 1 / -1;
    justify-self: center;
    margin: 0 0 0.9rem;
    padding: 0.35rem 1.4rem;
    font-family: 'Noto Serif SC', 'Songti SC', 'SimSun', serif;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-weight: 700;
    letter-spacing: 0.4em;
    text-indent: 0.4em;
    color: var(--temple-gold);
    background: linear-gradient(180deg, #1d1514, #0f0b0a);
    border: 2px solid var(--temple-gold);
    box-shadow: inset 0 0 0 3px #0f0b0a, inset 0 0 0 4px rgb(217 180 92 / 45%), 0 0.6rem 1.2rem rgb(0 0 0 / 50%);
  }

  .bd-pillar {
    grid-row: 2;
    margin: 0;
    display: grid;
    place-items: center;
    padding: 0.8rem 0;
    writing-mode: vertical-rl;
    font-family: 'Noto Serif SC', 'Songti SC', 'SimSun', serif;
    font-size: clamp(1rem, 1.5vw, 1.3rem);
    letter-spacing: 0.5em;
    color: #ffe2a0;
    text-shadow: 0 0 0.6rem rgb(255 190 90 / 45%);
    background: linear-gradient(90deg, #4c0a08, var(--lacquer) 40%, #9b2117 55%, #4c0a08);
    border: 1px solid rgb(217 180 92 / 60%);
    border-radius: 2px;
  }

  .bd-pillar.is-l { grid-column: 1; }
  .bd-pillar.is-r { grid-column: 3; }

  .bd-door {
    grid-row: 2;
    grid-column: 2;
    margin: 0;
    padding: 0.5rem;
    background: linear-gradient(180deg, #2c1210, #170908);
    border: 2px solid var(--temple-gold);
    box-shadow: 0 2rem 5rem -1.5rem rgb(0 0 0 / 75%), 0 0 4rem 0.5rem color-mix(in srgb, var(--mood-glow) 28%, transparent);
  }

  .bd-door :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .bd-step {
    grid-column: 1 / -1;
    grid-row: 3;
    height: 0.8rem;
    margin: 0 -1rem;
    background: linear-gradient(180deg, #3b2a22, #1b1310);
    border-top: 2px solid rgb(217 180 92 / 50%);
  }

  .bd-crackers {
    position: absolute;
    top: 1.8rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    transform-origin: 50% 0;
    animation: bd-sway 3.6s ease-in-out infinite;
  }

  .bd-crackers::before {
    content: '';
    width: 1px;
    height: 1.2rem;
    background: var(--temple-gold);
  }

  .bd-crackers.is-l { left: -1.9rem; }
  .bd-crackers.is-r { right: -1.9rem; animation-delay: -1.8s; }

  .bd-crackers i {
    width: 0.55rem;
    height: 1.1rem;
    border-radius: 2px;
    background: linear-gradient(90deg, #8f140e, #e0352a 50%, #8f140e);
    box-shadow: inset 0 3px 0 -1px var(--temple-gold);
    rotate: calc((var(--c) % 2 * 2 - 1) * 22deg);
  }

  @keyframes bd-sway {
    0%, 100% { rotate: -3deg; }
    50% { rotate: 3deg; }
  }

  .bd-hero-copy {
    flex: 1 1 24rem;
    max-width: 34rem;
  }

  .hero-eyebrow {
    color: var(--temple-gold);
    margin-bottom: var(--space-2);
  }

  .bd-hero-title {
    font-size: var(--text-2xl);
    line-height: 0.96;
  }

  .bd-hero-subtitle {
    font-size: var(--text-lg);
    color: #ffd27a;
    margin-top: var(--space-2);
  }

  .bd-hero-copy :global(.project-desc) {
    font-size: var(--text-base);
    color: color-mix(in srgb, var(--bone) 90%, transparent);
  }

  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    list-style: none;
    margin-top: var(--space-3);
    padding: 0;
  }

  .hero-roles li {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: #ffe2a0;
    border: 1px solid rgb(217 180 92 / 45%);
    background: rgb(122 21 17 / 35%);
    padding: 0.4em 0.85em;
    border-radius: 2px;
  }

  .bd-hero-cue {
    position: absolute;
    left: var(--edge);
    bottom: var(--space-3);
  }

  /* ---- the route ---- */
  .bd-route {
    position: relative;
    z-index: 1;
    max-width: 78rem;
    margin-inline: auto;
    padding: var(--space-4) var(--edge) var(--space-6);
  }

  .bd-route-head {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
    color: var(--temple-gold);
    margin-bottom: var(--space-5);
  }

  .bd-route-head::before,
  .bd-route-head::after {
    content: '';
    width: min(12rem, 18vw);
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(217 180 92 / 60%));
  }

  .bd-route-head::after {
    rotate: 180deg;
  }

  .bd-station {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 44rem);
    justify-content: center;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    margin-bottom: clamp(4rem, 9vw, 7rem);
  }

  .bd-station.is-flip {
    grid-template-columns: minmax(0, 44rem) minmax(0, 17rem);
  }

  .bd-station.is-flip .bd-station-meta {
    order: 2;
  }

  .bd-station-meta {
    position: relative;
    z-index: 1;
    padding: 1rem 0;
  }

  .bd-seal {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 4.2rem;
    height: 4.2rem;
    margin-bottom: var(--space-2);
  }

  .bd-seal-mark {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-family: 'Noto Serif SC', 'Songti SC', 'SimSun', serif;
    font-size: 2.1rem;
    font-weight: 700;
    color: #fff1dc;
    background: #b3241b;
    border-radius: 6px;
    box-shadow: inset 0 0 0 3px #b3241b, inset 0 0 0 5px rgb(255 241 220 / 80%);
    rotate: -6deg;
    opacity: 0;
    scale: 1.8;
  }

  .bd-station.is-in .bd-seal-mark {
    animation: bd-stamp 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.2) forwards;
  }

  @keyframes bd-stamp {
    0% { opacity: 0; scale: 1.8; }
    60% { opacity: 1; scale: 0.92; }
    100% { opacity: 1; scale: 1; }
  }

  .bd-bits {
    position: absolute;
    inset: 50%;
    pointer-events: none;
  }

  .bd-bits i {
    position: absolute;
    width: 0.4rem;
    height: 0.6rem;
    background: #e0352a;
    opacity: 0;
  }

  .bd-bits i.is-gold {
    background: var(--temple-gold);
  }

  .bd-station.is-in .bd-bits i {
    animation: bd-burst 1.1s 0.3s cubic-bezier(0.1, 0.7, 0.3, 1) forwards;
  }

  @keyframes bd-burst {
    0% { opacity: 1; transform: rotate(var(--a)) translateY(0) rotate(0); }
    70% { opacity: 1; }
    100% { opacity: 0; transform: rotate(var(--a)) translateY(calc(var(--d) * -1)) rotate(var(--r)); }
  }

  .bd-station-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--temple-gold);
  }

  .bd-station-title {
    margin-top: 0.3rem;
    font-size: var(--text-xl);
    line-height: 1.05;
  }

  .bd-station-note {
    margin-top: var(--space-2);
    font-size: var(--text-base);
    line-height: 1.55;
    color: color-mix(in srgb, var(--bone) 88%, transparent);
  }

  .bd-station-body {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-4);
  }

  .bd-station.is-many .bd-station-body {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }

  .bd-panel {
    position: relative;
    margin: 0;
    opacity: 0;
    translate: 0 2rem;
    transition: opacity 0.8s ease, translate 0.9s var(--ease-out-expo);
  }

  .bd-station.is-in .bd-panel {
    opacity: 1;
    translate: 0 0;
  }

  .bd-panel-frame {
    display: block;
    padding: 0.55rem;
    background: linear-gradient(180deg, #2a1310, #160a09);
    border: 2px solid rgb(217 180 92 / 75%);
    box-shadow: inset 0 0 0 3px #160a09, inset 0 0 0 4px rgb(217 180 92 / 30%), 0 2rem 4rem -1.5rem rgb(0 0 0 / 75%);
  }

  .bd-panel-frame :global(img) {
    width: 100%;
    height: auto;
    max-height: 68svh;
    object-fit: contain;
    display: block;
    cursor: zoom-in;
  }

  .bd-tassel {
    position: absolute;
    left: 50%;
    top: 100%;
    width: 2px;
    height: 1.4rem;
    translate: -50% 0;
    background: var(--temple-gold);
  }

  .bd-tassel::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    width: 0.6rem;
    height: 1.2rem;
    translate: -50% 0;
    border-radius: 0 0 40% 40%;
    background: repeating-linear-gradient(90deg, #c8231a 0 1px, #8f140e 1px 2px);
  }

  .bd-panel figcaption {
    margin-top: 2.8rem;
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--bone) 85%, transparent);
    text-align: center;
  }

  .bd-station.is-reel .bd-station-body {
    padding-top: 2rem;
  }

  .bd-station.is-reel .bd-station-body :global(.film-frame) {
    width: 100%;
    max-width: none;
  }

  /* the incense stick burns down while you walk the route */
  .bd-incense {
    position: fixed;
    left: max(1rem, calc((100vw - 78rem) / 4));
    top: 22svh;
    z-index: 2;
    width: 1.4rem;
    height: 56svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    opacity: 0;
    transition: opacity 0.6s;
    pointer-events: none;
  }

  .bd-incense.is-lit {
    opacity: 1;
  }

  .bd-incense-stick {
    position: relative;
    width: 4px;
    height: calc((1 - var(--burn, 0)) * 88% + 4%);
    border-radius: 2px;
    background: linear-gradient(180deg, #b0532c, #7a2c14 70%, #c9a24a 70%, #c9a24a);
  }

  .bd-incense-ember {
    position: absolute;
    left: 50%;
    top: -3px;
    width: 7px;
    height: 7px;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle, #fff3c4, #ff8a2a 50%, #c8321a);
    box-shadow: 0 0 0.6rem 0.25rem rgb(255 120 40 / 70%);
    animation: bd-glow 1.6s ease-in-out infinite;
  }

  @keyframes bd-glow {
    50% { box-shadow: 0 0 0.9rem 0.4rem rgb(255 140 50 / 85%); }
  }

  .bd-incense-smoke {
    position: absolute;
    bottom: calc((1 - var(--burn, 0)) * 88% + 4% + 0.9rem + 4px);
    width: 0.8rem;
    height: 5rem;
    border-radius: 50%;
    background: linear-gradient(0deg, rgb(230 225 215 / 35%), transparent);
    filter: blur(3px);
    animation: bd-curl 3.4s ease-in-out infinite;
    transform-origin: 50% 100%;
  }

  @keyframes bd-curl {
    0%, 100% { transform: skewX(-14deg) scaleY(0.9); }
    50% { transform: skewX(16deg) scaleY(1.1); }
  }

  .bd-incense-pot {
    width: 1.4rem;
    height: 0.9rem;
    border-radius: 0 0 0.6rem 0.6rem;
    background: linear-gradient(180deg, #d9b45c, #8b6a2c);
    box-shadow: inset 0 3px 0 rgb(120 110 100 / 80%);
  }

  @media (max-width: 1100px) {
    .bd-incense {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .bd-hero {
      padding-top: 7rem;
    }

    .bd-hero-copy {
      text-align: center;
    }

    .bd-hero-copy :global(.project-desc) {
      margin-inline: auto;
    }

    .bd-hero-copy :global(.project-links),
    .hero-roles {
      justify-content: center;
    }

    .bd-hero-cue {
      display: none;
    }

    .bd-station,
    .bd-station.is-flip {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }

    .bd-station.is-flip .bd-station-meta {
      order: 0;
    }

    .bd-station-meta {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 1rem;
      align-items: center;
      padding: 0.6rem 0;
    }

    .bd-seal {
      grid-row: span 2;
      width: 3.4rem;
      height: 3.4rem;
      margin: 0;
    }

    .bd-seal-mark {
      font-size: 1.7rem;
    }

    .bd-station-note {
      grid-column: 1 / -1;
    }

    .bd-station.is-many .bd-station-body {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .bd-gate {
      grid-template-columns: 2rem min(58vw, 15rem) 2rem;
      column-gap: 0.45rem;
    }

    .bd-pillar {
      font-size: 0.95rem;
      letter-spacing: 0.35em;
    }

    .bd-crackers {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bd-lattice,
    .smoke-wisp,
    .bd-ember,
    .bd-crackers,
    .bd-incense-ember,
    .bd-incense-smoke {
      animation: none;
    }
    .smoke-wisp,
    .bd-ember {
      opacity: 0;
    }
    .bd-seal-mark,
    .bd-panel {
      opacity: 1;
      scale: 1;
      translate: none;
      transition: none;
    }
    .bd-station.is-in .bd-seal-mark,
    .bd-station.is-in .bd-bits i {
      animation: none;
    }
  }

  :global(html[data-motion='still']) .bd-seal-mark,
  :global(html[data-motion='still']) .bd-panel {
    opacity: 1;
    scale: 1;
    translate: none;
  }
</style>

<script>
  let observer: IntersectionObserver | undefined;
  let onScroll: (() => void) | undefined;

  function initBreakdown() {
    const route = document.querySelector<HTMLElement>('[data-bd-route]');
    if (!route || route.dataset.bdInit === '1') return;
    route.dataset.bdInit = '1';

    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          observer?.unobserve(entry.target);
        });
      },
      { threshold: 0.25 },
    );
    route.querySelectorAll('[data-bd-station]').forEach((s) => observer!.observe(s));

    const incense = route.querySelector<HTMLElement>('[data-bd-incense]');
    if (!incense) return;
    let frame = 0;
    const paint = () => {
      frame = 0;
      const r = route.getBoundingClientRect();
      const span = r.height - innerHeight;
      const burn = Math.min(1, Math.max(0, -r.top / Math.max(1, span)));
      incense.style.setProperty('--burn', burn.toFixed(3));
      incense.classList.toggle('is-lit', r.top < innerHeight * 0.5 && r.bottom > innerHeight * 0.6);
    };
    onScroll = () => {
      if (!frame) frame = requestAnimationFrame(paint);
    };
    paint();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  document.addEventListener('astro:page-load', initBreakdown);
  document.addEventListener('astro:before-swap', () => {
    observer?.disconnect();
    observer = undefined;
    if (onScroll) window.removeEventListener('scroll', onScroll);
    onScroll = undefined;
  });
</script>
