  /* III. night: wide spreads in a dark room, the deer's glow behind */
  .look-night {
    background:
      radial-gradient(ellipse 45% 50% at 72% 60%, rgb(120 90 255 / 28%), transparent 70%),
      radial-gradient(ellipse 30% 30% at 80% 40%, rgb(255 255 255 / 10%), transparent 70%),
