  }
</style>

<script>
  function initCollection() {
    const root = document.querySelector<HTMLElement>('[data-collection]');
    if (!root || root.dataset.pwInit === '1') return;
    root.dataset.pwInit = '1';

    root.querySelectorAll<HTMLAnchorElement>('[data-pw-jump]').forEach((link) => {
      link.addEventListener('click', (event) => {
        const target = document.querySelector<HTMLElement>(link.getAttribute('href') ?? '');
        if (!target) return;
        event.preventDefault();
        const lenis = (window as any).__lenis;
        if (lenis?.scrollTo) lenis.scrollTo(target, { offset: -80, duration: 1.1 });
        else target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-pw-read]').forEach((button) => {
      button.addEventListener('click', () => {
        const board = button.closest('.pw-board');
        const img = board?.querySelector<HTMLImageElement>('.pw-sheet.is-on img') ?? board?.querySelector<HTMLImageElement>('[data-pw-sheets] img');
        img?.click();
      });
    });

    root.querySelectorAll<HTMLElement>('[data-pw-reader]').forEach((reader) => {
      const pages = Array.from(reader.querySelectorAll<HTMLElement>('[data-pw-page]'));
      const count = reader.querySelector<HTMLElement>('[data-pw-count]');
      let current = 0;
      const turn = (dir: number) => {
        const next = (current + dir + pages.length) % pages.length;
        pages[current].classList.remove('is-on');
        if (dir > 0) pages[current].classList.add('is-gone');
        pages[next].classList.remove('is-gone');
        pages[next].classList.add('is-on');
        current = next;
        if (count) count.textContent = String(current + 1).padStart(2, '0');
        if (current === 0) pages.forEach((p) => p.classList.remove('is-gone'));
      };
      reader.querySelectorAll<HTMLButtonElement>('[data-pw-turn]').forEach((b) =>
        b.addEventListener('click', () => turn(Number(b.dataset.pwTurn))),
      );
      reader.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        turn(e.key === 'ArrowRight' ? 1 : -1);
      });
    });

    const motion = document.documentElement.dataset.motion;
    const calm = motion === 'still' || window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    root.querySelectorAll<HTMLElement>('.is-hand').forEach((pile) => {
      const deal = () => pile.classList.remove('is-waiting');
      if (!calm) {
        pile.classList.add('is-waiting');
        dealObserver = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) return;
            deal();
            dealObserver?.disconnect();
          },
          { threshold: 0.35 },
        );
        dealObserver.observe(pile);
      }
      pile.querySelector<HTMLButtonElement>('[data-pw-deal]')?.addEventListener('click', () => {
        if (calm) return;
        pile.classList.add('is-waiting');
        window.setTimeout(deal, 650);
      });
    });

    root.querySelectorAll<HTMLElement>('.is-hand').forEach((pile) => {
      const caption = pile.querySelector<HTMLElement>('[data-pw-hand-caption]');
      if (!caption) return;
      const initial = caption.innerHTML;
      pile.querySelectorAll<HTMLElement>('[data-pw-piece]').forEach((card) => {
        const show = () => {
          const text = card.querySelector('figcaption');
          if (text) caption.innerHTML = text.innerHTML;
        };
        card.addEventListener('mouseenter', show);
        card.addEventListener('focus', show);
        card.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            card.querySelector('img')?.click();
          }
        });
      });
      pile.querySelector('.pw-pile-body')?.addEventListener('mouseleave', () => {
        caption.innerHTML = initial;
      });
    });
  }

  let dealObserver: IntersectionObserver | undefined;

  document.addEventListener('astro:page-load', initCollection);
  document.addEventListener('astro:before-swap', () => {
    dealObserver?.disconnect();
    dealObserver = undefined;
  });
</script>
