---
// Smaller pieces that don't belong to one film. Same paper and pins as the
// sketchbook, but each pile is laid out like the thing it is: a band
// lineup, a hand of cards, polaroids, New Year prints, a calendar page,
// a pinned strip, storyboard sheets. Piles share rows so the page stays
// short; an index at the top jumps straight to one.
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getProjectImage, responsiveWidths } from '@/lib/images';
import ProjectFooter from './ProjectFooter.astro';
import I18nText from '@/components/I18nText.astro';
import { trAll } from '@/i18n/ui';
import { vividOf } from '@/lib/color';
import { charReveal } from '@/lib/reveal-text';
import ProjectIntro from '@/components/ProjectIntro.astro';
import VideoPlayer from '@/components/VideoPlayer.astro';
import ScrollCue from '@/components/ScrollCue.astro';
import '@fontsource-variable/caveat';

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}
const { project, next } = Astro.props;
const { title, subtitle, description, year, roles, category, cover, coverAlt, gallery, accentFrom, accentTo, links, videos, piles = [], storyboards = [] } = project.data;
const glow = vividOf(accentFrom, accentTo);
const coverImg = getProjectImage(project.id, cover);
const categoryLabel = trAll(`category.${category}` as const);

type Item = (typeof gallery)[number];
type Pile = { id: string; label: NonNullable<Item['chapter']>; items: Item[]; display: (typeof piles)[number]['display']; note?: (typeof piles)[number]['note'] };

const groups: Pile[] = [];
for (const item of gallery) {
  if (!item.chapter) continue;
  const last = groups[groups.length - 1];
  if (last && last.label.en === item.chapter.en) {
    last.items.push(item);
  } else {
    const meta = piles.find((p) => p.chapter === item.chapter!.en);
    groups.push({ id: `pile-${groups.length + 1}`, label: item.chapter, items: [item], display: meta?.display ?? 'strip', note: meta?.note });
  }
}

const sheets = await Promise.all(
  storyboards.map(async (board) =>
    Promise.all(
      board.pages.map(async (file) => {
        const src = getProjectImage(project.id, file);
        const full = await getImage({ src, width: Math.min(src.width, 1800) });
        return { file, src, full: full.src };
      })
    )
  )
);
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI'];

const tilt = (i: number) => ((((i * 53 + 7) % 9) - 4) * 0.8).toFixed(2);
const isGif = (file: string) => file.endsWith('.gif');
const fanAngle = (i: number, n: number) => ((i - (n - 1) / 2) * (n > 4 ? 7 : 9)).toFixed(2);
const fanDrop = (i: number, n: number) => (Math.abs(i - (n - 1) / 2) ** 2 * 0.5).toFixed(2);
---

<article class="collection" style={`--mood-a:${accentFrom}; --mood-b:${accentTo}; --mood-glow:${glow};`} data-collection data-reveal-root>
  <header class="pw-hero">
    <div class="pw-hero-cover">
      <span class="pw-nail" aria-hidden="true"></span>
      <div class="pw-cover-frame">
        <Image
          src={coverImg}
          alt={coverAlt.en}
          widths={responsiveWidths(coverImg, [320, 480, 640])}
          sizes="(max-width: 700px) 62vw, 21rem"
          loading="eager"
          fetchpriority="high"
          transition:name={`project-cover-${project.id}`}
        />
      </div>
    </div>
    <div class="pw-hero-copy">
      <p class="hero-eyebrow eyebrow">
        <I18nText {...categoryLabel} /> · {year}
      </p>
      <h1 class="pw-hero-title" transition:name={`project-title-${project.id}`} set:html={charReveal(title, 120, 22)} />
      <p class="pw-hero-subtitle">
        <I18nText en={subtitle.en} fr={subtitle.fr} zh={subtitle.zh} />
      </p>
      <ProjectIntro description={description} links={links} />
      <ul class="hero-roles">
        {roles.en.map((_, i) => (
          <li>
            <I18nText en={roles.en[i]} fr={roles.fr[i]} zh={roles.zh[i]} />
          </li>
        ))}
      </ul>
    </div>
    <div class="pw-hero-cue">
      <ScrollCue />
    </div>
  </header>

  <nav class="pw-index" aria-label="Piles" data-pw-index>
    {videos?.length ? (
      <a href="#pile-motion" data-pw-jump>
        <I18nText en="in motion" fr="en mouvement" zh="动画" />
        <span class="pw-index-count">{videos.length}</span>
      </a>
    ) : null}
    {groups.map((group) => (
      <a href={`#${group.id}`} data-pw-jump>
        <I18nText en={group.label.en} fr={group.label.fr} zh={group.label.zh} />
        <span class="pw-index-count">{group.items.length}</span>
      </a>
    ))}
    {storyboards.length > 0 && (
      <a href="#pile-storyboards" data-pw-jump>
        <I18nText en="Storyboards" fr="Storyboards" zh="分镜" />
        <span class="pw-index-count">{storyboards.length}</span>
      </a>
    )}
  </nav>

  {videos?.map((clip) => (
    <section class="pw-motion" id="pile-motion">
      <div class="pw-motion-player">
        <VideoPlayer src={`/videos/${project.id}/${clip.file}`} skin="saber" label="Anakin · Mustafar" />
      </div>
      <div class="pw-motion-copy">
        <p class="pw-kicker eyebrow"><I18nText en="in motion" fr="en mouvement" zh="动画" /></p>
        <h2 class="pw-pile-title"><I18nText en={clip.label.en} fr={clip.label.fr} zh={clip.label.zh} /></h2>
        <p class="pw-pile-note">
          <I18nText
            en="A fan animation of Anakin Skywalker on Mustafar."
            fr="Une animation de fan : Anakin Skywalker sur Mustafar."
            zh="一段同人动画：穆斯塔法星上的安纳金·天行者。"
          />
        </p>
      </div>
    </section>
  ))}

  <div class="pw-piles">
    {groups.map((group) => (
      <section class:list={['pw-pile', `is-${group.display}`]} id={group.id} style={`--count:${group.items.length};`}>
        <header class="pw-pile-head">
          <h2 class="pw-pile-title">
            <I18nText en={group.label.en} fr={group.label.fr} zh={group.label.zh} />
          </h2>
          {group.note && (
            <p class="pw-pile-note">
              <I18nText en={group.note.en} fr={group.note.fr} zh={group.note.zh} />
            </p>
          )}
        </header>
        <div class="pw-pile-body" data-lb-group>
          {group.items.map((item, i) => {
            const img = getProjectImage(project.id, item.file);
            const text = item.caption ?? item.alt;
            return (
              <figure
                class="pw-piece"
                style={`--tilt:${tilt(i)}deg; --fan:${fanAngle(i, group.items.length)}deg; --drop:${fanDrop(i, group.items.length)}rem; --i:${i}; --off:${(group.items.length - 1) / 2 - i};`}
                data-artwork
                data-note-id={`${project.id}:${item.file}`}
                data-pw-piece
                tabindex={group.display === 'hand' ? 0 : undefined}
              >
                <span class="pw-frame">
                  {isGif(item.file) ? (
                    <img src={img.src} alt={item.alt.en} width={img.width} height={img.height} loading="lazy" />
                  ) : (
                    <Image src={img} alt={item.alt.en} widths={responsiveWidths(img, [360, 560, 900])} sizes="(max-width: 700px) 80vw, 24rem" loading="lazy" />
                  )}
                  {group.display === 'hand' && (
                    <>
                      <span class="pw-pip is-top" aria-hidden="true">{String(i + 1).padStart(2, '0')}<i>✦</i></span>
                      <span class="pw-pip is-bottom" aria-hidden="true">{String(i + 1).padStart(2, '0')}<i>✦</i></span>
                      <span class="pw-back" aria-hidden="true"><i>✦</i></span>
                    </>
                  )}
                </span>
                <figcaption>
                  <I18nText en={text.en} fr={text.fr} zh={text.zh} />
                </figcaption>
              </figure>
            );
          })}
        </div>
        {group.display === 'hand' && (
          <div class="pw-hand-foot">
            <p class="pw-hand-caption" aria-live="polite" data-pw-hand-caption>
              <I18nText en="Hover a card to read it." fr="Survole une carte pour la lire." zh="把鼠标移到卡牌上看说明。" />
            </p>
            <button type="button" class="pw-deal" data-pw-deal>
              <I18nText en="deal again" fr="redistribuer" zh="重新发牌" />
            </button>
          </div>
        )}
      </section>
    ))}
  </div>

  {storyboards.length > 0 && (
    <section class="pw-boards" id="pile-storyboards">
      <header class="pw-pile-head pw-boards-head">
        <h2 class="pw-pile-title"><I18nText en="Storyboards" fr="Storyboards" zh="分镜" /></h2>
        <p class="pw-pile-note">
          <I18nText
            en="Three storyboards. Turn the pages, or open one to read it full size."
            fr="Trois storyboards. Tourne les pages, ou ouvre-en une pour la lire en grand."
            zh="三份分镜。可以翻页，也可以点开一页看大图。"
          />
        </p>
      </header>
      {storyboards.map((board, bi) => (
        <div class={`pw-board look-${board.look}`}>
          {board.look === 'sand' && (
            <>
              <span class="pw-sun" aria-hidden="true"></span>
              <span class="pw-grains" aria-hidden="true"></span>
            </>
          )}
          {board.look === 'night' && <span class="pw-stars" aria-hidden="true"></span>}
          <div class="pw-board-info">
            <p class="pw-board-num">{roman[bi] ?? bi + 1}</p>
            <h3 class="pw-board-title"><I18nText en={board.title.en} fr={board.title.fr} zh={board.title.zh} /></h3>
            <p class="pw-pile-note"><I18nText en={board.note.en} fr={board.note.fr} zh={board.note.zh} /></p>
            <p class="pw-board-meta">
              <I18nText en={`${board.pages.length} pages`} fr={`${board.pages.length} pages`} zh={`${board.pages.length} 页`} />
            </p>
            <button type="button" class="pw-board-read" data-pw-read data-cursor-hover>
              <I18nText en="open full size" fr="ouvrir en grand" zh="打开大图" />
            </button>
          </div>
          {board.look === 'wall' ? (
            <div class="pw-wall" data-lb-group data-pw-sheets>
              {sheets[bi].map((sheet, si) => (
                <figure class="pw-sheet" style={`--tilt:${tilt(si)}deg;`} data-artwork data-note-id={`${project.id}:${sheet.file}`}>
                  <span class="pw-pin" aria-hidden="true"></span>
                  <Image
                    src={sheet.src}
                    alt={`${board.title.en}, page ${si + 1}`}
                    data-full={sheet.full}
                    widths={[280, 440]}
                    sizes="(max-width: 700px) 40vw, 11rem"
                    loading="lazy"
                  />
                  <figcaption>{String(si + 1).padStart(2, '0')}</figcaption>
                </figure>
              ))}
            </div>
          ) : (
            <div class="pw-reader" data-pw-reader tabindex="0">
              <div class="pw-reader-stage" data-lb-group data-pw-sheets>
                {sheets[bi].map((sheet, si) => (
                  <figure class:list={['pw-sheet', { 'is-on': si === 0 }]} data-pw-page={si} data-artwork data-note-id={`${project.id}:${sheet.file}`}>
                    <Image
                      src={sheet.src}
                      alt={`${board.title.en}, page ${si + 1}`}
                      data-full={sheet.full}
                      widths={[480, 800, 1200]}
                      sizes={board.look === 'night' ? '(max-width: 700px) 92vw, 52rem' : '(max-width: 700px) 86vw, 30rem'}
                      loading={si < 2 ? 'eager' : 'lazy'}
                    />
                  </figure>
                ))}
              </div>
              <div class="pw-reader-nav">
                <button type="button" class="pw-turn" data-pw-turn="-1" aria-label="Previous page">‹</button>
                <span class="pw-reader-count"><span data-pw-count>01</span> / {String(board.pages.length).padStart(2, '0')}</span>
                <button type="button" class="pw-turn" data-pw-turn="1" aria-label="Next page">›</button>
              </div>
            </div>
          )}
        </div>
      ))}
    </section>
  )}

  <ProjectFooter project={project} next={next} />
</article>

<style>
  .collection {
    background:
      repeating-linear-gradient(0deg, transparent 0 39px, color-mix(in srgb, var(--mood-a) 14%, transparent) 39px 40px),
      color-mix(in srgb, var(--void) 88%, var(--mood-a) 12%);
  }

  /* ---- hero ---- */
  .pw-hero {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 6vw, 5rem);
    min-height: 88svh;
    padding: var(--space-6) var(--edge) var(--space-5);
  }

  .pw-hero-cue {
    position: absolute;
    left: var(--edge);
    bottom: var(--space-3);
  }

  .pw-hero-cover {
    position: relative;
    flex: none;
    width: clamp(12rem, 22vw, 21rem);
  }

  .pw-cover-frame {
    overflow: hidden;
    border-radius: 2px;
    border: 8px solid var(--bone);
    box-shadow: 0 1.5rem 3.5rem -1rem rgb(0 0 0 / 65%), 0 0 3rem 0.2rem color-mix(in srgb, var(--mood-glow) 25%, transparent);
    transform: rotate(-2deg);
  }

  .pw-cover-frame :global(img) {
    width: 100%;
    display: block;
  }

  .pw-nail {
    position: absolute;
    left: 50%;
    top: -0.5rem;
    z-index: 1;
    width: 0.9rem;
    height: 0.9rem;
    margin-left: -0.45rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--bone), var(--mood-b) 70%);
    box-shadow: 0 0.3rem 0.4rem rgb(0 0 0 / 45%);
  }

  .pw-hero-copy {
    flex: 1 1 24rem;
    max-width: 34rem;
  }

  .hero-eyebrow {
    color: var(--gold);
    margin-bottom: var(--space-2);
  }

  .pw-hero-title {
    font-size: var(--text-2xl);
    line-height: 0.96;
  }

  .pw-hero-subtitle {
    font-size: var(--text-lg);
    color: var(--bone-soft);
    margin-top: var(--space-2);
  }

  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    list-style: none;
    margin-top: var(--space-3);
    padding: 0;
  }

  .hero-roles li {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    border: 1px solid var(--void-line);
    padding: 0.4em 0.85em;
    border-radius: 999px;
  }

  /* ---- index of piles: paper tabs ---- */
  .pw-index {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 0.8rem;
    padding: 0 var(--edge) var(--space-5);
  }

  .pw-index a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    padding: 0.5em 1em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--void);
    background: color-mix(in srgb, var(--bone) 88%, var(--mood-a));
    transform: rotate(var(--r, -1deg));
    transition: transform 0.35s var(--ease-out-expo), background 0.3s;
  }

  .pw-index a:nth-child(even) {
    --r: 1.2deg;
  }

  .pw-index a:hover,
  .pw-index a:focus-visible {
    background: var(--gold);
    transform: rotate(0deg) translateY(-2px);
  }

  :lang(zh) .pw-index a {
    text-transform: none;
  }

  .pw-index-count {
    opacity: 0.55;
  }

  /* ---- shared pile parts ---- */
  .pw-pile-title {
    font-size: var(--text-xl);
    line-height: 1.05;
  }

  .pw-pile-note {
    margin-top: var(--space-2);
    max-width: 42ch;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--bone-soft);
  }

  .pw-kicker {
    color: var(--gold);
    margin-bottom: var(--space-2);
  }

  .pw-piles {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: var(--space-5) clamp(1.5rem, 4vw, 4rem);
    padding: var(--space-5) var(--edge) var(--space-6);
  }

  .pw-pile {
    grid-column: span 12;
    scroll-margin-top: 5rem;
  }

  .pw-pile.is-lineup,
  .pw-pile.is-polaroids {
    grid-column: span 7;
  }

  .pw-pile.is-festival,
  .pw-pile.is-calendar {
    grid-column: span 5;
  }

  .pw-pile-head {
    margin-bottom: var(--space-4);
  }

  .pw-pile-body {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .pw-piece {
    position: relative;
    margin: 0;
  }

  .pw-frame {
    display: block;
    overflow: hidden;
  }

  .pw-frame :global(img) {
    display: block;
    height: var(--h, 16rem);
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .pw-piece figcaption {
    margin-top: 0.6rem;
    max-width: 24ch;
    font-family: 'Caveat Variable', cursive;
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem);
    line-height: 1.2;
    color: var(--bone);
  }

  :lang(zh) .pw-piece figcaption {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-sm);
  }

  /* ---- lineup: one portrait per band member, like a gig poster ---- */
  .is-lineup .pw-pile-body {
    flex-wrap: nowrap;
    gap: clamp(0.75rem, 1.8vw, 1.5rem);
  }

  .is-lineup .pw-piece {
    flex: 1 1 0;
    min-width: 0;
    transform: rotate(var(--tilt));
    transition: transform 0.45s var(--ease-out-expo);
  }

  .is-lineup .pw-piece:hover {
    transform: rotate(0deg) translateY(-0.4rem);
  }

  .is-lineup .pw-frame {
    border: 6px solid var(--bone);
    box-shadow: 0 1.2rem 2.5rem -1rem rgb(0 0 0 / 60%);
  }

  .is-lineup .pw-frame :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .is-lineup figcaption {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--bone-soft);
  }

  :lang(zh) .is-lineup figcaption {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: var(--text-xs);
  }

  /* ---- hand: the cards fanned out, the hovered one is lifted ---- */
  .is-hand {
    text-align: center;
  }

  .is-hand .pw-pile-head {
    text-align: left;
  }

  /* a felt card table; the cards wait face down in one pile at the
     centre (.is-waiting, set by the script) and are dealt into a fan */
  .is-hand .pw-pile-body {
    --card-w: clamp(11rem, 19vw, 18.5rem);
    --card-m: clamp(-3.4rem, -2.6vw, -1.4rem);
    flex-wrap: nowrap;
    justify-content: center;
    gap: 0;
    padding: clamp(2.4rem, 5vw, 4rem) clamp(1rem, 3vw, 3rem) clamp(3rem, 6vw, 5rem);
    border-radius: 14rem / 5rem;
    background:
      radial-gradient(ellipse 60% 55% at 50% 40%, rgb(255 255 255 / 9%), transparent 70%),
      repeating-linear-gradient(45deg, rgb(0 0 0 / 5%) 0 2px, transparent 2px 4px),
      #1f4a36;
    box-shadow:
      inset 0 0 0 0.55rem #4a2a17,
      inset 0 0 0 0.7rem #b98a4a,
      inset 0 0 0 1.2rem #3a2112,
      inset 0 0 4rem 1.4rem rgb(0 0 0 / 55%),
      0 2rem 4rem -1.5rem rgb(0 0 0 / 70%);
    perspective: 1600px;
  }

  .is-hand .pw-piece {
    flex: none;
    width: var(--card-w);
    margin-inline: var(--card-m);
    transform-origin: 50% 120%;
    transform: rotate(var(--fan)) translateY(var(--drop));
    transition: transform 0.7s var(--ease-out-expo);
    transition-delay: calc(var(--i) * 0.11s);
    outline: none;
  }

  .is-hand.is-waiting .pw-piece {
    transform: translateX(calc(var(--off) * (var(--card-w) + 2 * var(--card-m)))) translateY(-1rem) rotate(calc(var(--off) * 1.5deg));
    transition-delay: 0s;
  }

  .is-hand .pw-piece:hover,
  .is-hand .pw-piece:focus-visible {
    z-index: 5;
    transform: rotate(0deg) translateY(-2.2rem) scale(1.12);
    transition-delay: 0s;
  }

  .is-hand .pw-frame {
    position: relative;
    aspect-ratio: 5 / 7;
    padding: 0.5rem;
    overflow: visible;
    border-radius: 0.7rem;
    background: linear-gradient(160deg, #f7efe2, #e6d9c3);
    box-shadow:
      inset 0 0 0 1px #b98a4a,
      inset 0 0 0 5px #f7efe2,
      inset 0 0 0 6px color-mix(in srgb, #b98a4a 70%, transparent),
      0 1.4rem 2.4rem -1rem rgb(0 0 0 / 70%);
    transform-style: preserve-3d;
    transition: transform 0.8s var(--ease-out-expo);
    transition-delay: calc(var(--i) * 0.11s + 0.25s);
  }

  .is-hand.is-waiting .pw-frame {
    transform: rotateY(180deg);
    transition-delay: 0s;
  }

  .is-hand .pw-frame :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 0.4rem;
    object-fit: contain;
    background: #fbf6ee;
    backface-visibility: hidden;
  }

  .pw-pip {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    line-height: 1;
    color: #8c1d14;
    backface-visibility: hidden;
    pointer-events: none;
  }

  .pw-pip i {
    font-style: normal;
    font-size: 0.8em;
    color: #b98a4a;
  }

  .pw-pip.is-top {
    top: 0.85rem;
    left: 0.85rem;
  }

  .pw-pip.is-bottom {
    right: 0.85rem;
    bottom: 0.85rem;
    rotate: 180deg;
  }

  .pw-back {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 0.7rem;
    background:
      radial-gradient(circle at 50% 50%, transparent 22%, rgb(0 0 0 / 25%) 23% 24%, transparent 25%),
      repeating-linear-gradient(45deg, #6e1610 0 6px, #861c14 6px 12px);
    box-shadow: inset 0 0 0 0.45rem #f7efe2, inset 0 0 0 0.55rem #b98a4a;
    transform: rotateY(180deg) translateZ(1px);
    backface-visibility: hidden;
  }

  .pw-back i {
    font-style: normal;
    font-size: clamp(2rem, 4vw, 3.4rem);
    color: #e9c27a;
  }

  .is-hand .pw-piece:focus-visible .pw-frame {
    box-shadow:
      inset 0 0 0 2px var(--gold),
      0 0 0 3px var(--gold),
      0 1.4rem 2.4rem -1rem rgb(0 0 0 / 70%);
