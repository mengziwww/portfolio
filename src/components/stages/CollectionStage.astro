    top: -0.55rem;
    left: 50%;
    width: 3rem;
    height: 1.1rem;
    transform: translateX(-50%) rotate(-4deg);
    background: color-mix(in srgb, var(--bone) 55%, transparent);
    box-shadow: 0 1px 2px rgb(0 0 0 / 25%);
  }

  .is-polaroids .pw-piece:hover {
    z-index: 2;
    transform: rotate(0deg) translateY(-0.3rem);
  }

  .is-polaroids .pw-frame :global(img) {
    width: 100%;
    height: auto;
    max-height: 18rem;
  }

  .is-polaroids figcaption {
    padding: 0.4rem 0.2rem 0.8rem;
    margin: 0;
    color: #2a2420;
  }

  /* ---- festival: New Year prints on red paper with a gold rule ---- */
  .is-festival .pw-pile-body {
    padding: clamp(1rem, 2vw, 1.6rem);
    background:
      radial-gradient(circle at 20% 15%, rgb(255 210 120 / 16%), transparent 45%),
