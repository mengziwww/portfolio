    width: min(64rem, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .altar-shrine {
    position: relative;
    width: min(100%, (100svh - 16rem) * 1.6);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .altar-eave {
    position: relative;
    z-index: 1;
