    clip-path: polygon(0 100%, 3% 10%, 8% 40%, 92% 40%, 97% 10%, 100% 100%);
  }

  .altar-stage {
    position: relative;
    display: grid;
    width: 100%;
    aspect-ratio: 16 / 10;
    cursor: zoom-in;
  }

  .altar-shot {
    grid-area: 1 / 1;
    margin: 0;
    min-height: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease;
    background: #0b0605;
  }

  .altar-shot.is-on {
    opacity: 1;
    pointer-events: auto;
  }

  .altar-shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .altar-plaque {
    width: min(100%, 44rem);
    max-width: none;
  }

  .altar-count {
    display: block;
    margin-bottom: 0.35em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: #d9a441;
  }

  .altar-caption {
    margin: 0;
    animation: altar-in 0.45s ease both;
  }

  .altar-caption[hidden] {
    display: none;
  }

  @keyframes altar-in {
    from { opacity: 0; transform: translateY(0.3rem); }
  }

  .altar-table {
    position: relative;
    width: min(100%, 64rem);
    margin-top: var(--space-4);
  }

  .altar-hint {
    margin: 0 0 0.7rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    color: #f0d9a8;
  }

  /* the painted scroll the offerings rest on, held by a roller at each end */
  .offer-scroll {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: stretch;
  }

  .offer-roller {
    width: 1.1rem;
    border-radius: 0.6rem;
    background: linear-gradient(90deg, #3b1c10, #a8662f 45%, #3b1c10);
    box-shadow: 0 0.6rem 1rem -0.4rem rgb(0 0 0 / 70%);
  }

  .offer-row {
    display: flex;
    justify-content: center;
    gap: clamp(0.8rem, 2vw, 1.8rem);
    margin: 0.5rem 0;
    padding: 1.6rem clamp(0.8rem, 2vw, 1.6rem) 2.2rem;
    list-style: none;
    background:
      repeating-linear-gradient(90deg, rgb(140 60 30 / 10%) 0 1px, transparent 1px 3.2rem),
      linear-gradient(180deg, #e9d6b2, #d9bf91);
    box-shadow: inset 0 0.5rem 0.8rem -0.5rem rgb(80 40 10 / 55%), inset 0 -0.5rem 0.8rem -0.5rem rgb(80 40 10 / 55%);
  }

  .offer-spot {
    flex: none;
  }

  .plate {
    --plate: clamp(5.4rem, 8.6vw, 7.6rem);
    position: relative;
    display: grid;
    place-items: center;
    width: var(--plate);
    height: var(--plate);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    rotate: var(--tilt);
    transition: translate 0.35s var(--ease-out-expo), rotate 0.35s ease, scale 0.35s var(--ease-out-expo);
  }

  .plate[aria-selected='true'] {
    translate: 0 -0.7rem;
    rotate: 0deg;
    scale: 1.1;
  }

  .plate[aria-selected='true'] .plate-dish {
    box-shadow: 0 0 0 3px #d9a441, 0 0 1.6rem 0.3rem rgb(255 190 90 / 55%), 0 1rem 1.4rem -0.4rem rgb(0 0 0 / 65%);
  }

  .altar-step {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    translate: 0 -50%;
    color: #f6dca0;
    background: rgb(20 8 5 / 78%);
    border: 1px solid #d9a441;
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.25s, color 0.25s;
  }

  .altar-step.is-prev {
    left: 0.7rem;
  }

  .altar-step.is-next {
    right: 0.7rem;
  }

  .altar-step:hover,
  .altar-step:focus-visible {
    color: #1d0d07;
    background: #d9a441;
  }

  .altar-step svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .plate-dish {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(circle, #fbf4e6 54%, #d9a441 55% 58%, #fbf4e6 59% 66%, #b9302a 67% 70%, #fbf4e6 71%);
    box-shadow: 0 0.8rem 1.2rem -0.4rem rgb(0 0 0 / 65%);
  }

  .plate-food {
    position: relative;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
  }

  .plate-food :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .plate-num {
    position: absolute;
    bottom: -1.4rem;
    left: 50%;
    translate: -50% 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: #6b2a14;
  }

  .plate[aria-selected='true'] .plate-num {
    color: #b9302a;
    font-weight: 700;
  }

  .plate:hover,
  .plate:focus-visible {
    translate: 0 -0.5rem;
    rotate: 0deg;
    outline: none;
  }

  .plate[aria-selected='true']:hover,
  .plate[aria-selected='true']:focus-visible {
    translate: 0 -0.7rem;
  }

  .plate:focus-visible .plate-dish {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }

  @media (max-width: 700px) {
    .moon-gate {
      width: 88vw;
