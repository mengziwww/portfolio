    .moon-gate.is-grand {
      width: 92vw;
    }
    .moon-gate figcaption,
    .altar-plaque,
    .chapter-note {
      font-size: var(--text-base);
    }
    .offer-row {
      justify-content: flex-start;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-inline: 1rem;
      scrollbar-width: none;
    }
    .offer-spot {
      scroll-snap-align: center;
    }
    .plate {
      --plate: 4.8rem;
    }
    .altar-step {
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gate-opening :global(img) {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  function initReel() {
    const roots = document.querySelectorAll<HTMLElement>('[data-reel]');
    if (!roots.length) return;
    gsap.registerPlugin(ScrollTrigger);
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    roots.forEach((root) => {
      if (root.dataset.reelInit === '1') return;
      root.dataset.reelInit = '1';

      const altar = root.querySelector<HTMLElement>('[data-altar]');
      if (altar) {
        const shots = Array.from(altar.querySelectorAll<HTMLElement>('[data-altar-shot]'));
        const captions = Array.from(altar.querySelectorAll<HTMLElement>('[data-altar-caption]'));
        const plates = Array.from(altar.querySelectorAll<HTMLButtonElement>('[data-plate]'));
        const count = altar.querySelector<HTMLElement>('[data-altar-count]');
        const stage = altar.querySelector<HTMLElement>('[data-altar-stage]');
        let current = 0;
        const show = (i: number, focus = false) => {
          current = (i + shots.length) % shots.length;
          shots.forEach((s, k) => s.classList.toggle('is-on', k === current));
          captions.forEach((c, k) => (c.hidden = k !== current));
          plates.forEach((p, k) => {
            p.setAttribute('aria-selected', String(k === current));
            p.tabIndex = k === current ? 0 : -1;
          });
          if (count) count.textContent = String(current + 1).padStart(2, '0');
          plates[current]?.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
          if (focus) plates[current]?.focus({ preventScroll: true });
        };
        plates.forEach((plate, k) => {
          plate.addEventListener('click', () => show(k));
          plate.addEventListener('keydown', (e) => {
            const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
            if (!step) return;
            e.preventDefault();
            show(current + step, true);
          });
        });
        altar.querySelectorAll<HTMLButtonElement>('[data-altar-step]').forEach((btn) =>
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            show(current + Number(btn.dataset.altarStep));
          }),
        );
        let downX = 0;
        let swiped = false;
        stage?.addEventListener('pointerdown', (e) => {
          downX = e.clientX;
          swiped = false;
        });
        stage?.addEventListener('pointerup', (e) => {
          const dx = e.clientX - downX;
          if (e.pointerType !== 'mouse' && Math.abs(dx) > 40) {
            swiped = true;
            show(current + (dx < 0 ? 1 : -1));
          }
        });
        stage?.addEventListener(
          'click',
          (e) => {
            if (!swiped) return;
            swiped = false;
            e.stopPropagation();
            e.preventDefault();
          },
          true,
        );
      }

      const nightRow = root.querySelector<HTMLElement>('[data-night-row]');
      const crowdFigures = Array.from(root.querySelectorAll<HTMLElement>('[data-crowd] [data-dropout]'));

      if (!nightRow || reduced) {
        crowdFigures.forEach((el) => {
          el.style.opacity = '0.35';
        });
        return;
      }

      gsap.to(root, {
        '--night-progress': 100,
        ease: 'none',
        scrollTrigger: {
          trigger: nightRow,
          start: 'top 80%',
          end: 'bottom 40%',
          scrub: 0.6,
        },
        onUpdate: function () {
          const p = gsap.getProperty(root, '--night-progress') as number;
          crowdFigures.forEach((el) => {
            const dropout = Number(el.dataset.dropout ?? 100);
            el.style.opacity = p > dropout ? '0' : '0.8';
          });
        },
      });
    });
  }

  document.addEventListener('astro:page-load', () => {
    initReel();
    requestAnimationFrame(() => ScrollTrigger.refresh());
  });

  document.addEventListener('astro:before-swap', () => {
    ScrollTrigger.getAll().forEach((t) => t.kill());
  });
</script>
