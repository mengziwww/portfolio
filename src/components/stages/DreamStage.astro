---
// A dream cinema: one screen in the dark, her images drifting around it as
// glowing memories. Picking one sends it flying onto the screen, its caption
// shows up like a subtitle, and the film plays on by itself until touched.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getProjectImage, responsiveWidths } from '@/lib/images';
import ProjectFooter from './ProjectFooter.astro';
import ScrollCue from '@/components/ScrollCue.astro';
import I18nText from '@/components/I18nText.astro';
import { trAll } from '@/i18n/ui';
import { vividOf } from '@/lib/color';
import { charReveal } from '@/lib/reveal-text';
import ProjectIntro from '@/components/ProjectIntro.astro';
interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}
const { project, next } = Astro.props;
const { title, subtitle, description, year, roles, category, client, cover, coverAlt, gallery, accentFrom, accentTo, links } = project.data;
const glow = vividOf(accentFrom, accentTo);
const coverImg = getProjectImage(project.id, cover);
const categoryLabel = trAll(`category.${category}` as const);
const clientLabel = trAll(category === 'commission' ? 'project.client' : 'project.at');
const total = gallery.length;
const pad = (n: number) => String(n).padStart(2, '0');

// memories hover in two staggered columns on either side of the screen:
// grid columns 1-2 on the left, 4-5 on the right, each fairy spanning two
// half-rows so neighbours zigzag
const memories = gallery.map((item, i) => {
  const side = i % 2;
  const k = Math.floor(i / 2);
  const seed = (i * 61 + 17) % 100;
  const outer = k % 2 === 0;
  return {
    item,
    img: getProjectImage(project.id, item.file),
    col: side === 0 ? (outer ? 1 : 2) : outer ? 5 : 4,
    row: k + 1 + side,
    size: (0.88 + (seed % 4) * 0.08).toFixed(2),
    dur: 7 + (seed % 5) * 1.4,
    delay: -((seed % 9) * 0.9),
    hue: seed % 3,
  };
});

const motes = Array.from({ length: 18 }, (_, i) => {
  const seed = (i * 37 + 5) % 100;
  return {
    left: `${(i * 41) % 100}%`,
    top: `${(i * 29 + 13) % 100}%`,
    size: 0.25 + (seed % 5) * 0.3,
    warm: seed % 2 === 0,
    delay: `${(i % 9) * 1.1}s`,
    dur: `${16 + (seed % 7) * 2}s`,
  };
});

const seats = Array.from({ length: 2 }, (_, row) =>
  Array.from({ length: row === 0 ? 15 : 13 }, (_, i) => ({ i })),
);

const ui = {
  now: { en: 'now dreaming', fr: 'en plein rêve', zh: '正在做梦' },
  pick: {
    en: 'Catch a memory and send it to the screen.',
    fr: 'Attrape un souvenir pour le projeter.',
    zh: '抓住一段记忆，把它放上银幕。',
  },
  play: { en: 'let it dream', fr: 'laisser rêver', zh: '继续做梦' },
  pause: { en: 'wake up', fr: 'se réveiller', zh: '醒来' },
  prev: { en: 'Previous memory', fr: 'Souvenir précédent', zh: '上一段记忆' },
  nextMem: { en: 'Next memory', fr: 'Souvenir suivant', zh: '下一段记忆' },
};
---

<article class="dream" style={`--mood-a:${accentFrom}; --mood-b:${accentTo}; --mood-glow:${glow};`} data-dream data-reveal-root>
  <div class="dream-motes" aria-hidden="true">
    {motes.map((m) => (
      <span
        class={`mote ${m.warm ? 'is-warm' : ''}`}
        style={`left:${m.left}; top:${m.top}; width:${m.size}rem; height:${m.size}rem; animation-delay:${m.delay}; animation-duration:${m.dur};`}
      ></span>
    ))}
  </div>

  <header class="dr-hero">
    <div class="dr-cover">
      <Image
        src={coverImg}
        alt={coverAlt.en}
        widths={responsiveWidths(coverImg, [420, 640, 900])}
        sizes="(max-width: 700px) 62vw, 20rem"
        loading="eager"
        fetchpriority="high"
        transition:name={`project-cover-${project.id}`}
      />
    </div>
    <div class="dr-copy">
      <p class="hero-eyebrow eyebrow">
        <I18nText {...categoryLabel} /> · {year}{client ? (
          <>
            {' · '}<I18nText {...clientLabel} /> {client}
          </>
        ) : null}
      </p>
      <h1 class="dr-title" transition:name={`project-title-${project.id}`} set:html={charReveal(title, 120, 22)} />
      <p class="dr-subtitle">
        <I18nText en={subtitle.en} fr={subtitle.fr} zh={subtitle.zh} />
      </p>
      <ProjectIntro description={description} links={links} />
      <ul class="hero-roles">
        {roles.en.map((_, i) => (
          <li style={`--i:${i}`}>
            <I18nText en={roles.en[i]} fr={roles.fr[i]} zh={roles.zh[i]} />
          </li>
        ))}
      </ul>
    </div>
    <div class="dr-cue">
      <ScrollCue />
    </div>
  </header>

  <section class="dm-cinema" data-dm aria-roledescription="carousel">
    <div class="dm-beam" aria-hidden="true"></div>

    <div class="dm-stage">
      <div class="dm-screen-wrap">
        <p class="dm-marquee">
          <span class="dm-dot" aria-hidden="true"></span>
          <I18nText {...ui.now} />
          <span class="dm-count"><span data-dm-count>01</span> / {pad(total)}</span>
        </p>
        <figure class="dm-screen" data-dm-screen data-lb-group>
          {memories.map((m, i) => (
            <div
              class:list={['dm-shot', { 'is-on': i === 0 }]}
              data-dm-shot={i}
              data-artwork
              data-note-id={`${project.id}:${m.item.file}`}
            >
              <Image
                src={m.img}
                alt={m.item.alt.en}
                widths={responsiveWidths(m.img, [640, 960, 1400])}
                sizes="(max-width: 760px) 94vw, 56vw"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </div>
          ))}
          <span class="dm-flicker" aria-hidden="true"></span>
        </figure>
        <div class="dm-subs" aria-live="polite">
          {memories.map((m, i) => (
            <p class="dm-sub" data-dm-sub={i} hidden={i !== 0}>
              {m.item.caption && <I18nText en={m.item.caption.en} fr={m.item.caption.fr} zh={m.item.caption.zh} />}
            </p>
          ))}
        </div>
        <div class="dm-controls">
          <button type="button" class="dm-step" data-dm-step="-1">
            <span aria-hidden="true">‹</span>
            <span class="sr-only"><I18nText {...ui.prev} /></span>
          </button>
          <button type="button" class="dm-play" data-dm-play aria-pressed="true">
            <span class="dm-play-on"><I18nText {...ui.pause} /></span>
            <span class="dm-play-off"><I18nText {...ui.play} /></span>
          </button>
          <button type="button" class="dm-step" data-dm-step="1">
            <span aria-hidden="true">›</span>
            <span class="sr-only"><I18nText {...ui.nextMem} /></span>
          </button>
        </div>
        <p class="dm-hint"><I18nText {...ui.pick} /></p>
      </div>

      <ul class="dm-memories">
        {memories.map((m, i) => (
          <li
            class="dm-memory"
            style={`--col:${m.col}; --row:${m.row}; --s:${m.size}; --dur:${m.dur}s; --delay:${m.delay}s;`}
            data-hue={m.hue}
          >
            <button
              type="button"
              class:list={['dm-orb', { 'is-watching': i === 0 }]}
              data-dm-orb={i}
              aria-label={`${pad(i + 1)} ${m.item.alt.en}`}
            >
              <span class="dm-wing is-l" aria-hidden="true"></span>
              <span class="dm-wing is-r" aria-hidden="true"></span>
              <span class="dm-orb-pic">
                <Image src={m.img} alt="" widths={[160, 240]} sizes="6rem" loading="lazy" />
              </span>
              <span class="dm-orb-num" aria-hidden="true">{pad(i + 1)}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <svg class="dm-seats" viewBox="0 0 1000 120" preserveAspectRatio="none" aria-hidden="true">
      {seats.map((row, r) => (
        <g transform={`translate(${r === 0 ? 0 : 36} ${r === 0 ? 40 : 72})`}>
          {row.map((s) => (
            <path
              d={`M${s.i * 68 + 6} 60 V${18 - r * 2} Q${s.i * 68 + 6} 4 ${s.i * 68 + 20} 4 H${s.i * 68 + 48} Q${s.i * 68 + 62} 4 ${s.i * 68 + 62} ${18 - r * 2} V60 Z`}
            />
          ))}
        </g>
      ))}
    </svg>
  </section>

  <ProjectFooter project={project} next={next} />
</article>

<style>
  .dream {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 90% 50% at 50% 0%, color-mix(in srgb, var(--mood-a) 22%, transparent), transparent 70%),
      linear-gradient(180deg, var(--void), color-mix(in srgb, var(--mood-b) 38%, #07050c) 55%, #07050c);
  }

  .dream-motes {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .mote {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--mood-b) 60%, var(--bone) 40%) 30%, transparent 70%);
    opacity: 0;
    animation: mote-float ease-in-out infinite;
  }

  .mote.is-warm {
    background: radial-gradient(circle, color-mix(in srgb, var(--mood-a) 60%, var(--gold) 40%) 30%, transparent 70%);
  }

  @keyframes mote-float {
    0% { opacity: 0; transform: translate(0, 0); }
    20% { opacity: 0.55; }
    50% { transform: translate(1.5rem, -2rem); }
    80% { opacity: 0.35; }
    100% { opacity: 0; transform: translate(-1rem, -4rem); }
  }

  /* ---- hero ---- */
  .dr-hero {
    position: relative;
    z-index: 2;
    min-height: 88svh;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding: var(--space-6) var(--edge) var(--space-5);
  }

  .dr-cover {
    flex: none;
    width: clamp(11rem, 20vw, 20rem);
    overflow: hidden;
    border-radius: 2px;
    box-shadow: 0 2rem 5rem -1.5rem rgb(0 0 0 / 70%), 0 0 4rem 0.4rem color-mix(in srgb, var(--mood-glow) 25%, transparent);
    transform: rotate(-1.5deg);
  }

  .dr-cover :global(img) {
    width: 100%;
    display: block;
  }

  .dr-copy {
    flex: 1 1 24rem;
    max-width: 32rem;
  }

  .hero-eyebrow {
    color: var(--gold);
    margin-bottom: var(--space-2);
  }

  .dr-title {
    font-size: var(--text-2xl);
    line-height: 0.96;
  }

  .dr-subtitle {
    font-size: var(--text-lg);
    color: var(--bone-soft);
    margin-top: var(--space-2);
  }

  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    list-style: none;
    margin-top: var(--space-3);
    padding: 0;
  }

  .hero-roles li {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    border: 1px solid var(--void-line);
    padding: 0.4em 0.85em;
    border-radius: 999px;
  }

  .dr-cue {
    position: absolute;
    left: var(--edge);
    bottom: var(--space-3);
  }

  /* ---- the cinema ---- */
  .dm-cinema {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    padding: var(--space-5) var(--edge) var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .dm-beam {
    position: absolute;
    left: 0;
    right: 0;
    top: 12%;
    bottom: 0;
    pointer-events: none;
    background: linear-gradient(0deg, color-mix(in srgb, #fff3d6 14%, transparent), transparent 80%);
    clip-path: polygon(48.5% 100%, 51.5% 100%, 78% 0, 22% 0);
    opacity: 0.35;
    animation: dm-beam 6s ease-in-out infinite;
  }

  @keyframes dm-beam {
    0%, 100% { opacity: 0.32; }
    47% { opacity: 0.4; }
    50% { opacity: 0.26; }
    53% { opacity: 0.38; }
  }

  .dm-stage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(4rem, 7rem)) auto repeat(2, minmax(4rem, 7rem));
    grid-template-rows: repeat(8, 1fr);
    justify-content: center;
    align-items: center;
    column-gap: clamp(0.8rem, 2.4vw, 2.6rem);
    width: 100%;
    margin-inline: auto;
  }

  .dm-screen-wrap {
    position: relative;
    grid-column: 3;
    grid-row: 1 / -1;
    width: min(46vw, 54rem, (100svh - 15rem) * 1.6);
    z-index: 2;
  }

  .dm-marquee {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.7rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--gold) 80%, var(--bone));
  }

  .dm-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #ff5d6c;
    box-shadow: 0 0 0.6rem #ff5d6c;
    animation: dm-rec 1.6s steps(2) infinite;
  }

  @keyframes dm-rec {
    50% { opacity: 0.25; }
  }

  .dm-count {
    margin-left: auto;
    color: var(--bone-soft);
  }

  .dm-screen {
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 10;
    background: #050308;
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow:
      0 0 0 1px color-mix(in srgb, #fff3d6 18%, transparent),
      0 0 3rem 0.4rem color-mix(in srgb, #fff3d6 16%, transparent),
      0 0 9rem 2rem color-mix(in srgb, var(--mood-glow) 26%, transparent);
    cursor: zoom-in;
  }

  .dm-shot {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s ease, filter 0.9s ease;
    filter: blur(8px) brightness(1.6);
  }

  .dm-shot.is-on {
    opacity: 1;
    filter: none;
    pointer-events: auto;
  }

  .dm-shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .dm-flicker {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 50% 50%, transparent 55%, rgb(0 0 0 / 45%)),
      repeating-linear-gradient(0deg, rgb(255 255 255 / 2.5%) 0 1px, transparent 1px 3px);
    animation: dm-flick 0.18s steps(2) infinite;
  }

  @keyframes dm-flick {
    50% { opacity: 0.82; }
  }

  .dm-subs {
    min-height: 3.4em;
    margin-top: 0.9rem;
    text-align: center;
  }

  .dm-sub {
    display: inline-block;
    max-width: 44ch;
    padding: 0.25em 0.7em;
    font-size: var(--text-base);
    line-height: 1.4;
    color: #fffbea;
    background: rgb(0 0 0 / 55%);
    text-shadow: 0 1px 2px #000;
    animation: dm-sub-in 0.5s ease both;
  }

  .dm-sub[hidden] {
    display: none;
  }

  @keyframes dm-sub-in {
    from { opacity: 0; transform: translateY(0.3rem); }
  }

  .dm-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;
    margin-top: 0.4rem;
  }

  .dm-step,
  .dm-play {
    font-family: var(--font-mono);
    color: var(--bone);
    background: rgb(255 255 255 / 6%);
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }

  .dm-step {
    width: 2.4rem;
    height: 2.4rem;
    font-size: 1.3rem;
    line-height: 1;
  }

  .dm-play {
    padding: 0.55em 1.2em;
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .dm-step:hover,
  .dm-play:hover,
  .dm-step:focus-visible,
  .dm-play:focus-visible {
    background: rgb(255 255 255 / 14%);
    border-color: var(--gold);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .dm-play[aria-pressed='true'] .dm-play-off,
  .dm-play[aria-pressed='false'] .dm-play-on {
    display: none;
  }

  .dm-hint {
    margin-top: 0.9rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--bone-soft);
  }

  /* ---- memory fairies ---- */
  .dm-memories {
    display: contents;
    list-style: none;
  }

  .dm-memory {
    position: relative;
    grid-column: var(--col);
    grid-row: var(--row) / span 2;
    justify-self: center;
    z-index: 3;
  }

  .dm-orb {
    --size: calc(clamp(3.4rem, 5vw, 5.6rem) * var(--s, 1));
    --halo: #ffe7a8;
    position: relative;
    display: block;
    width: var(--size);
    height: var(--size);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    animation: dm-drift var(--dur, 8s) ease-in-out var(--delay, 0s) infinite;
    transition: opacity 0.5s ease, scale 0.5s ease;
  }

  [data-hue='1'] .dm-orb {
    --halo: #c9b8ff;
  }

  [data-hue='2'] .dm-orb {
    --halo: #ffb8cf;
  }

  @keyframes dm-drift {
    0%, 100% { transform: translate(0, 0) rotate(-3deg); }
    30% { transform: translate(0.6rem, -0.9rem) rotate(2deg); }
    65% { transform: translate(-0.5rem, -0.3rem) rotate(-1deg); }
  }

  .dm-orb-pic {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    overflow: hidden;
    box-shadow:
      0 0 0 2px color-mix(in srgb, var(--halo) 70%, transparent),
      0 0 1.2rem 0.3rem color-mix(in srgb, var(--halo) 50%, transparent);
  }

  .dm-orb::before {
    content: '';
    position: absolute;
    inset: -35%;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--halo) 38%, transparent) 35%, transparent 68%);
    animation: dm-pulse 3.2s ease-in-out var(--delay, 0s) infinite;
  }

  .dm-orb-pic::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 26%, rgb(255 255 255 / 60%), transparent 22%),
      radial-gradient(circle at 50% 50%, transparent 52%, color-mix(in srgb, var(--halo) 40%, transparent) 100%);
  }

  @keyframes dm-pulse {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }

  .dm-orb-pic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(1.1) brightness(1.05);
  }

  .dm-wing {
    position: absolute;
    top: 8%;
    width: 46%;
    height: 56%;
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    background: radial-gradient(ellipse at 50% 60%, color-mix(in srgb, var(--halo) 45%, transparent), transparent 70%);
    border: 1px solid color-mix(in srgb, var(--halo) 35%, transparent);
    animation: dm-flap 0.9s ease-in-out infinite alternate;
  }

  .dm-wing.is-l {
    right: 72%;
    transform-origin: 100% 70%;
    rotate: -24deg;
  }

  .dm-wing.is-r {
    left: 72%;
    transform-origin: 0 70%;
    rotate: 24deg;
  }

  @keyframes dm-flap {
    to { transform: scaleX(0.55); }
  }

  .dm-orb-num {
    position: absolute;
    left: 50%;
    bottom: -1.3rem;
    translate: -50% 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--halo) 80%, var(--bone));
    opacity: 0.8;
  }

  .dm-orb:hover,
  .dm-orb:focus-visible {
    scale: 1.14;
    outline: none;
  }

  .dm-orb:focus-visible .dm-orb-pic {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }

  .dm-orb.is-watching {
    opacity: 0;
    scale: 0.4;
    pointer-events: none;
  }

  .dm-fly {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 50;
    pointer-events: none;
    transform-origin: 50% 50%;
    will-change: transform, clip-path;
  }

  .dm-fly img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .dm-seats {
    position: relative;
    display: block;
    width: 100%;
    height: clamp(3.5rem, 9vw, 7rem);
    margin-top: var(--space-4);
    fill: #07050c;
    z-index: 2;
    filter: drop-shadow(0 -1px 0 rgb(255 243 214 / 10%));
  }

  .dream :global(.project-footer) {
    position: relative;
    z-index: 2;
  }

  @media (max-width: 1100px) {
    .dm-stage {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .dm-screen-wrap {
      width: min(100%, 46rem);
    }

    .dm-memories {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.8rem 1.4rem;
      max-width: 46rem;
      margin: 0;
      padding: var(--space-4) 0.6rem 0;
    }

    .dm-orb {
      --size: calc(4.2rem * var(--s, 1));
    }

    .dm-orb.is-watching {
      opacity: 0.25;
      scale: 0.8;
    }
  }

  @media (max-width: 1100px), (pointer: coarse) {
    .dm-wing,
    .dm-flicker,
    .mote:nth-child(n + 9) {
      display: none;
    }

    .dm-orb,
    .dm-orb::before,
    .dm-beam {
      animation: none;
    }
  }

  @media (max-width: 760px) {
    .dr-hero {
      min-height: auto;
      padding-top: 6.5rem;
      text-align: center;
    }

    .dr-cover {
      width: min(62vw, 16rem);
    }

    .dr-copy {
      flex-basis: 100%;
    }

    .dr-copy :global(.project-desc) {
      margin-inline: auto;
    }

    .dr-copy :global(.project-links),
    .hero-roles {
      justify-content: center;
    }

    .dr-cue {
      display: none;
    }

    .dm-cinema {
      min-height: auto;
      padding-top: var(--space-5);
      padding-bottom: var(--space-5);
    }

    .dm-orb {
      --size: calc(3.4rem * var(--s, 1));
    }

    .dm-beam {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mote,
    .dm-beam,
    .dm-orb,
    .dm-orb::before,
    .dm-wing,
    .dm-flicker,
    .dm-dot {
      animation: none;
    }
    .mote {
      opacity: 0.12;
    }
  }

  :global(html[data-motion='quiet']) .dm-orb,
  :global(html[data-motion='quiet']) .dm-flicker,
  :global(html[data-motion='still']) .dm-orb,
  :global(html[data-motion='still']) .dm-orb::before,
  :global(html[data-motion='still']) .dm-wing,
  :global(html[data-motion='still']) .dm-flicker,
  :global(html[data-motion='still']) .mote {
    animation: none;
  }
</style>

<script>
  let timer: number | undefined;
  let observer: IntersectionObserver | undefined;

  function initDream() {
    const root = document.querySelector<HTMLElement>('[data-dm]');
    if (!root || root.dataset.dmInit === '1') return;
    root.dataset.dmInit = '1';

    const motion = document.documentElement.dataset.motion;
    const reduced = motion === 'quiet' || motion === 'still' || window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const shots = Array.from(root.querySelectorAll<HTMLElement>('[data-dm-shot]'));
    const subs = Array.from(root.querySelectorAll<HTMLElement>('[data-dm-sub]'));
    const orbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dm-orb]'));
    const screen = root.querySelector<HTMLElement>('[data-dm-screen]')!;
    const count = root.querySelector<HTMLElement>('[data-dm-count]')!;
    const play = root.querySelector<HTMLButtonElement>('[data-dm-play]')!;
    const total = shots.length;
    let current = 0;
    let playing = !reduced;
    let visible = false;
    let flying = false;

    const show = (i: number) => {
      shots.forEach((s, k) => s.classList.toggle('is-on', k === i));
      subs.forEach((s, k) => (s.hidden = k !== i));
      orbs.forEach((o, k) => o.classList.toggle('is-watching', k === i));
      count.textContent = String(i + 1).padStart(2, '0');
      current = i;
    };

    const go = (i: number) => {
      const target = (i + total) % total;
      if (target === current || flying) return;
      const orb = orbs[target];
      const pic = orb.querySelector('img');
      const from = orb.getBoundingClientRect();
      const to = screen.getBoundingClientRect();
      const onScreen = from.bottom > 0 && from.top < innerHeight && to.bottom > 0 && to.top < innerHeight;
      if (reduced || !pic || !onScreen) {
        show(target);
        return;
      }
      // the ghost has the screen's final size from the start and is only
      // ever scaled uniformly; a circular clip makes it look like the orb,
      // then opens up to the full frame as it lands
      flying = true;
      const base = root.getBoundingClientRect();
      const ghost = document.createElement('div');
      ghost.className = 'dm-fly';
      ghost.setAttribute('aria-hidden', 'true');
      ghost.style.cssText = `width:${to.width}px;height:${to.height}px;`;
      const img = document.createElement('img');
      img.src = pic.currentSrc || pic.src;
      img.alt = '';
      ghost.append(img);
      root.append(ghost);
      orb.classList.add('is-watching');
      const s = from.width / to.height;
      const x0 = from.left + from.width / 2 - base.left - to.width / 2;
      const y0 = from.top + from.height / 2 - base.top - to.height / 2;
      const x1 = to.left - base.left;
      const y1 = to.top - base.top;
      const lift = Math.min(140, Math.abs(x1 - x0) * 0.25 + 50);
      const rStart = to.height / 2;
      const rEnd = Math.hypot(to.width, to.height) / 2;
      const anim = ghost.animate(
        [
          { transform: `translate(${x0}px, ${y0}px) scale(${s})`, clipPath: `circle(${rStart}px at 50% 50%)`, opacity: 1 },
          {
            transform: `translate(${(x0 + x1) / 2}px, ${(y0 + y1) / 2 - lift}px) scale(${(s + 1) / 2.6})`,
            clipPath: `circle(${rStart}px at 50% 50%)`,
            opacity: 1,
            offset: 0.5,
          },
          { transform: `translate(${x1}px, ${y1}px) scale(1)`, clipPath: `circle(${rEnd}px at 50% 50%)`, opacity: 0 },
        ],
        { duration: 950, easing: 'cubic-bezier(.45,.05,.3,1)' },
      );
      const land = () => {
        ghost.remove();
        flying = false;
      };
      anim.onfinish = land;
      anim.oncancel = land;
      window.setTimeout(() => show(target), 650);
    };

    const tick = () => {
      window.clearTimeout(timer);
      if (!playing || !visible) return;
      timer = window.setTimeout(() => {
        go(current + 1);
        tick();
      }, 5200);
    };

    const setPlaying = (on: boolean) => {
      playing = on;
      play.setAttribute('aria-pressed', String(on));
      tick();
    };

    if (reduced) play.setAttribute('aria-pressed', 'false');

    orbs.forEach((orb, i) =>
      orb.addEventListener('click', () => {
        setPlaying(false);
        go(i);
      }),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-dm-step]').forEach((b) =>
      b.addEventListener('click', () => {
        setPlaying(false);
        go(current + Number(b.dataset.dmStep));
      }),
    );
    play.addEventListener('click', () => setPlaying(!playing));
    root.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      setPlaying(false);
      go(current + (e.key === 'ArrowRight' ? 1 : -1));
    });
    screen.addEventListener('click', () => setPlaying(false));

    observer = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        tick();
      },
      { threshold: 0.45 },
    );
    observer.observe(screen);
  }

  document.addEventListener('astro:page-load', initDream);
  document.addEventListener('astro:before-swap', () => {
    window.clearTimeout(timer);
    observer?.disconnect();
    observer = undefined;
  });
</script>
