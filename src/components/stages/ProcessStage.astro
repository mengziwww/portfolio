---
// A graduate film shown through its own process: instead of a polished
// gallery it reads like a production board, sketches pinned up in the
// order they were made, warm and sunlit (a road-trip film, a field of
// sunflowers in its own key art), building up through real reels of the
// footage. Once the film is out, the finished film itself comes first.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getProjectImage, responsiveWidths } from '@/lib/images';
import ProjectFooter from './ProjectFooter.astro';
import ScrollCue from '@/components/ScrollCue.astro';
import I18nText from '@/components/I18nText.astro';
import { trAll } from '@/i18n/ui';
import { vividOf } from '@/lib/color';
import { charReveal } from '@/lib/reveal-text';
import VideoPlayer from '@/components/VideoPlayer.astro';
import ProjectIntro from '@/components/ProjectIntro.astro';
interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}
const { project, next } = Astro.props;
const { title, subtitle, description, story, year, roles, category, client, cover, coverAlt, gallery, accentFrom, accentTo, videos, links, release } = project.data;
const releaseDate = release?.date.split('-').reverse().join('.');
const youtubeUrl = release && `https://www.youtube.com/watch?v=${release.youtube}`;
const glow = vividOf(accentFrom, accentTo);
const coverImg = getProjectImage(project.id, cover);
const categoryLabel = trAll(`category.${category}` as const);
const clientLabel = trAll('project.client');

type Item = (typeof gallery)[number];
type Chapter = { label: Item['chapter']; items: Item[] };

const chapters: Chapter[] = [];
for (const item of gallery) {
  const last = chapters[chapters.length - 1];
  if (last && last.label?.en === item.chapter?.en) {
    last.items.push(item);
  } else {
    chapters.push({ label: item.chapter, items: [item] });
  }
}

// pinned-up, slightly-off, hand-placed — never a perfect grid, because
// none of this is a finished, deliberately-composed board yet
function pinSeed(seed: number) {
  return {
    rot: ((seed * 37) % 9) - 4.5,
    pin: ['pin-a', 'pin-b', 'pin-c'][seed % 3],
  };
}

const pollen = Array.from({ length: 26 }, (_, i) => ({
  left: `${(i * 41 + 5) % 100}%`,
  delay: `${(i % 10) * 1.3}s`,
  dur: `${13 + (i % 7) * 2}s`,
  size: 2 + (i % 3),
}));
---

<article class="process" style={`--mood-a:${accentFrom}; --mood-b:${accentTo}; --mood-glow:${glow};`} data-process data-reveal-root>
  <div class="pr-pollen" aria-hidden="true">
    {pollen.map((p) => (
      <span class="pollen-mote" style={`left:${p.left}; animation-delay:${p.delay}; animation-duration:${p.dur}; width:${p.size}px; height:${p.size}px;`}></span>
    ))}
  </div>

  <header class="pr-hero">
    <span class="pr-sun" aria-hidden="true"></span>
    <span class="pr-hero-scrim" aria-hidden="true"></span>
    <Image
      class="pr-hero-bg"
      src={coverImg}
      alt=""
      aria-hidden="true"
      widths={responsiveWidths(coverImg, [900, 1400, 2000])}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      transition:name={`project-cover-${project.id}`}
    />
    <div class="pr-hero-copy">
      {release && (
        <p class="pr-release">
          <span><I18nText en="out now" fr="c'est sorti" zh="正式上线" /></span>
          <time class="pr-release-date" datetime={release.date}>{releaseDate}</time>
        </p>
      )}
      <p class="hero-eyebrow eyebrow">
        <I18nText {...categoryLabel} /> · {year}{client ? (
          <>
            {' · '}<I18nText {...clientLabel} /> {client}
          </>
        ) : null}
      </p>
      <div class="pr-sign">
        <h1 class="pr-hero-title" transition:name={`project-title-${project.id}`} set:html={charReveal(title, 120, 22)} />
        <svg class="pr-sign-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10h12V5l7 7-7 7v-5H3z" fill="currentColor" /></svg>
      </div>
      <p class="pr-hero-subtitle">
        <I18nText en={subtitle.en} fr={subtitle.fr} zh={subtitle.zh} />
      </p>
      {story && (
        <p class="pr-hero-story">
          <I18nText en={story.en} fr={story.fr} zh={story.zh} />
        </p>
      )}
      <p class="pr-hero-desc">
        {story && (
          <span class="pr-hero-desc-label"><I18nText en="my part" fr="mon rôle" zh="我的工作" /></span>
        )}
        <I18nText en={description.en} fr={description.fr} zh={description.zh} />
      </p>
      {youtubeUrl && (
        <a class="pr-cta" href={youtubeUrl} target="_blank" rel="noopener noreferrer" data-cursor-hover>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
          <I18nText en="watch the film on YouTube" fr="voir le film sur YouTube" zh="在 YouTube 上看成片" />
        </a>
      )}
      <ProjectIntro links={links} />
      <ul class="hero-roles">
        {roles.en.map((_, i) => (
          <li style={`--i:${i}`}>
            <I18nText en={roles.en[i]} fr={roles.fr[i]} zh={roles.zh[i]} />
          </li>
        ))}
      </ul>
    </div>
    <figure class="pr-hero-credit">
      <figcaption><I18nText en={coverAlt.en} fr={coverAlt.fr} zh={coverAlt.zh} /></figcaption>
    </figure>
    <div class="pr-hero-cue">
      <ScrollCue />
    </div>
  </header>

  {release && (
    <section class="pr-film">
      <h2 class="pr-chapter-title">
        <I18nText en="the film" fr="le film" zh="成片" />
      </h2>
      <div class="pr-film-frame" data-yt-embed={release.youtube} data-yt-title={title}>
        <button type="button" class="pr-film-play" data-yt-play data-cursor-hover>
          <Image
            src={coverImg}
            alt=""
            widths={responsiveWidths(coverImg, [900, 1400, 2000])}
            sizes="(max-width: 1000px) 92vw, 62rem"
            loading="lazy"
          />
          <span class="pr-film-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
          </span>
          <span class="pr-film-label">
            <I18nText en="play the film" fr="lancer le film" zh="播放成片" />
          </span>
        </button>
      </div>
    </section>
  )}

  {chapters.map((chapter, ci) => (
    <section class="pr-chapter" style={`--chapter-tint:${ci % 2 === 0 ? accentFrom : accentTo};`}>
      {chapter.label && (
        <h2 class="pr-chapter-title">
          <span class="pr-chapter-index">{String(ci + 1).padStart(2, '0')}</span>
          <I18nText en={chapter.label.en} fr={chapter.label.fr} zh={chapter.label.zh} />
        </h2>
      )}
      <div class="pr-board">
        {chapter.items.map((item, ii) => {
          const seed = pinSeed(ci * 7 + ii * 3 + 2);
          return (
            <figure class={`pr-card ${seed.pin}`} style={`--rot:${seed.rot}deg;`} data-artwork data-note-id={`${project.id}:${item.file}`}>
              <span class="pr-card-frame">
                <Image
                  src={getProjectImage(project.id, item.file)}
                  alt={item.alt.en}
                  widths={responsiveWidths(getProjectImage(project.id, item.file), [420, 640, 960])}
                  sizes="(max-width: 800px) 88vw, 26vw"
                  loading="lazy"
                />
              </span>
              <figcaption>
                <I18nText en={item.alt.en} fr={item.alt.fr} zh={item.alt.zh} />
              </figcaption>
            </figure>
          );
        })}
      </div>
    </section>
  ))}

  {videos && videos.length > 0 && (
    <section class="pr-reels">
      <h2 class="pr-chapter-title">
        <span class="pr-chapter-index">{String(chapters.length + 1).padStart(2, '0')}</span>
        <I18nText en="in motion" fr="en mouvement" zh="动起来的画面" />
      </h2>
      {videos.map((v, vi) => (
        <div class="pr-reel">
          <p class="pr-reel-label eyebrow">
            <span class="pr-reel-num">{String(vi + 1).padStart(2, '0')}</span>
            <I18nText en={v.label.en} fr={v.label.fr} zh={v.label.zh} />
          </p>
          <VideoPlayer src={`/videos/${project.id}/${v.file}`} skin="road" />
        </div>
      ))}
    </section>
  )}

  <div class="pr-trip" data-pr-trip aria-hidden="true">
    <span class="pr-trip-road"></span>
    <span class="pr-trip-end"><I18nText en="the fields" fr="les champs" zh="田野" /></span>
    <svg class="pr-trip-scooter" viewBox="0 0 48 30">
      <circle cx="10" cy="24" r="5" fill="#1b2a33" stroke="#f6efe2" stroke-width="1.6" />
      <circle cx="38" cy="24" r="5" fill="#1b2a33" stroke="#f6efe2" stroke-width="1.6" />
      <path d="M8 22 L30 22 L36 12 L40 12" fill="none" stroke="#e07b39" stroke-width="3.2" stroke-linejoin="round" stroke-linecap="round" />
      <path d="M14 21 Q14 15 22 15 L29 15 L27 21Z" fill="#e07b39" />
      <circle cx="20" cy="5" r="3.2" fill="#f2c14e" />
      <path d="M18 8 L22 15 L28 15" fill="none" stroke="#f6efe2" stroke-width="3" stroke-linecap="round" />
      <circle cx="13" cy="7" r="3" fill="#3a2a1e" />
      <path d="M12 10 L16 16" stroke="#9cc3d5" stroke-width="3" stroke-linecap="round" />
      <circle cx="41" cy="13" r="1.6" fill="#fff6c8" />
    </svg>
  </div>

  <ProjectFooter project={project} next={next} />
</article>

<script>
  let onTrip: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    const trip = document.querySelector<HTMLElement>('[data-pr-trip]');
    if (onTrip) window.removeEventListener('scroll', onTrip);
    onTrip = undefined;
    if (!trip) return;
    let frame = 0;
    const paint = () => {
      frame = 0;
      const max = document.documentElement.scrollHeight - innerHeight;
      const p = max > 0 ? Math.min(1, scrollY / max) : 0;
      trip.style.setProperty('--trip', p.toFixed(4));
      trip.classList.toggle('is-on', scrollY > innerHeight * 0.6);
    };
    onTrip = () => {
      if (!frame) frame = requestAnimationFrame(paint);
    };
    paint();
    window.addEventListener('scroll', onTrip, { passive: true });
  });

  // YouTube is only contacted once the visitor asks for the film.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-yt-embed]').forEach((frame) => {
      frame.querySelector('[data-yt-play]')?.addEventListener(
        'click',
        () => {
          const iframe = document.createElement('iframe');
          iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.ytEmbed}?autoplay=1&rel=0`;
          iframe.title = frame.dataset.ytTitle ?? '';
          iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
          iframe.allowFullscreen = true;
          frame.replaceChildren(iframe);
        },
        { once: true }
      );
    });
  });
</script>

<style>
  /* the film's own evening: a dusk sky going down into the warm dark of
     the field, sunflower yellow for the accents */
  .process {
    --sunflower: #f2c14e;
    --dusk: #1b2a33;
    position: relative;
    background:
      radial-gradient(ellipse 60% 30% at 80% 8%, rgb(242 160 80 / 14%), transparent 70%),
      radial-gradient(ellipse 70% 40% at 15% 60%, rgb(242 193 78 / 6%), transparent 70%),
      linear-gradient(180deg, var(--dusk) 0%, #1d2226 35%, #1f1a14 70%, #1a130d 100%);
    overflow: hidden;
  }

  .pr-pollen {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .pollen-mote {
    position: absolute;
    top: -2%;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 5px 1px color-mix(in srgb, var(--gold) 70%, transparent);
    opacity: 0;
    animation: pollen-drift linear infinite;
  }

  @keyframes pollen-drift {
    0% { transform: translate(0, 0); opacity: 0; }
    10% { opacity: 0.7; }
    90% { opacity: 0.4; }
    100% { transform: translate(2.5rem, 108svh); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pollen-mote { animation: none; opacity: 0; }
  }

  /* ---- hero: the sunflower field itself as the backdrop, not a small
     card off to the side — the one image on the whole site that earns
     full-bleed treatment ---- */
  .pr-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-6) var(--edge) var(--space-6);
  }

  .pr-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
    filter: saturate(1.15) brightness(0.95);
  }

  /* dark only where the words are (bottom-left), so the field keeps its
     colors everywhere else */
  .pr-hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(0deg, var(--dusk) 0%, color-mix(in srgb, var(--dusk) 55%, transparent) 22%, transparent 48%),
      linear-gradient(90deg, rgb(12 14 16 / 84%) 0%, rgb(12 14 16 / 66%) 30%, rgb(12 14 16 / 20%) 50%, transparent 62%);
  }

  .pr-hero-copy {
    position: relative;
    z-index: 2;
    max-width: 38rem;
  }

  .hero-eyebrow {
    color: var(--gold);
    margin-bottom: var(--space-2);
  }

  /* the title is a French direction sign pointing to the fields */
  .pr-sign {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin: 0.2rem 0 0.2rem -0.2rem;
    padding: 0.32em 0.6em 0.36em 0.55em;
    font-size: calc(var(--text-2xl) * 0.72);
    color: #141414;
    background: #f8f6ee;
    border-radius: 0.18em;
    box-shadow: inset 0 0 0 0.09em #f8f6ee, inset 0 0 0 0.14em #141414, 0 0.8rem 2rem -0.6rem rgb(0 0 0 / 60%);
    rotate: -1.2deg;
  }

  .pr-hero-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1em;
    line-height: 1;
    letter-spacing: -0.01em;
    color: inherit;
  }

  .pr-sign-arrow {
    flex: none;
    width: 0.9em;
    height: 0.9em;
  }

  .pr-sun {
    position: absolute;
    right: 8%;
    top: 10%;
    z-index: 1;
    width: clamp(12rem, 30vw, 28rem);
    aspect-ratio: 1;
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(circle, rgb(255 226 150 / 55%), rgb(255 170 80 / 18%) 40%, transparent 70%);
    mix-blend-mode: screen;
    animation: pr-sun 9s ease-in-out infinite;
  }

  @keyframes pr-sun {
    50% { scale: 1.08; opacity: 0.8; }
  }

  /* a scooter rides to the fields as the page scrolls */
  .pr-trip {
    position: fixed;
    left: 50%;
    bottom: 0.9rem;
    z-index: 30;
    width: min(26rem, 70vw);
    height: 2.2rem;
    translate: -50% 0;
    padding-right: 5.5rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s;
  }

  .pr-trip.is-on {
    opacity: 1;
  }

  .pr-trip-road {
    position: absolute;
    left: 0;
    right: 5.5rem;
    bottom: 0.35rem;
    height: 5px;
    border-radius: 3px;
    background: repeating-linear-gradient(90deg, rgb(246 239 226 / 70%) 0 6px, transparent 6px 14px) center / 100% 1px no-repeat, rgb(27 42 51 / 88%);
    box-shadow: 0 0 0 1px rgb(246 239 226 / 15%);
  }

  .pr-trip-end {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 0.2em 0.55em;
    font-family: var(--font-sans);
    font-size: var(--text-2xs);
    font-weight: 700;
    color: #141414;
    background: #f8f6ee;
    border-radius: 3px;
    box-shadow: inset 0 0 0 2px #f8f6ee, inset 0 0 0 3px #141414;
  }

  .pr-trip-scooter {
    position: absolute;
    bottom: 0.25rem;
    left: calc(var(--trip, 0) * (100% - 5.5rem - 2.6rem));
    width: 2.6rem;
    height: 1.7rem;
    filter: drop-shadow(0 2px 2px rgb(0 0 0 / 50%));
    animation: pr-bump 0.45s ease-in-out infinite;
  }

  @keyframes pr-bump {
    50% { transform: translateY(-1px) rotate(-1.5deg); }
  }

  @media (max-width: 700px) {
    .pr-sign {
      font-size: calc(var(--text-2xl) * 0.62);
    }
    .pr-trip {
      bottom: 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pr-sun,
    .pr-trip-scooter {
      animation: none;
    }
  }

  .pr-hero-subtitle {
    font-size: var(--text-lg);
    color: var(--bone-soft);
    margin-top: var(--space-2);
  }

  .pr-release {
    display: inline-flex;
    align-items: center;
    gap: 0.8em;
    margin-bottom: var(--space-4);
    padding: 0.6em 1.2em;
    font-family: var(--font-mono);
    font-size: var(--text-base);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--void);
    background: var(--gold);
    border-radius: 2px;
    transform: rotate(-3deg);
    transform-origin: left center;
    animation: release-pulse 2.6s ease-out infinite;
  }

  :lang(zh) .pr-release {
    text-transform: none;
    letter-spacing: 0.06em;
  }

  .pr-release-date {
    font-weight: 700;
    padding-left: 0.8em;
    border-left: 1px solid rgb(0 0 0 / 30%);
  }

  @keyframes release-pulse {
    0% {
      box-shadow: 0 0.6rem 1.4rem -0.5rem rgb(0 0 0 / 55%), 0 0 0 0 color-mix(in srgb, var(--gold) 55%, transparent);
    }
    70%,
    100% {
      box-shadow: 0 0.6rem 1.4rem -0.5rem rgb(0 0 0 / 55%), 0 0 0 1rem transparent;
    }
  }

  .pr-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    margin-top: var(--space-4);
    padding: 0.85em 1.5em;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--void);
    background: var(--bone);
    border-radius: 999px;
    box-shadow: 0 0.8rem 1.6rem -0.6rem rgb(0 0 0 / 60%);
    transition: background 0.3s, transform 0.3s var(--ease-out-expo);
  }

  :lang(zh) .pr-cta {
    text-transform: none;
  }

  .pr-cta svg {
    width: 1.1em;
    height: 1.1em;
  }

  .pr-cta:hover,
  .pr-cta:focus-visible {
    background: var(--gold);
    transform: translateY(-2px);
  }

  .pr-hero-story {
    max-width: 40ch;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: 1.35;
    color: var(--bone);
    text-shadow: 0 1px 12px rgb(0 0 0 / 70%);
  }

  .pr-hero-desc-label {
    display: block;
    margin-bottom: 0.3em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sunflower);
  }

  .pr-hero-desc {
    font-size: var(--text-base);
    color: color-mix(in srgb, var(--bone) 92%, transparent);
    max-width: 54ch;
    margin-top: var(--space-3);
    line-height: 1.65;
    text-shadow: 0 1px 12px rgb(0 0 0 / 70%);
  }

  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    list-style: none;
    margin-top: var(--space-4);
    padding: 0;
  }

  .hero-roles li {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    border: 1px solid rgb(255 255 255 / 25%);
    background: rgb(0 0 0 / 20%);
    backdrop-filter: blur(3px);
    padding: 0.4em 0.85em;
    border-radius: 999px;
    color: var(--bone);
  }

  .pr-hero-credit {
    position: absolute;
    right: var(--edge);
    bottom: var(--space-3);
    z-index: 2;
    max-width: 22rem;
    text-align: right;
  }

  .pr-hero-credit figcaption {
    font-size: var(--text-2xs);
    line-height: 1.4;
    color: rgb(255 255 255 / 55%);
  }

  .pr-hero-cue {
    position: absolute;
    left: var(--edge);
    bottom: var(--space-3);
    z-index: 2;
  }

  @media (max-width: 700px) {
    .pr-hero-credit { display: none; }
  }

  .pr-film {
    position: relative;
    z-index: 1;
    padding: var(--space-5) var(--edge) var(--space-6);
    border-top: 1px solid var(--void-line);
  }

  .pr-film .pr-chapter-title {
    max-width: 62rem;
    margin-inline: auto;
  }

  .pr-film-frame {
    position: relative;
    max-width: 62rem;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 3px;
    background: #000;
    box-shadow: 0 2rem 4rem -1.5rem rgb(0 0 0 / 75%), 0 0 0 1px color-mix(in srgb, var(--gold) 35%, transparent);
  }

  .pr-film-frame :global(iframe),
  .pr-film-play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .pr-film-play {
    padding: 0;
    background: none;
    cursor: pointer;
    color: var(--void);
  }

  .pr-film-play :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.7);
    transition: filter 0.5s, transform 1.2s var(--ease-out-expo);
  }

  .pr-film-play:hover :global(img),
  .pr-film-play:focus-visible :global(img) {
    filter: brightness(0.85);
    transform: scale(1.02);
  }

  .pr-film-icon {
    position: absolute;
    top: 50%;
    left: 50%;
