---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getProjectImage, responsiveWidths } from '@/lib/images';
import I18nText from '@/components/I18nText.astro';
import { trAll } from '@/i18n/ui';
import { charReveal } from '@/lib/reveal-text';
import ScrollCue from '@/components/ScrollCue.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, subtitle, year, roles, client, cover, coverAlt, category, accentFrom } = project.data;
const img = getProjectImage(project.id, cover);
const categoryLabel = trAll(`category.${category}` as const);
const clientLabel = trAll(category === 'commission' ? 'project.client' : 'project.at');
---

<header class="hero" style={`--room-mood:${accentFrom};`} data-hero data-reveal-root>
  <div class="hero-media" data-hero-media>
    <Image
      src={img}
      alt={coverAlt.en}
      widths={responsiveWidths(img, [640, 1024, 1600, 2200])}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      transition:name={`project-cover-${project.id}`}
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-vignette" aria-hidden="true"></div>
  </div>
  <div class="hero-copy" data-hero-copy>
    <p class="hero-eyebrow eyebrow">
      <I18nText {...categoryLabel} /> · {year}{client ? (
        <>
          {' · '}<I18nText {...clientLabel} /> {client}
        </>
      ) : null}
    </p>
    <h1 class="hero-title" transition:name={`project-title-${project.id}`} set:html={charReveal(title, 120, 22)} />
    <p class="hero-subtitle">
      <I18nText en={subtitle.en} fr={subtitle.fr} zh={subtitle.zh} />
    </p>
    <ul class="hero-roles">
      {roles.en.map((_, i) => (
        <li style={`--i:${i}`}>
          <I18nText en={roles.en[i]} fr={roles.fr[i]} zh={roles.zh[i]} />
        </li>
      ))}
    </ul>
  </div>
  <div class="hero-scroll-cue">
    <ScrollCue />
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    color: var(--bone);
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: -6%;
  }

  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
    filter: saturate(0.82) brightness(0.86);
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      color-mix(in srgb, var(--void) 92%, black) 0%,
      transparent 60%
    ), linear-gradient(180deg, rgb(0 0 0 / 45%) 0%, transparent 30%);
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 14rem 2rem rgb(0 0 0 / 55%);
    background: radial-gradient(ellipse at 50% 45%, color-mix(in srgb, var(--room-mood) 16%, transparent), transparent 65%);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    padding: var(--space-4) var(--edge) var(--space-5);
    max-width: 54rem;
  }

  .hero-eyebrow {
    color: var(--gold);
    margin-bottom: var(--space-2);
    opacity: 0;
    animation: hero-fade 0.8s var(--ease-out-expo) 0.1s forwards;
  }

  .hero-title {
    font-size: var(--text-3xl);
    line-height: 0.96;
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--bone-soft);
    margin-top: var(--space-2);
    max-width: 40ch;
    opacity: 0;
    animation: hero-fade 0.9s var(--ease-out-expo) 0.6s forwards;
  }

  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    list-style: none;
    margin-top: var(--space-3);
    padding: 0;
  }

  .hero-roles li {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    border: 1px solid var(--void-line);
    padding: 0.4em 0.85em;
    border-radius: 999px;
    opacity: 0;
    transform: translateY(0.5rem);
    animation: hero-pill-in 0.7s var(--ease-out-expo) forwards;
    animation-delay: calc(0.8s + var(--i) * 70ms);
  }

  @keyframes hero-fade {
    from { opacity: 0; transform: translateY(0.6rem); }
    to { opacity: 1; transform: none; }
  }

  @keyframes hero-pill-in {
    to { opacity: 1; transform: none; }
  }

  .hero-scroll-cue {
    position: absolute;
    right: var(--edge);
    bottom: var(--space-3);
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow, .hero-subtitle, .hero-roles li { animation: none; opacity: 1; transform: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  function initHeroParallax() {
    gsap.registerPlugin(ScrollTrigger);
    document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
      if (hero.dataset.heroInit === '1') return;
      hero.dataset.heroInit = '1';
      const media = hero.querySelector<HTMLElement>('[data-hero-media]');
      if (!media || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      gsap.to(media, {
        yPercent: 12,
        ease: 'none',
        scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 0.6 },
      });
    });
  }

  document.addEventListener('astro:page-load', () => {
    initHeroParallax();
    requestAnimationFrame(() => ScrollTrigger.refresh());
  });
</script>
