---
// The world's images live in one small viewer window with void space
// around it, each one crossfading into the next with its line of story
// underneath. It is turned by hand (arrows, dots, keys, swipe) or played
// as a slideshow, so the page stays one screen long instead of a long
// scroll track.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getProjectImage, responsiveWidths } from '@/lib/images';
import ProjectFooter from './ProjectFooter.astro';
import ScrollCue from '@/components/ScrollCue.astro';
import I18nText from '@/components/I18nText.astro';
import { trAll } from '@/i18n/ui';
import { vividOf } from '@/lib/color';
import { charReveal } from '@/lib/reveal-text';
import ProjectIntro from '@/components/ProjectIntro.astro';
import MangaBook from '@/components/MangaBook.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}
const { project, next } = Astro.props;
const { title, subtitle, year, roles, category, cover, coverAlt, gallery, description, story, accentFrom, accentTo, links } = project.data;
const told = story ?? description;
const glow = vividOf(accentFrom, accentTo);
const coverImg = getProjectImage(project.id, cover);
const categoryLabel = trAll(`category.${category}` as const);

function splitFragments(text: string, zh = false): string[] {
  const raw = zh ? text.split(/(?<=[。！？])/) : text.split(/(?<=[.!?])\s+/);
  return raw.map((s) => s.trim()).filter(Boolean);
}
const fragEn = splitFragments(told.en);
const fragFr = splitFragments(told.fr);
const fragZh = splitFragments(told.zh, true);
const fragCount = Math.max(fragEn.length, fragFr.length, fragZh.length);
const fragments = Array.from({ length: fragCount }, (_, i) => ({
  en: fragEn[i] ?? '',
  fr: fragFr[i] ?? '',
  zh: fragZh[i] ?? '',
}));

const stills = gallery.filter((g) => !g.file.endsWith('.gif'));
const keepsake = gallery.find((g) => g.file.endsWith('.gif'));
const studyFiles = new Set(['extra-21.png', 'extra-22.jpg', 'extra-23.png']);
const studyItems = stills.filter((item) => studyFiles.has(item.file));
const mangaItems = stills
  .filter((item) => item.file.startsWith('board-'))
  .sort((a, b) => a.file.localeCompare(b.file, undefined, { numeric: true }));
const trackItems = stills.filter((item) => !studyFiles.has(item.file) && !item.file.startsWith('board-'));

// the text before the manga: its first sentence is set apart as a lead
const prologueText = {
  en: "This manga is the story as it first was. A girl decides to end her life. Her parents are long gone, and she is the last one left of her tribe. Just then, a red-skinned girl appears in front of her and says: you are the last human in the world, and you have one task, to come with me and watch the new world being born. On the way they talk about the seven days in which the gods made the world. Sadly, it took humans only seven days to destroy it. So after nightfall the gods will make the world again, and the girl will be its witness. Her body keeps decaying. Until she fades, they stay in the grass looking at the stars, thinking about the future of the new world. She is grateful to the messenger for not letting her die alone. In the end, what the new world becomes doesn't matter, because I will always love this world. Under the stars, the girl promises the bones that they will meet again.",
  fr: "Ce manga, c'est l'histoire telle qu'elle était au tout début. Une fille décide de mettre fin à ses jours. Ses parents sont partis depuis longtemps, et elle est la dernière de sa tribu. C'est alors qu'une fille à la peau rouge apparaît devant elle et lui dit : tu es la dernière humaine au monde, et tu as une mission, venir avec moi voir naître le nouveau monde. En chemin, elles parlent des sept jours pendant lesquels les dieux ont créé le monde. Dommage, il n'a fallu que sept jours aux humains pour le détruire. Alors, à la tombée de la nuit, les dieux vont recréer le monde, et la fille en sera le témoin. Son corps se décompose peu à peu. Jusqu'à ce qu'elle s'efface, elles restent dans l'herbe à regarder les étoiles, à penser à l'avenir du nouveau monde. La fille remercie la messagère de ne pas l'avoir laissée mourir seule. Au fond, peu importe ce que deviendra le nouveau monde, parce que j'aimerai toujours ce monde. Sous les étoiles, la fille promet aux ossements qu'ils se reverront.",
  zh: "这个漫画是故事最初的模样。一个女孩决定自杀，她的父母早已离去，部落的人只剩下她一个了。但正在这时候，一个红皮肤女孩出现在她的面前，她说：你是世界上最后一个人类了，你有一个任务，那就是跟我去看看新世界的诞生。路上他们讨论了神创世界的七日谈，很可惜，人类毁灭世界也只用了七天。于是天黑之后，神将重新创造这个世界，而自杀的女孩就是见证人。女孩的身体不断腐烂，他们在女孩临消散前一直在草地上看星空，一直在想新世界的未来。女孩很感谢使者让她的死亡不再孤独。其实，新世界会变成什么样并不重要，因为我会一直爱这个世界。在星空下，女孩对着尸骨许诺下一次的再见。",
};
function splitLead(text: string, zh = false) {
  const [lead, ...rest] = splitFragments(text, zh);
  return { lead, rest: rest.join(zh ? '' : ' ') };
}
const prologue = {
  en: splitLead(prologueText.en),
  fr: splitLead(prologueText.fr),
  zh: splitLead(prologueText.zh, true),
};

const slides = trackItems.map((item, i) => {
  const img = getProjectImage(project.id, item.file);
  return {
    item,
    portrait: img.height > img.width,
    frag: (item.caption ?? (i < fragments.length ? fragments[i] : null)) as (typeof fragments)[number] | null,
  };
});
---

<article class="atmosphere" style={`--mood-a:${accentFrom}; --mood-b:${accentTo}; --mood-glow:${glow};`} data-atmosphere data-reveal-root>
  <header class="am-hero">
    <div class="am-cover">
      <Image
        src={coverImg}
        alt={coverAlt.en}
        widths={responsiveWidths(coverImg, [420, 640, 900])}
        sizes="(max-width: 700px) 78vw, 24rem"
        loading="eager"
        fetchpriority="high"
        transition:name={`project-cover-${project.id}`}
      />
    </div>
    <div class="am-copy">
      <p class="hero-eyebrow eyebrow">
        <I18nText {...categoryLabel} /> · {year}
      </p>
      <h1 class="am-title" transition:name={`project-title-${project.id}`} set:html={charReveal(title, 120, 22)} />
      <p class="am-subtitle">
        <I18nText en={subtitle.en} fr={subtitle.fr} zh={subtitle.zh} />
      </p>
      <ProjectIntro description={story ? description : undefined} links={links} />
      <ul class="hero-roles">
        {roles.en.map((_, i) => (
          <li style={`--i:${i}`}>
            <I18nText en={roles.en[i]} fr={roles.fr[i]} zh={roles.zh[i]} />
          </li>
        ))}
      </ul>
    </div>
    <div class="am-cue">
      <ScrollCue />
    </div>
  </header>

  <div class="nebula" aria-hidden="true">
    <span class="nebula-blob nebula-a"></span>
    <span class="nebula-blob nebula-b"></span>
    <span class="nebula-blob nebula-c"></span>
  </div>
  <canvas class="drift" data-atmo-canvas aria-hidden="true"></canvas>

  <section class="eotw-viewer" data-eotw-viewer aria-roledescription="carousel">
    <div class="eotw-frame" data-order-group="world" data-lb-group>
      {slides.map((s, i) => (
        <figure class:list={['eotw-slide', { 'is-portrait': s.portrait }]} data-slide data-index={i} data-artwork data-note-id={`${project.id}:${s.item.file}`}>
          <span class="eotw-pic">
            <Image
              src={getProjectImage(project.id, s.item.file)}
              alt={s.item.alt.en}
              widths={responsiveWidths(getProjectImage(project.id, s.item.file), [640, 960, 1280])}
              sizes="(max-width: 900px) 84vw, 56rem"
              loading={i < 1 ? 'eager' : 'lazy'}
            />
          </span>
          {s.frag && (
            <figcaption class="eotw-line">
              <I18nText en={s.frag.en} fr={s.frag.fr} zh={s.frag.zh} />
            </figcaption>
          )}
        </figure>
      ))}
      <span class="eotw-frame-border" aria-hidden="true"></span>
    </div>
    <div class="eotw-nav">
      <button type="button" class="eotw-step" data-eotw-step="-1" aria-label="Previous">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
      </button>
      <div class="eotw-dots" data-eotw-dots>
        {slides.map((_, i) => (
          <button type="button" class="eotw-tick" data-tick data-index={i} aria-label={String(i + 1)}></button>
        ))}
      </div>
      <span class="eotw-count"><span data-eotw-count>01</span> / {String(slides.length).padStart(2, '0')}</span>
      <button type="button" class="eotw-play" data-eotw-play aria-pressed="false">
        <span class="eotw-play-off"><I18nText en="play the story" fr="lire l'histoire" zh="播放故事" /></span>
        <span class="eotw-play-on"><I18nText en="pause" fr="pause" zh="暂停" /></span>
      </button>
      <button type="button" class="eotw-step" data-eotw-step="1" aria-label="Next">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
      </button>
    </div>
  </section>

  {studyItems.length > 0 && (
    <section class="eotw-studies">
      <h2>
        <I18nText en="studies" fr="études" zh="角色设定" />
      </h2>
      <div class="eotw-studies-row" data-order-group="studies">
        {studyItems.map((item) => (
          <figure data-artwork data-note-id={`${project.id}:${item.file}`}>
            <span class="eotw-study-pic">
              <Image
                src={getProjectImage(project.id, item.file)}
                alt={item.alt.en}
                widths={responsiveWidths(getProjectImage(project.id, item.file), [360, 560, 900])}
                sizes="(max-width: 700px) 80vw, 22rem"
                loading="lazy"
              />
            </span>
            {item.caption && <figcaption><I18nText {...item.caption} /></figcaption>}
          </figure>
        ))}
      </div>
    </section>
  )}

  {mangaItems.length > 0 && (
    <section class="manga" data-manga>
      <h2>
        <I18nText en="manga" fr="manga" zh="漫画" />
      </h2>
      <div class="manga-prologue">
        <p class="manga-lead">
          <I18nText en={prologue.en.lead} fr={prologue.fr.lead} zh={prologue.zh.lead} />
        </p>
        <p class="manga-intro">
          <I18nText en={prologue.en.rest} fr={prologue.fr.rest} zh={prologue.zh.rest} />
        </p>
      </div>
      <MangaBook projectId={project.id} items={mangaItems} />
    </section>
  )}

  {keepsake && (
    <figure class="keepsake" data-artwork data-note-id={`${project.id}:${keepsake.file}`}>
      <img
        src={getProjectImage(project.id, keepsake.file).src}
        alt={keepsake.alt.en}
        width="360"
        height="360"
        loading="lazy"
        draggable="false"
      />
    </figure>
  )}

  <ProjectFooter project={project} next={next} />
</article>

<style>
  .atmosphere {
    position: relative;
    background:
      radial-gradient(ellipse 60% 40% at 15% 10%, color-mix(in srgb, var(--mood-a) 30%, transparent), transparent 70%),
      radial-gradient(ellipse 55% 45% at 88% 70%, color-mix(in srgb, var(--mood-b) 22%, transparent), transparent 72%),
      radial-gradient(ellipse 80% 60% at 50% 100%, color-mix(in srgb, var(--mood-a) 18%, transparent), transparent 75%),
      color-mix(in srgb, var(--mood-a) 55%, black 45%);
    color: var(--bone);
    overflow: hidden;
  }

  /* soft drifting nebula clouds — the starfield alone read as an empty
     void; these give the sky real depth without adding more content */
  .nebula {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .nebula-blob {
    position: absolute;
    width: 70vmax;
    height: 70vmax;
    border-radius: 50%;
    opacity: 0.22;
    animation: nebula-drift 60s ease-in-out infinite;
  }

  .nebula-a {
    top: -20%;
    left: -15%;
    background: radial-gradient(circle, var(--mood-a), transparent 70%);
    animation-duration: 70s;
  }

  .nebula-b {
    bottom: -25%;
    right: -10%;
    background: radial-gradient(circle, var(--mood-b), transparent 70%);
    animation-duration: 85s;
    animation-delay: -20s;
  }

  .nebula-c {
    top: 30%;
    left: 40%;
    width: 45vmax;
    height: 45vmax;
    background: radial-gradient(circle, var(--mood-glow), transparent 70%);
    animation-duration: 55s;
    animation-delay: -40s;
    opacity: 0.18;
  }

  @keyframes nebula-drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(6vw, -4vh) scale(1.15); }
  }

  @media (prefers-reduced-motion: reduce) {
    .nebula-blob {
      animation: none;
    }
  }

  .am-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding: var(--space-6) var(--edge) var(--space-5);
    z-index: 2;
  }

  .am-cover {
    flex: none;
    width: clamp(11rem, 22vw, 24rem);
    overflow: hidden;
    border-radius: 2px;
    box-shadow: 0 2rem 5rem -1.5rem rgb(0 0 0 / 70%), 0 0 4rem 0.4rem color-mix(in srgb, var(--mood-glow) 25%, transparent);
  }

  .am-cover :global(img) {
    width: 100%;
    display: block;
  }

  .am-copy {
    flex: 1 1 24rem;
    max-width: 32rem;
  }

  .hero-eyebrow {
    color: var(--gold);
    margin-bottom: var(--space-2);
  }

  .am-title {
    font-size: var(--text-2xl);
    line-height: 0.96;
  }

  .am-subtitle {
    font-size: var(--text-lg);
    color: var(--bone-soft);
    margin-top: var(--space-2);
  }

  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    list-style: none;
    margin-top: var(--space-3);
    padding: 0;
  }

  .hero-roles li {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    border: 1px solid var(--void-line);
    padding: 0.4em 0.85em;
    border-radius: 999px;
  }

  .am-cue {
    position: absolute;
    left: var(--edge);
    bottom: var(--space-3);
  }

  .drift {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  /* ---- the fixed viewer: one small, clearly bounded window that every
     gallery image dissolves through in turn, instead of each image
     taking a full sticky panel of its own ---- */
  .eotw-viewer {
    position: relative;
    z-index: 2;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 4.5rem clamp(1rem, 5vw, 3rem) 2rem;
    scroll-margin-top: 0;
  }

  .eotw-nav {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--bone-soft);
  }

  .eotw-step {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    color: var(--bone);
    border: 1px solid color-mix(in srgb, var(--bone) 25%, transparent);
    border-radius: 50%;
    transition: border-color 0.2s, background 0.2s;
  }

  .eotw-step svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .eotw-step:hover,
  .eotw-step:focus-visible {
    border-color: var(--mood-glow);
    background: color-mix(in srgb, var(--mood-glow) 18%, transparent);
  }

  .eotw-dots {
    display: flex;
    gap: 0.45rem;
  }

  .eotw-count {
    min-width: 4.5em;
    text-align: center;
  }

  .eotw-play {
    padding: 0.5em 1em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone);
    border: 1px solid color-mix(in srgb, var(--bone) 25%, transparent);
    border-radius: 999px;
  }

  .eotw-play:hover,
  .eotw-play:focus-visible {
    border-color: var(--mood-glow);
  }

  .eotw-play[aria-pressed='false'] .eotw-play-on,
  .eotw-play[aria-pressed='true'] .eotw-play-off {
    display: none;
  }

  .eotw-play[aria-pressed='true'] {
    border-color: var(--mood-glow);
    background: color-mix(in srgb, var(--mood-glow) 22%, transparent);
  }

  /* the window and, under it, room for the line that goes with the
     picture: the words sit below the image now, never on top of it */
  .eotw-frame {
    --fw: min(80vw, 58rem, max((100svh - 15rem) * 1.6, 26rem));
    --ph: calc(var(--fw) * 0.625);
    position: relative;
    width: var(--fw);
    height: calc(var(--ph) + 7rem);
  }

  .eotw-pic {
    position: relative;
    display: block;
    height: var(--ph);
    overflow: hidden;
    border-radius: 2px;
    background: #000;
    box-shadow: 0 3rem 6rem -2rem rgb(0 0 0 / 75%), 0 0 6rem 0.6rem color-mix(in srgb, var(--mood-glow) 22%, transparent);
  }

  .eotw-frame-border {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--ph);
    z-index: 3;
    pointer-events: none;
    border: 1px solid color-mix(in srgb, var(--bone) 16%, transparent);
    box-shadow: inset 0 0 4rem 0.5rem rgb(0 0 0 / 45%);
  }

  .eotw-slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 1.1s ease;
  }

  .eotw-slide.is-active {
    opacity: 1;
    z-index: 1;
  }

  .eotw-slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
  }

  .eotw-slide.is-portrait :global(img) {
    object-fit: contain;
  }

  .eotw-slide.is-active :global(img) {
    filter: saturate(0.88) brightness(0.8);
    animation: eotw-kenburns 9s ease-out both;
  }

  @keyframes eotw-kenburns {
    from { transform: scale(1); }
    to { transform: scale(1.1); }
  }

  .eotw-line {
    max-width: 52ch;
    margin: 1rem auto 0;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.9rem + 0.45vw, 1.3rem);
    line-height: 1.5;
    color: var(--bone);
    text-shadow: 0 2px 16px rgb(0 0 0 / 70%);
    text-wrap: balance;
  }

  .eotw-tick {
    position: relative;
    width: 7px;
    height: 7px;
    padding: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--bone) 35%, transparent);
    transition: background 0.3s, transform 0.3s;
  }

  .eotw-tick::after {
    content: '';
    position: absolute;
    inset: -0.6rem -0.22rem;
  }

  .eotw-tick.is-active {
    background: var(--mood-glow);
    transform: scale(1.7);
  }

  @media (max-width: 700px) {
    .eotw-viewer {
      min-height: auto;
      padding-top: 3rem;
    }
    .eotw-nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.6rem 0.8rem;
    }
    .eotw-dots {
      order: 5;
      flex-basis: 100%;
      justify-content: center;
    }
    .eotw-frame {
      --fw: 90vw;
      --ph: min(calc(90vw * 0.75), 52svh);
      height: calc(var(--ph) + 9rem);
    }
    .eotw-line {
      font-size: var(--text-base);
      line-height: 1.45;
    }
  }

  .eotw-archive {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-4);
    max-width: 52rem;
    margin: 0 auto;
    padding: var(--space-5) var(--edge) var(--space-6);
  }

  .eotw-archive figure {
    margin: 0;
    content-visibility: auto;
    contain-intrinsic-size: 52rem 32rem;
  }

  .eotw-archive :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .eotw-studies {
    position: relative;
    z-index: 1;
    max-width: 76rem;
    margin: 0 auto;
    padding: var(--space-4) var(--edge) var(--space-3);
  }

  .eotw-studies h2,
  .manga h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-xl);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-transform: none;
    text-align: center;
    color: var(--bone);
    margin-bottom: var(--space-3);
    padding-inline: var(--edge);
  }

  /* the studies laid out like sheets on a night table: each one whole,
     at its own proportions, its words underneath */
  .eotw-studies-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    align-items: start;
    gap: clamp(1.2rem, 3vw, 2.5rem);
  }

  .eotw-studies-row figure {
    margin: 0;
  }

  .eotw-studies-row figure:nth-child(2) {
    margin-top: 1.6rem;
  }

  .eotw-study-pic {
    display: block;
    padding: 0.5rem;
    background: #f4efe6;
    box-shadow: 0 1.6rem 3rem -1.2rem rgb(0 0 0 / 70%), 0 0 2.5rem color-mix(in srgb, var(--mood-glow) 12%, transparent);
  }

  .eotw-studies-row :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .eotw-studies-row figcaption {
    margin-top: 0.7rem;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--bone-soft);
  }

  /* the text before the manga, set like the opening page of a book */
  .manga-prologue {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    max-width: 68rem;
    margin: 0 auto var(--space-5);
    padding: var(--space-4) var(--edge);
  }

  .manga-lead {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.15;
    color: var(--bone);
    border-top: 1px solid color-mix(in srgb, var(--mood-b) 50%, transparent);
    padding-top: var(--space-3);
  }

  .manga-intro {
    margin: 0;
    columns: 2 18rem;
    column-gap: clamp(1.5rem, 3vw, 2.5rem);
    font-size: var(--text-base);
    line-height: 1.75;
    color: color-mix(in srgb, var(--bone) 82%, transparent);
    text-wrap: pretty;
  }

  .manga-intro::first-letter {
    float: left;
    margin: 0.08em 0.12em 0 0;
    font-family: var(--font-display);
    font-size: 3.4em;
    line-height: 0.8;
    color: var(--mood-b);
  }

  @media (max-width: 800px) {
    .manga-prologue {
      grid-template-columns: 1fr;
    }
  }

  .manga {
    position: relative;
    z-index: 1;
    max-width: none;
    margin: 0 auto;
    padding: var(--space-6) 0 var(--space-5);
  }

  .keepsake {
    position: relative;
    z-index: 1;
    width: 12rem;
    margin: var(--space-6) auto;
  }

  .keepsake :global(img) {
    width: 100%;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--mood-b) 60%, transparent);
    box-shadow: 0 0 3rem 0.5rem color-mix(in srgb, var(--mood-b) 25%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .eotw-viewer,
    .eotw-rail,
    .eotw-slide,
    .eotw-tick {
      transition: none;
    }
    .eotw-slide.is-active :global(img) {
      animation: none;
    }
  }
</style>

<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  const ORDER_KEY = 'menghan-review-order';

  function savedGroup(group: string): string[] | null {
    if (!location.pathname.includes('/notes')) return null;
    try {
      const all = JSON.parse(localStorage.getItem(ORDER_KEY) || '[]');
      const hit = Array.isArray(all)
        ? all.find((entry) => entry.page === location.pathname && entry.group === group)
        : null;
      return hit?.ids ?? null;
    } catch {
      return null;
    }
  }

  function applyGroup(parent: Element, attr: string, ids: string[]) {
    const nodes = [...parent.querySelectorAll<HTMLElement>(`:scope > [${attr}]`)];
    const map = new Map(nodes.map((node) => [node.getAttribute(attr), node]));
    const anchor = parent.querySelector(':scope > .eotw-frame-border');
    ids.forEach((id) => {
      const node = map.get(id);
      if (node) parent.insertBefore(node, anchor);
    });
  }

  function initAtmosphere() {
    const roots = document.querySelectorAll<HTMLElement>('[data-atmosphere]');
    roots.forEach((root) => {
      if (root.dataset.atmoInit === '1') return;
      root.dataset.atmoInit = '1';

      const world = root.querySelector('[data-order-group="world"]');
      const worldOrder = savedGroup('world');
      if (world && worldOrder) applyGroup(world, 'data-note-id', worldOrder);
      const studies = root.querySelector('[data-order-group="studies"]');
      const studyOrder = savedGroup('studies');
      if (studies && studyOrder) applyGroup(studies, 'data-note-id', studyOrder);
      const manga = root.querySelector('[data-order-group="manga"]');
      const mangaOrder = savedGroup('manga');
      if (manga && mangaOrder) applyGroup(manga, 'data-note-id', mangaOrder);

      // the reveal itself is pure CSS (animation-timeline: view()) — no JS
      // gate between the work and whether it's actually visible
      const canvas = root.querySelector<HTMLCanvasElement>('[data-atmo-canvas]');
      const motion = document.documentElement.dataset.motion;
      if (canvas && motion !== 'quiet' && motion !== 'still' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const ctx = canvas.getContext('2d');
        if (ctx) {
          function resize() {
            const w = Math.min(canvas!.offsetWidth, window.innerWidth);
            const h = Math.min(canvas!.offsetHeight, window.innerHeight);
            canvas!.width = Math.max(1, w);
            canvas!.height = Math.max(1, h);
          }
          resize();
          window.addEventListener('resize', resize);

          const stars = Array.from({ length: 48 }, () => ({
            x: Math.random(),
            y: Math.random(),
            r: 0.35 + Math.random() * 1.1,
            phase: Math.random() * Math.PI * 2,
          }));

          // occasional shooting stars — rare enough to be a small surprise,
          // not a repeating pattern you clock immediately
          type Shooter = { x: number; y: number; vx: number; vy: number; life: number; maxLife: number };
          let shooters: Shooter[] = [];
          function maybeSpawnShooter() {
            if (Math.random() < 0.994 || shooters.length > 1 || !canvas) return;
            const startX = Math.random() * canvas.width;
            shooters.push({
              x: startX,
              y: -20,
              vx: -(2.5 + Math.random() * 2),
              vy: 5 + Math.random() * 2.5,
              life: 0,
              maxLife: 40 + Math.random() * 20,
            });
          }

          let raf = 0;
          function tick(t: number) {
            if (!ctx || !canvas) return;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#f0ebe0';
            stars.forEach((s) => {
              const tw = 0.25 + 0.55 * Math.sin(t * 0.001 + s.phase);
              ctx.globalAlpha = Math.max(0, tw);
              ctx.beginPath();
              ctx.arc(s.x * canvas.width, s.y * canvas.height, s.r, 0, Math.PI * 2);
              ctx.fill();
            });

            maybeSpawnShooter();
            shooters = shooters.filter((s) => s.life < s.maxLife);
            shooters.forEach((s) => {
              s.x += s.vx;
              s.y += s.vy;
              s.life += 1;
              const fade = 1 - s.life / s.maxLife;
              const grad = ctx.createLinearGradient(s.x, s.y, s.x - s.vx * 4, s.y - s.vy * 4);
              grad.addColorStop(0, `rgba(240, 235, 224, ${fade})`);
              grad.addColorStop(1, 'rgba(240, 235, 224, 0)');
              ctx.globalAlpha = 1;
              ctx.strokeStyle = grad;
              ctx.lineWidth = 1.4;
              ctx.beginPath();
              ctx.moveTo(s.x, s.y);
              ctx.lineTo(s.x - s.vx * 4, s.y - s.vy * 4);
              ctx.stroke();
            });

            raf = requestAnimationFrame(tick);
          }
          raf = requestAnimationFrame(tick);
          document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });
        }
      }

      // one window, turned by hand (buttons, dots, arrows, swipe) or played
      // as a slideshow; the slide order follows the DOM, which notes mode
      // may have reordered above
      const viewer = root.querySelector<HTMLElement>('[data-eotw-viewer]');
      if (!viewer) return;
      const slides = () => Array.from(viewer.querySelectorAll<HTMLElement>('[data-slide]'));
      const ticks = Array.from(viewer.querySelectorAll<HTMLButtonElement>('[data-tick]'));
      const count = viewer.querySelector<HTMLElement>('[data-eotw-count]');
      const play = viewer.querySelector<HTMLButtonElement>('[data-eotw-play]');
      let current = 0;

      function setActive(i: number) {
        const list = slides();
        current = (i + list.length) % list.length;
        list.forEach((s, si) => s.classList.toggle('is-active', si === current));
        ticks.forEach((t, ti) => t.classList.toggle('is-active', ti === current));
        if (count) count.textContent = String(current + 1).padStart(2, '0');
      }
      setActive(0);

      const stopPlay = () => {
        window.clearInterval(playTimer);
        playTimer = 0;
        play?.setAttribute('aria-pressed', 'false');
      };
      const userGo = (i: number) => {
        stopPlay();
        setActive(i);
      };

      viewer.querySelectorAll<HTMLButtonElement>('[data-eotw-step]').forEach((b) =>
        b.addEventListener('click', () => userGo(current + Number(b.dataset.eotwStep))),
      );
      ticks.forEach((t, i) => t.addEventListener('click', () => userGo(i)));
      play?.addEventListener('click', () => {
        if (playTimer) return stopPlay();
        play.setAttribute('aria-pressed', 'true');
        setActive(current + 1);
        playTimer = window.setInterval(() => setActive(current + 1), 6500);
      });
      viewer.tabIndex = -1;
      viewer.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        userGo(current + (e.key === 'ArrowRight' ? 1 : -1));
      });
      let startX = 0;
      let startY = 0;
      viewer.addEventListener('pointerdown', (e) => {
        startX = e.clientX;
        startY = e.clientY;
      });
      let swiped = false;
      viewer.addEventListener('pointerup', (e) => {
        const dx = e.clientX - startX;
        swiped = Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(e.clientY - startY) * 1.5;
        if (swiped) userGo(current + (dx < 0 ? 1 : -1));
      });
      viewer.addEventListener('click', (e) => {
        if (!swiped) return;
        swiped = false;
        e.stopPropagation();
        e.preventDefault();
      }, true);
    });
  }

  let playTimer = 0;

  document.addEventListener('astro:page-load', () => {
    initAtmosphere();
    requestAnimationFrame(() => ScrollTrigger.refresh());
  });

  document.addEventListener('astro:before-swap', () => {
    window.clearInterval(playTimer);
    playTimer = 0;
    ScrollTrigger.getAll().forEach((t) => t.kill());
  });
</script>
