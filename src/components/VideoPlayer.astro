<script>
  const VOLUME_KEY = 'vp-volume';

  function formatTime(seconds: number): string {
    if (!Number.isFinite(seconds)) return '0:00';
    const h = Math.floor(seconds / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    const s = Math.floor(seconds % 60)
      .toString()
      .padStart(2, '0');
    return h ? `${h}:${String(m).padStart(2, '0')}:${s}` : `${m}:${s}`;
  }

  function savedVolume(): number {
    try {
      const v = Number(localStorage.getItem(VOLUME_KEY));
      return localStorage.getItem(VOLUME_KEY) !== null && Number.isFinite(v) ? Math.min(1, Math.max(0, v)) : 1;
    } catch {
      return 1;
    }
  }

  type WebkitDoc = Document & { webkitFullscreenElement?: Element | null; webkitExitFullscreen?: () => void };
  type WebkitEl = HTMLElement & { webkitRequestFullscreen?: () => void };
  type WebkitVideo = HTMLVideoElement & { webkitEnterFullscreen?: () => void };

  const fsElement = () => document.fullscreenElement ?? (document as WebkitDoc).webkitFullscreenElement ?? null;

  let teardown: (() => void)[] = [];

  function initPlayers() {
    document.querySelectorAll<HTMLElement>('[data-video-player]').forEach((player) => {
      if (player.dataset.vpInit === '1') return;
      player.dataset.vpInit = '1';

      const q = <T extends Element>(sel: string) => player.querySelector<T>(sel);
      const video = q<HTMLVideoElement>('[data-vp-video]');
      const veil = q<HTMLButtonElement>('[data-vp-veil]');
      const playBtn = q<HTMLButtonElement>('[data-vp-play]');
      const muteBtn = q<HTMLButtonElement>('[data-vp-mute]');
      const volume = q<HTMLInputElement>('[data-vp-volume]');
      const fullBtn = q<HTMLButtonElement>('[data-vp-full]');
      const speedBtn = q<HTMLButtonElement>('[data-vp-speed-btn]');
      const speedMenu = q<HTMLElement>('[data-vp-speed-menu]');
      const progress = q<HTMLElement>('[data-vp-progress]');
      const fill = q<HTMLElement>('[data-vp-fill]');
      const buffered = q<HTMLElement>('[data-vp-buffered]');
      const knob = q<HTMLElement>('[data-vp-knob]');
      const timeEl = q<HTMLElement>('[data-vp-time]');
      if (!video || !veil || !playBtn || !muteBtn || !volume || !fullBtn || !speedBtn || !speedMenu || !progress || !fill || !buffered || !knob || !timeEl) return;

      const ac = new AbortController();
      const on = { signal: ac.signal };
      const src = video.getAttribute('src') ?? '';
      let retries = 0;
      let wantPlay = false;

      // A <video> that arrives through a view-transition swap was parsed in
      // an inert document, so some browsers never run its resource
      // selection until something forces it. load() does, on every path.
      video.load();

      const setPlaying = (playing: boolean) => {
        player.classList.toggle('is-playing', playing);
        playBtn.querySelector('.icon-play')?.classList.toggle('is-icon-hidden', playing);
        playBtn.querySelector('.icon-pause')?.classList.toggle('is-icon-hidden', !playing);
        const label = playing ? 'Pause' : 'Play';
        playBtn.setAttribute('aria-label', label);
        veil.setAttribute('aria-label', label);
        wake();
      };

      const setWaiting = (waiting: boolean) => player.classList.toggle('is-waiting', waiting);

      const reload = () => {
        const at = video.currentTime;
        const rate = video.playbackRate;
        video.src = src;
        video.load();
        video.addEventListener('loadedmetadata', () => {
          video.playbackRate = rate;
          if (at > 0) video.currentTime = at;
        }, { once: true, signal: ac.signal });
      };

      const startPlay = () => {
        wantPlay = true;
        if (video.networkState === HTMLMediaElement.NETWORK_EMPTY || video.error) reload();
        if (video.readyState < HTMLMediaElement.HAVE_FUTURE_DATA) setWaiting(true);
        video.play().catch((err: DOMException) => {
          // AbortError only means a load() interrupted this call; the
          // canplay handler below resumes it
          if (err.name === 'AbortError') return;
          wantPlay = false;
          setWaiting(false);
          if (err.name === 'NotAllowedError' || err.name === 'NotSupportedError') {
            player.classList.add('is-native');
            video.controls = true;
          }
        });
      };

      const togglePlay = () => {
        if (!video.paused) {
          wantPlay = false;
          video.pause();
          return;
        }
        startPlay();
      };

      // ---- volume ----
      const paintVolume = () => {
        const level = video.muted ? 0 : video.volume;
        volume.value = String(level);
        volume.style.setProperty('--vp-vol', `${level * 100}%`);
        muteBtn.querySelector('.icon-vol')?.classList.toggle('is-icon-hidden', level === 0 || level < 0.5);
        muteBtn.querySelector('.icon-vol-low')?.classList.toggle('is-icon-hidden', level === 0 || level >= 0.5);
        muteBtn.querySelector('.icon-mute')?.classList.toggle('is-icon-hidden', level !== 0);
        muteBtn.setAttribute('aria-label', level === 0 ? 'Unmute' : 'Mute');
      };
      const setVolume = (v: number) => {
        const next = Math.min(1, Math.max(0, v));
        video.volume = next;
        video.muted = next === 0;
        try {
          localStorage.setItem(VOLUME_KEY, String(next));
        } catch {}
      };
      video.volume = savedVolume();
      paintVolume();
      volume.addEventListener('input', () => setVolume(Number(volume.value)), on);
      muteBtn.addEventListener('click', () => {
        if (video.muted || video.volume === 0) {
          video.muted = false;
          if (video.volume === 0) video.volume = 0.6;
        } else {
          video.muted = true;
        }
      }, on);
      video.addEventListener('volumechange', paintVolume, on);

      // ---- speed ----
      const rateButtons = Array.from(speedMenu.querySelectorAll<HTMLButtonElement>('[data-vp-rate]'));
      const paintRate = () => {
        const r = video.playbackRate;
        speedBtn.textContent = `${r}×`;
        rateButtons.forEach((b) => b.setAttribute('aria-checked', String(Number(b.dataset.vpRate) === r)));
      };
      const toggleMenu = (open: boolean) => {
        speedMenu.hidden = !open;
        speedBtn.setAttribute('aria-expanded', String(open));
        if (open) (rateButtons.find((b) => b.getAttribute('aria-checked') === 'true') ?? rateButtons[0])?.focus();
      };
      speedBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMenu(speedMenu.hidden);
      }, on);
      rateButtons.forEach((b) =>
        b.addEventListener('click', () => {
          video.playbackRate = Number(b.dataset.vpRate);
          toggleMenu(false);
          speedBtn.focus();
        }, on)
      );
      speedMenu.addEventListener('keydown', (e) => {
        const i = rateButtons.indexOf(document.activeElement as HTMLButtonElement);
        if (e.key === 'ArrowDown') rateButtons[(i + 1) % rateButtons.length].focus();
        else if (e.key === 'ArrowUp') rateButtons[(i - 1 + rateButtons.length) % rateButtons.length].focus();
        else if (e.key === 'Escape') {
          toggleMenu(false);
          speedBtn.focus();
        } else return;
        e.preventDefault();
        e.stopPropagation();
      }, on);
      document.addEventListener('click', (e) => {
        if (!speedMenu.hidden && !speedMenu.contains(e.target as Node)) toggleMenu(false);
      }, on);
      video.addEventListener('ratechange', paintRate, on);

      // ---- fullscreen ----
      const isFs = () => fsElement() === player;
      const toggleFullscreen = () => {
        if (isFs()) {
          if (document.exitFullscreen) document.exitFullscreen().catch(() => {});
          else (document as WebkitDoc).webkitExitFullscreen?.();
          return;
        }
        const el = player as WebkitEl;
        if (el.requestFullscreen) el.requestFullscreen().catch(() => (video as WebkitVideo).webkitEnterFullscreen?.());
        else if (el.webkitRequestFullscreen) el.webkitRequestFullscreen();
        else (video as WebkitVideo).webkitEnterFullscreen?.();
      };
      const onFsChange = () => {
        const fs = isFs();
        player.classList.toggle('is-fs', fs);
        fullBtn.querySelector('.icon-enter')?.classList.toggle('is-icon-hidden', fs);
        fullBtn.querySelector('.icon-exit')?.classList.toggle('is-icon-hidden', !fs);
        fullBtn.setAttribute('aria-label', fs ? 'Exit fullscreen' : 'Fullscreen');
        if (fs) player.focus({ preventScroll: true });
        wake();
      };
      document.addEventListener('fullscreenchange', onFsChange, on);
      document.addEventListener('webkitfullscreenchange', onFsChange, on);
      fullBtn.addEventListener('click', toggleFullscreen, on);
      veil.addEventListener('dblclick', toggleFullscreen, on);

      // controls fade out in fullscreen while the film plays untouched
      let idleTimer = 0;
      function wake() {
        player.classList.remove('is-idle');
        window.clearTimeout(idleTimer);
        if (player.classList.contains('is-fs') && !video!.paused && speedMenu!.hidden) {
          idleTimer = window.setTimeout(() => player.classList.add('is-idle'), 2600);
        }
      }
      player.addEventListener('pointermove', wake, on);
      player.addEventListener('pointerdown', wake, on);

      // ---- progress ----
      const paintBuffered = () => {
        if (!video.duration || !video.buffered.length) return;
        const end = video.buffered.end(video.buffered.length - 1);
        buffered.style.width = `${(end / video.duration) * 100}%`;
      };

      const updateProgress = () => {
        const pct = video.duration ? (video.currentTime / video.duration) * 100 : 0;
        fill.style.width = `${pct}%`;
        knob.style.left = `${pct}%`;
        player.style.setProperty('--vp-p', String(pct / 100));
        progress.setAttribute('aria-valuenow', String(Math.round(pct)));
        timeEl.textContent = `${formatTime(video.currentTime)} / ${formatTime(video.duration)}`;
      };

      const seekBy = (delta: number) => {
        if (!Number.isFinite(video.duration)) return;
        video.currentTime = Math.min(video.duration, Math.max(0, video.currentTime + delta));
        updateProgress();
      };

      const seekFromEvent = (clientX: number) => {
        const rect = progress.getBoundingClientRect();
        const ratio = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
        if (Number.isFinite(video.duration)) {
          video.currentTime = ratio * video.duration;
          updateProgress();
        }
      };

      let dragging = false;
      progress.addEventListener('pointerdown', (e) => {
        dragging = true;
        progress.setPointerCapture(e.pointerId);
        seekFromEvent(e.clientX);
      }, on);
      progress.addEventListener('pointermove', (e) => {
        if (dragging) seekFromEvent(e.clientX);
      }, on);
      const endDrag = () => {
        dragging = false;
      };
      progress.addEventListener('pointerup', endDrag, on);
      progress.addEventListener('pointercancel', endDrag, on);

      // ---- keyboard, only while focus is inside this player ----
      player.addEventListener('keydown', (e) => {
        if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey) return;
        const target = e.target as HTMLElement;
        const onButton = target.tagName === 'BUTTON' && target !== veil;
        const onVolume = target === volume;
        const k = e.key;
        if ((k === ' ' || k === 'Enter') && onButton) return;
        if (k === ' ' || k === 'k' || k === 'K') togglePlay();
        else if (k === 'f' || k === 'F') toggleFullscreen();
        else if (k === 'm' || k === 'M') muteBtn.click();
        else if (k === 'ArrowRight' && !onVolume) seekBy(5);
        else if (k === 'ArrowLeft' && !onVolume) seekBy(-5);
        else if (k === 'ArrowUp' && !onVolume) setVolume(video.volume + 0.1);
        else if (k === 'ArrowDown' && !onVolume) setVolume(video.volume - 0.1);
        else if (k === 'Home') seekBy(-Infinity);
        else if (k === 'End') seekBy(Infinity);
        else return;
        e.preventDefault();
        wake();
      }, on);

      const side = q<HTMLButtonElement>('[data-vp-side]');
      side?.addEventListener('click', () => {
        const dark = player.dataset.saber !== 'dark';
        player.dataset.saber = dark ? 'dark' : 'light';
        side.setAttribute('aria-pressed', String(dark));
      }, on);

      // ---- playback plumbing ----
      veil.addEventListener('click', togglePlay, on);
      playBtn.addEventListener('click', togglePlay, on);
      video.addEventListener('play', () => setPlaying(true), on);
      video.addEventListener('pause', () => setPlaying(false), on);
      video.addEventListener('ended', () => setPlaying(false), on);
      video.addEventListener('waiting', () => setWaiting(true), on);
      video.addEventListener('playing', () => setWaiting(false), on);
      video.addEventListener('canplay', () => {
        setWaiting(false);
        if (wantPlay && video.paused) video.play().catch(() => {});
      }, on);
      video.addEventListener('timeupdate', updateProgress, on);
      const fitRatio = () => {
        if (!video.videoWidth || !video.videoHeight) return;
        player.style.setProperty('--vp-ratio', `${video.videoWidth} / ${video.videoHeight}`);
        player.classList.toggle('is-portrait', video.videoHeight > video.videoWidth);
      };
      fitRatio();
      video.addEventListener('loadedmetadata', fitRatio, on);
      video.addEventListener('loadedmetadata', updateProgress, on);
      video.addEventListener('durationchange', updateProgress, on);
      video.addEventListener('progress', paintBuffered, on);
      video.addEventListener('error', () => {
        if (retries >= 3) {
          setWaiting(false);
          return;
        }
        retries += 1;
        window.setTimeout(reload, 600 * retries);
      }, on);
      // a request the browser quietly gave up on (network hiccup, a
      // connection still held by the previous page) would otherwise
      // leave the player dead until a hard refresh
      video.addEventListener('stalled', () => {
        if (video.readyState === HTMLMediaElement.HAVE_NOTHING && retries < 3) {
          retries += 1;
          reload();
        }
      }, on);

      teardown.push(() => {
        ac.abort();
        window.clearTimeout(idleTimer);
        if (isFs()) document.exitFullscreen?.().catch(() => {});
        video.pause();
        // detached media elements keep buffering until garbage-collected,
        // holding connections the next page's videos need
        video.removeAttribute('src');
        video.load();
      });
    });
  }

  document.addEventListener('astro:page-load', initPlayers);
  document.addEventListener('astro:before-swap', () => {
    teardown.forEach((fn) => fn());
    teardown = [];
  });
</script>
