---
// One film player for every video on the site: a projector gate with
// sprocket edges and hand-wired controls. The native <video controls>
// bar never shows, except as a last resort if playback is refused.
import { withBase } from '@/lib/projects';

// A skin dresses the same player in a project's world: temple (Bajiajiang),
// road (Direction les champs), hok (Mulan), poppy (Emma), saber (Star Wars).
type Skin = 'film' | 'temple' | 'road' | 'hok' | 'poppy' | 'saber';
interface Props {
  src: string;
  poster?: string;
  preload?: 'metadata' | 'auto';
  class?: string;
  skin?: Skin;
  label?: string;
}
const { src, poster, preload = 'metadata', class: className, skin = 'film', label } = Astro.props;
const speeds = [0.25, 0.5, 0.75, 1, 1.25, 1.5, 1.75, 2];
const film = skin === 'film';
const poppy =
  '<g fill="#c0392b"><ellipse cx="20" cy="11" rx="9" ry="10"/><ellipse cx="29" cy="20" rx="10" ry="9"/><ellipse cx="20" cy="29" rx="9" ry="10"/><ellipse cx="11" cy="20" rx="10" ry="9"/></g>' +
  '<g fill="#8e1f17" opacity="0.55"><ellipse cx="25" cy="14" rx="5" ry="6"/><ellipse cx="15" cy="26" rx="5" ry="6"/></g>' +
  '<circle cx="20" cy="20" r="4.5" fill="#1a1410"/><g stroke="#1a1410" stroke-width="1.2"><path d="M20 13v-2M27 20h2M20 27v2M13 20h-2M25 15l1.5-1.5M15 25l-1.5 1.5M25 25l1.5 1.5M15 15l-1.5-1.5"/></g>';
---

<div class:list={['film-frame', `skin-${skin}`, className]} data-video-player data-skin={skin} data-saber={skin === 'saber' ? 'light' : undefined} tabindex="-1">
  {film && <span class="sprockets" aria-hidden="true"></span>}
  {skin === 'temple' && (
    <span class="vp-roof" aria-hidden="true">
      <svg viewBox="0 0 400 40" preserveAspectRatio="none">
        <path d="M0 30 Q40 30 60 14 L340 14 Q360 30 400 30 L400 40 L0 40 Z" fill="#2b1410" />
        <path d="M0 30 Q40 30 60 14 L340 14 Q360 30 400 30" fill="none" stroke="#c9a24a" stroke-width="1.6" />
        <path d="M60 14 L340 14" stroke="#c9a24a" stroke-width="3" />
        <path d="M150 14 L200 2 L250 14" fill="#2b1410" stroke="#c9a24a" stroke-width="1.4" />
      </svg>
      <span class="vp-lantern is-l"></span>
      <span class="vp-lantern is-r"></span>
    </span>
  )}
  {skin === 'hok' && (
    <>
      <span class="vp-corner is-tl" aria-hidden="true"></span>
      <span class="vp-corner is-tr" aria-hidden="true"></span>
      <span class="vp-corner is-bl" aria-hidden="true"></span>
      <span class="vp-corner is-br" aria-hidden="true"></span>
    </>
  )}
  {skin === 'poppy' && (
    <>
      <svg class="vp-poppy is-a" viewBox="0 0 40 40" aria-hidden="true" set:html={poppy} />
      <svg class="vp-poppy is-b" viewBox="0 0 40 40" aria-hidden="true" set:html={poppy} />
    </>
  )}
  {skin === 'saber' && (
    <div class="vp-nowplaying">
      <span class="vp-np-eq" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="vp-np-text">
        <span class="vp-np-kicker">now playing</span>
        {label && <span class="vp-np-title">{label}</span>}
      </span>
      <button type="button" class="vp-side" data-vp-side aria-pressed="false">
        <span class="vp-side-light">light side</span>
        <span class="vp-side-dark">dark side</span>
      </button>
    </div>
  )}
  <div class="film-gate">
    <video
      class="vp-video"
      data-vp-video
      src={withBase(src)}
      poster={poster ? withBase(poster) : undefined}
      preload={preload}
      playsinline
    ></video>
    <button type="button" class="vp-veil" data-vp-veil aria-label="Play">
      <svg class="vp-veil-icon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
      <span class="vp-spinner" aria-hidden="true"></span>
    </button>
  </div>
  {film && <span class="sprockets" aria-hidden="true"></span>}
  {skin === 'road' && (
    <span class="vp-field" aria-hidden="true">
      {Array.from({ length: 14 }, (_, i) => (
        <span class="vp-sunflower" style={`--i:${i}; --h:${0.55 + ((i * 37) % 5) * 0.12}`}></span>
      ))}
    </span>
  )}
  <div class="vp-controls" data-vp-controls>
    <button type="button" class="vp-btn" data-vp-play aria-label="Play">
      <svg class="icon-play" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
      <svg class="icon-pause is-icon-hidden" viewBox="0 0 24 24"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor" /></svg>
    </button>

    <div class="vp-volume">
      <button type="button" class="vp-btn" data-vp-mute aria-label="Mute">
        <svg class="icon-vol" viewBox="0 0 24 24"><path d="M4 9v6h4l5 5V4L8 9H4zm12.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4zM14 3.2v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6z" fill="currentColor" /></svg>
        <svg class="icon-vol-low is-icon-hidden" viewBox="0 0 24 24"><path d="M4 9v6h4l5 5V4L8 9H4zm12.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4z" fill="currentColor" /></svg>
        <svg class="icon-mute is-icon-hidden" viewBox="0 0 24 24"><path d="M4 9v6h4l5 5V4L8 9H4zm14.5 3L21 9.5l-1.4-1.4L17.1 10.6 14.6 8.1 13.2 9.5l2.5 2.5-2.5 2.5 1.4 1.4 2.5-2.5 2.5 2.5 1.4-1.4z" fill="currentColor" /></svg>
      </button>
      <input class="vp-volume-range" data-vp-volume type="range" min="0" max="1" step="0.01" value="1" aria-label="Volume" />
    </div>

    <span class="vp-time" data-vp-time>0:00 / 0:00</span>

    <div class="vp-progress" data-vp-progress role="slider" aria-label="Seek" tabindex="0" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <span class="vp-track"></span>
      <span class="vp-buffered" data-vp-buffered></span>
      <span class="vp-fill" data-vp-fill></span>
      <span class="vp-knob" data-vp-knob>
        {skin === 'road' && (
          <svg class="vp-scooter" viewBox="0 0 48 30" aria-hidden="true">
            <circle cx="10" cy="24" r="5" fill="#1b2a33" stroke="#f6efe2" stroke-width="1.6" />
            <circle cx="38" cy="24" r="5" fill="#1b2a33" stroke="#f6efe2" stroke-width="1.6" />
            <path d="M8 22 L30 22 L36 12 L40 12" fill="none" stroke="#e07b39" stroke-width="3.2" stroke-linejoin="round" stroke-linecap="round" />
            <path d="M14 21 Q14 15 22 15 L29 15 L27 21Z" fill="#e07b39" />
            <circle cx="20" cy="5" r="3.2" fill="#f2c14e" />
            <path d="M18 8 L22 15 L28 15" fill="none" stroke="#f6efe2" stroke-width="3" stroke-linecap="round" />
            <circle cx="13" cy="7" r="3" fill="#3a2a1e" />
            <path d="M12 10 L16 16" stroke="#9cc3d5" stroke-width="3" stroke-linecap="round" />
            <circle cx="41" cy="13" r="1.6" fill="#fff6c8" />
          </svg>
        )}
        {skin === 'temple' && <span class="vp-ember"></span>}
        {skin === 'poppy' && <svg class="vp-bloom" viewBox="0 0 40 40" aria-hidden="true" set:html={poppy} />}
        {skin === 'saber' && <span class="vp-tip"></span>}
      </span>
      {skin === 'saber' && (
        <svg class="vp-hilt" viewBox="0 0 40 12" aria-hidden="true">
          <rect x="0" y="2" width="40" height="8" rx="1.5" fill="#8b9199" />
          <rect x="4" y="2" width="3" height="8" fill="#2a2d33" />
          <rect x="10" y="2" width="3" height="8" fill="#2a2d33" />
          <rect x="16" y="2" width="3" height="8" fill="#2a2d33" />
          <rect x="24" y="0.5" width="6" height="11" rx="1" fill="#3a3e46" />
          <rect x="34" y="1" width="6" height="10" rx="1" fill="#c9ced6" />
          <rect x="26" y="3" width="2" height="2" fill="#ff4d4d" />
        </svg>
      )}
    </div>

    <div class="vp-speed">
      <button type="button" class="vp-btn vp-speed-btn" data-vp-speed-btn aria-haspopup="menu" aria-expanded="false" aria-label="Playback speed">1×</button>
      <div class="vp-speed-menu" data-vp-speed-menu role="menu" hidden>
        {speeds.map((s) => (
          <button type="button" role="menuitemradio" aria-checked={s === 1 ? 'true' : 'false'} data-vp-rate={s}>
            {s === 1 ? 'Normal' : `${s}×`}
          </button>
        ))}
      </div>
    </div>

    <button type="button" class="vp-btn" data-vp-full aria-label="Fullscreen">
      <svg class="icon-enter" viewBox="0 0 24 24"><path d="M4 9V4h5v2H6v3H4zm10-5h6v5h-2V6h-4V4zM4 15h2v3h3v2H4v-5zm14 0h2v5h-6v-2h4v-3z" fill="currentColor" /></svg>
      <svg class="icon-exit is-icon-hidden" viewBox="0 0 24 24"><path d="M7 4h2v5H4V7h3V4zm8 0h2v3h3v2h-5V4zM4 15h5v5H7v-3H4v-2zm11 0h5v2h-3v3h-2v-5z" fill="currentColor" /></svg>
    </button>
  </div>
</div>

<style>
  .film-frame {
    --vp-accent: var(--gold, #d8b36a);
    position: relative;
    max-width: 58rem;
    margin-inline: auto;
    padding: 0.7rem 0;
    background: #17120e;
    box-shadow: 0 2rem 5rem -1.5rem rgb(0 0 0 / 75%), 0 0 0 1px rgb(255 255 255 / 6%),
      0 0 4rem 0.4rem color-mix(in srgb, var(--mood-glow, transparent) 18%, transparent);
    outline: none;
  }

  .sprockets {
    display: block;
    height: 0.85rem;
    margin: 0 0.9rem;
    background-color: color-mix(in srgb, var(--vp-accent) 22%, #2a2118);
    background-image: repeating-linear-gradient(90deg, #17120e 0, #17120e 0.5rem, transparent 0.5rem, transparent 0.95rem);
    border-radius: 1px;
  }

  .film-gate {
    position: relative;
    margin: 0.6rem 0.9rem;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 8%);
    background: #000;
  }

  .film-frame.is-portrait:not(.is-fs) {
    max-width: min(30rem, 100%);
  }

  .film-frame.is-portrait:not(.is-fs) .vp-controls {
    flex-wrap: wrap;
    row-gap: 0.2rem;
  }

  .film-frame.is-portrait:not(.is-fs) .vp-progress {
    order: 5;
    flex-basis: 100%;
  }

  .film-frame.is-portrait:not(.is-fs) .vp-time {
    margin-right: auto;
  }

  .vp-video {
    width: 100%;
    aspect-ratio: var(--vp-ratio, 16 / 9);
    height: auto;
    display: block;
    object-fit: contain;
    background: #000;
  }

  .vp-video::-webkit-media-controls {
    display: none !important;
  }

  .film-frame.is-native .vp-video::-webkit-media-controls {
    display: initial !important;
  }

  .film-frame.is-native .vp-veil {
    display: none;
  }

  /* Fullscreen is styled from a class set on fullscreenchange rather than
     :fullscreen, which Safari only half supports. The grid pins the
     controls to the bottom whatever the screen ratio. */
  .film-frame.is-fs {
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    margin: 0;
    padding: 0.9rem 0 0.6rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    box-shadow: none;
    clip-path: none;
    border-radius: 0;
  }

  .film-frame.is-fs .film-gate {
    flex: 1 1 auto;
  }

  .film-frame.is-fs :is(.vp-roof, .vp-poppy, .vp-corner) {
    display: none;
  }

  .film-frame.is-fs::backdrop {
    background: #17120e;
  }

  .film-frame.is-fs .film-gate {
    min-height: 0;
    margin: 0.6rem 1.2rem;
  }

  .film-frame.is-fs .vp-video {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .film-frame.is-fs .sprockets {
    margin-inline: 1.2rem;
  }

  .film-frame.is-fs .vp-controls {
    margin-inline: 1.2rem;
  }

  /* the site's custom cursor lives outside the fullscreen layer */
  .film-frame.is-fs,
  .film-frame.is-fs * {
    cursor: auto !important;
  }

  .film-frame.is-fs button,
  .film-frame.is-fs .vp-progress,
  .film-frame.is-fs input {
    cursor: pointer !important;
  }

  .film-frame.is-fs.is-idle,
  .film-frame.is-fs.is-idle * {
    cursor: none !important;
  }

  .vp-controls,
  .film-frame.is-fs .sprockets {
    transition: opacity 0.35s;
  }

  .film-frame.is-fs.is-idle .vp-controls {
    opacity: 0;
    pointer-events: none;
  }

  .vp-veil {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    background: rgb(0 0 0 / 0%);
    transition: background 0.3s;
  }

  .vp-veil:hover {
    background: rgb(0 0 0 / 15%);
  }

  .vp-veil-icon {
    grid-area: 1 / 1;
    width: 4rem;
    height: 4rem;
    color: var(--bone);
    filter: drop-shadow(0 0.3rem 1rem rgb(0 0 0 / 60%));
    opacity: 0.92;
    transition: transform 0.25s var(--ease-out-expo), opacity 0.25s;
  }

  .vp-veil:hover .vp-veil-icon {
    transform: scale(1.08);
    opacity: 1;
  }

  .film-frame.is-playing .vp-veil-icon,
  .film-frame.is-playing .vp-veil:hover .vp-veil-icon {
    opacity: 0;
    transform: scale(0.7);
  }

  .vp-spinner {
    grid-area: 1 / 1;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 2px solid rgb(255 255 255 / 18%);
    border-top-color: var(--vp-accent);
    opacity: 0;
    transition: opacity 0.2s;
    animation: vp-spin 0.9s linear infinite;
    pointer-events: none;
  }

  .film-frame.is-waiting .vp-spinner {
    opacity: 1;
  }

  .film-frame.is-waiting .vp-veil-icon {
    opacity: 0;
  }

  @keyframes vp-spin {
    to { transform: rotate(360deg); }
  }

  .vp-controls {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.7rem 0.9rem 0.2rem;
    padding: 0 0.2rem;
  }

  .vp-btn {
    flex: none;
    width: 2.1rem;
    height: 2.1rem;
    display: grid;
    place-items: center;
    color: var(--bone);
    border-radius: 50%;
    transition: color var(--dur-fast), background var(--dur-fast);
  }

  .vp-btn:hover,
  .vp-btn[aria-expanded='true'] {
    color: var(--vp-accent);
    background: rgb(255 255 255 / 8%);
  }

  .vp-btn svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .is-icon-hidden {
    display: none;
  }

  .vp-volume {
    flex: none;
    display: flex;
    align-items: center;
  }

  .vp-volume-range {
    appearance: none;
    width: 0;
    height: 1.2rem;
    margin: 0;
    opacity: 0;
    background: transparent;
    transition: width 0.25s var(--ease-out-expo), opacity 0.2s, margin 0.25s;
    --vp-vol: 100%;
  }

  .vp-volume:hover .vp-volume-range,
  .vp-volume:focus-within .vp-volume-range {
    width: 5rem;
    margin-inline: 0.2rem 0.4rem;
    opacity: 1;
  }

  .vp-volume-range::-webkit-slider-runnable-track {
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--vp-accent) var(--vp-vol), rgb(255 255 255 / 18%) var(--vp-vol));
  }

  .vp-volume-range::-moz-range-track {
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--vp-accent) var(--vp-vol), rgb(255 255 255 / 18%) var(--vp-vol));
  }

  .vp-volume-range::-webkit-slider-thumb {
    appearance: none;
    width: 0.7rem;
    height: 0.7rem;
    margin-top: calc(1.5px - 0.35rem);
    border-radius: 50%;
    background: var(--vp-accent);
    border: none;
  }

  .vp-volume-range::-moz-range-thumb {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--vp-accent);
    border: none;
  }

  .vp-time {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: color-mix(in srgb, var(--bone) 70%, transparent);
    letter-spacing: 0.02em;
    min-width: 6.4em;
  }

  .vp-progress {
    position: relative;
    flex: 1 1 auto;
    height: 1.2rem;
    display: flex;
    align-items: center;
    cursor: pointer;
    touch-action: none;
  }

  .vp-track,
  .vp-buffered,
  .vp-fill {
    position: absolute;
    left: 0;
    height: 3px;
    border-radius: 999px;
    pointer-events: none;
  }

  .vp-track {
    right: 0;
    background: rgb(255 255 255 / 15%);
  }

  .vp-buffered {
    width: 0%;
    background: rgb(255 255 255 / 14%);
  }

  .vp-fill {
    width: 0%;
    background: linear-gradient(90deg, var(--mood-a, var(--vp-accent)), var(--vp-accent));
  }

  .vp-knob {
    position: absolute;
    left: 0%;
    width: 0.7rem;
    height: 0.7rem;
    margin-left: -0.35rem;
    border-radius: 50%;
    background: var(--vp-accent);
    box-shadow: 0 0 0 3px rgb(0 0 0 / 30%);
    pointer-events: none;
    transition: transform 0.15s;
  }

  .vp-progress:hover .vp-knob {
    transform: scale(1.25);
  }

  .vp-speed {
    position: relative;
    flex: none;
  }

  .vp-speed-btn {
    width: auto;
    min-width: 2.6rem;
    padding: 0 0.5rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .vp-speed-menu {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.5rem);
    z-index: 3;
    display: grid;
    min-width: 7rem;
    padding: 0.35rem;
    background: #17120e;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 6px;
    box-shadow: 0 1rem 2rem -0.6rem rgb(0 0 0 / 70%);
  }

  .vp-speed-menu[hidden] {
    display: none;
  }

  .vp-speed-menu button {
    padding: 0.4rem 0.7rem;
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: color-mix(in srgb, var(--bone) 75%, transparent);
    border-radius: 4px;
  }

  .vp-speed-menu button:hover,
  .vp-speed-menu button:focus-visible {
    background: rgb(255 255 255 / 8%);
    color: var(--bone);
  }

  .vp-speed-menu button[aria-checked='true'] {
    color: var(--vp-accent);
  }

  /* ================= skins ================= */
  .film-frame:not(.skin-film) .vp-knob:has(> *) {
    width: auto;
    height: auto;
    margin-left: 0;
    background: none;
    box-shadow: none;
    translate: -50% 0;
  }

  .film-frame:not(.skin-film) .vp-veil-icon {
    width: 4.6rem;
    height: 4.6rem;
    padding: 1.1rem 0.9rem 1.1rem 1.3rem;
    border-radius: 50%;
  }

  /* ---- temple: red lacquer shrine, the time burns down an incense stick ---- */
  .skin-temple {
    --vp-accent: #e9c46a;
    margin-top: 2.4rem;
    padding: 0.4rem 0 0.5rem;
    background:
      repeating-linear-gradient(90deg, rgb(0 0 0 / 0%) 0 22px, rgb(0 0 0 / 8%) 22px 23px),
      linear-gradient(180deg, #6d1410, #45090a 70%, #2e0607);
    border: 2px solid #c9a24a;
    box-shadow: inset 0 0 0 5px #45090a, inset 0 0 0 6px rgb(233 196 106 / 45%), 0 2rem 5rem -1.5rem rgb(0 0 0 / 80%),
      0 0 4rem 0.4rem rgb(214 104 40 / 22%);
  }

  .vp-roof {
    position: absolute;
    left: -5%;
    right: -5%;
    top: -2.3rem;
    height: 2.4rem;
    pointer-events: none;
  }

  .vp-roof svg {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(0 0.4rem 0.4rem rgb(0 0 0 / 50%));
  }

  .vp-lantern {
    position: absolute;
    top: 2.1rem;
    width: 1.3rem;
    height: 1.7rem;
    border-radius: 45%;
    background: radial-gradient(circle at 50% 40%, #ffcf7a, #d6352a 55%, #7d1410);
    box-shadow: 0 0 1.4rem 0.3rem rgb(255 150 60 / 45%);
    transform-origin: 50% -0.6rem;
    animation: vp-sway 4.5s ease-in-out infinite;
  }

  .vp-lantern::before,
  .vp-lantern::after {
    content: '';
    position: absolute;
    left: 50%;
    translate: -50% 0;
    background: #c9a24a;
  }

  .vp-lantern::before {
    top: -0.6rem;
    width: 1px;
    height: 0.6rem;
  }

  .vp-lantern::after {
    bottom: -0.55rem;
    width: 2px;
    height: 0.55rem;
  }

  .vp-lantern.is-l { left: 9%; }
  .vp-lantern.is-r { right: 9%; animation-delay: -2s; }

  @keyframes vp-sway {
    0%, 100% { rotate: -4deg; }
    50% { rotate: 4deg; }
  }

  .skin-temple .film-gate {
