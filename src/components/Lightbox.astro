---
// Click a picture in the work to see it whole, then zoom. The page can
// crop or grade an image; this view uses the file itself, unfiltered.
// An image may point to a larger file with data-full, and images inside a
// [data-lb-group] can be paged through with the arrows.
---

<div class="lightbox" data-lightbox hidden>
  <div class="lightbox-bar">
    <span class="lightbox-count" data-lb-count hidden></span>
    <button type="button" data-lb-out aria-label="Zoom out">−</button>
    <button type="button" data-lb-in aria-label="Zoom in">+</button>
    <button type="button" data-lb-close aria-label="Close">×</button>
  </div>
  <button type="button" class="lightbox-nav is-prev" data-lb-prev aria-label="Previous" hidden>‹</button>
  <button type="button" class="lightbox-nav is-next" data-lb-next aria-label="Next" hidden>›</button>
  <div class="lightbox-stage" data-lb-stage>
    <img data-lb-img alt="" draggable="false" />
  </div>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 800;
    background: rgb(9 8 10 / 94%);
    display: grid;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-bar {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .lightbox-count {
    margin-right: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--bone-soft);
  }

  .lightbox-bar button,
  .lightbox-nav {
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--void-line);
    border-radius: 999px;
    background: rgb(9 8 10 / 72%);
    color: var(--bone);
    font-family: var(--font-mono);
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 3rem;
    height: 3rem;
    font-size: 1.6rem;
    transform: translateY(-50%);
  }

  .lightbox-nav[hidden] {
    display: none;
  }

  .lightbox-nav.is-prev {
    left: var(--space-2);
  }

  .lightbox-nav.is-next {
    right: var(--space-2);
  }

  .lightbox-bar button:hover,
  .lightbox-nav:hover {
    color: var(--gold);
    border-color: var(--gold);
  }

  .lightbox-stage {
    min-height: 0;
    overflow: hidden;
    display: grid;
    place-items: center;
    cursor: grab;
    touch-action: none;
  }

  .lightbox-stage.is-dragging {
    cursor: grabbing;
  }

  .lightbox-stage img {
    max-width: min(92vw, 1100px);
    max-height: 86vh;
    width: auto;
    height: auto;
    object-fit: contain;
    transform-origin: center center;
    user-select: none;
    filter: none;
  }
</style>

<script>
  function initLightbox() {
    const root = document.querySelector<HTMLElement>('[data-lightbox]');
    if (!root || root.dataset.lbReady === '1') return;
    root.dataset.lbReady = '1';

    const stage = root.querySelector<HTMLElement>('[data-lb-stage]');
    const img = root.querySelector<HTMLImageElement>('[data-lb-img]');
    const btnIn = root.querySelector<HTMLButtonElement>('[data-lb-in]');
    const btnOut = root.querySelector<HTMLButtonElement>('[data-lb-out]');
    const btnClose = root.querySelector<HTMLButtonElement>('[data-lb-close]');
    const btnPrev = root.querySelector<HTMLButtonElement>('[data-lb-prev]');
    const btnNext = root.querySelector<HTMLButtonElement>('[data-lb-next]');
    const count = root.querySelector<HTMLElement>('[data-lb-count]');
    if (!stage || !img || !btnIn || !btnOut || !btnClose || !btnPrev || !btnNext || !count) return;

    let scale = 1;
    let x = 0;
    let y = 0;
    let group: HTMLImageElement[] = [];
    let index = 0;

    const paint = () => {
      img.style.transform = `translate(${x}px, ${y}px) scale(${scale})`;
    };

    const clampScale = (n: number) => Math.min(4, Math.max(1, n));

    const reset = () => {
      scale = 1;
      x = 0;
      y = 0;
      paint();
    };

    const show = (source: HTMLImageElement) => {
      img.src = source.dataset.full || source.currentSrc || source.src;
      img.alt = source.alt || '';
      reset();
      const paged = group.length > 1;
      btnPrev.hidden = !paged;
      btnNext.hidden = !paged;
      count.hidden = !paged;
      count.textContent = paged ? `${index + 1} / ${group.length}` : '';
    };

    const open = (source: HTMLImageElement) => {
      const owner = source.closest('[data-lb-group]');
      group = owner ? Array.from(owner.querySelectorAll<HTMLImageElement>('img')) : [source];
      index = Math.max(0, group.indexOf(source));
      show(source);
      root.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      btnClose.focus();
    };

    const step = (delta: number) => {
      if (group.length < 2) return;
      index = (index + delta + group.length) % group.length;
      show(group[index]);
    };

    const close = () => {
      root.hidden = true;
      img.removeAttribute('src');
      group = [];
      document.documentElement.style.overflow = '';
    };

    const zoomBy = (factor: number) => {
      const next = clampScale(scale * factor);
      if (next === 1) {
        x = 0;
        y = 0;
      }
      scale = next;
      paint();
    };

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target || root.contains(target)) return;
      if (target.closest('[data-lb-trigger]')) {
        const trigger = target.closest<HTMLElement>('[data-lb-trigger]')!;
        const hit = trigger.querySelector('img');
        if (hit) {
          event.preventDefault();
          open(hit);
        }
        return;
      }
      if (target.closest('a, button, video, [data-video-player], [data-pin-flip], [data-manga]')) return;
      const hit = target.closest('img');
      if (!hit || !hit.closest('main')) return;
      if (hit.clientWidth < 64) return;
      event.preventDefault();
      open(hit as HTMLImageElement);
    });

    btnClose.addEventListener('click', close);
    btnIn.addEventListener('click', () => zoomBy(1.25));
    btnOut.addEventListener('click', () => zoomBy(0.8));
    btnPrev.addEventListener('click', () => step(-1));
    btnNext.addEventListener('click', () => step(1));

    stage.addEventListener(
      'wheel',
      (event) => {
        if (root.hidden) return;
        event.preventDefault();
        zoomBy(event.deltaY < 0 ? 1.12 : 0.9);
      },
      { passive: false }
    );

    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    let swipeX = 0;

    stage.addEventListener('pointerdown', (event) => {
      swipeX = event.clientX;
      if (scale <= 1 || event.target === btnClose) return;
      dragging = true;
      lastX = event.clientX;
      lastY = event.clientY;
      stage.classList.add('is-dragging');
      stage.setPointerCapture(event.pointerId);
    });

    stage.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      x += event.clientX - lastX;
      y += event.clientY - lastY;
      lastX = event.clientX;
      lastY = event.clientY;
      paint();
    });

    const endDrag = () => {
      dragging = false;
      stage.classList.remove('is-dragging');
    };
    let swiped = false;
    stage.addEventListener('pointerup', (event) => {
      swiped = !dragging && scale <= 1 && group.length > 1 && Math.abs(event.clientX - swipeX) > 50;
      if (swiped) step(event.clientX < swipeX ? 1 : -1);
      endDrag();
    });
    stage.addEventListener('pointercancel', endDrag);

    document.addEventListener('keydown', (event) => {
      if (root.hidden) return;
      if (event.key === 'Escape') close();
      if (event.key === '+' || event.key === '=') zoomBy(1.25);
      if (event.key === '-' || event.key === '_') zoomBy(0.8);
      if (event.key === 'ArrowRight') step(1);
      if (event.key === 'ArrowLeft') step(-1);
    });

    root.addEventListener('click', (event) => {
      if (swiped) {
        swiped = false;
        return;
      }
      if (event.target === stage || event.target === root) close();
    });
  }

  document.addEventListener('astro:page-load', initLightbox);
</script>
