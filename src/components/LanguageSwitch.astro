---
const languages = { en: 'EN', fr: 'FR', zh: '简体', 'zh-Hant': '繁體' } as const;
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<nav class:list={['lang-switch', className]} aria-label="Language" data-lang-switch>
  {Object.entries(languages).map(([code, label]) => (
    <button type="button" data-lang-option={code} lang={code} aria-pressed={code === 'en' ? 'true' : 'false'}>
      {label}
    </button>
  ))}
</nav>

<style>
  .lang-switch {
    display: flex;
    gap: 0.7em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  .lang-switch button {
    position: relative;
    color: var(--bone-faint);
    transition: color var(--dur-fast);
    white-space: nowrap;
  }

  .lang-switch button::after {
    content: '';
    position: absolute;
    inset: -0.45rem -0.2rem;
  }

  .lang-switch button:hover {
    color: var(--bone);
  }

  .lang-switch button[aria-pressed='true'] {
    color: var(--gold);
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  import { applyScript } from '@/lib/traditional';

  const KEY = 'menghan-lang';
  const VALID = ['en', 'fr', 'zh', 'zh-Hant'];
  const SCROLL_KEY = 'menghan-lang-scroll';

  /** The URL of this page in another language, or null when it switches in place. */
  function urlFor(lang: string): string | null {
    const root = document.documentElement;
    if (root.dataset.langPage !== 'routed') return null;
    const base = root.dataset.base ?? '';
    const rest = location.pathname.slice(base.length);
    const bare = rest.replace(/^\/(fr|zh)(?=\/|$)/, '') || '/';
    const prefix = lang === 'zh-Hant' ? 'zh' : lang;
    const target = prefix === 'en' ? `${base}${bare}` : `${base}/${prefix}${bare === '/' && !base ? '' : bare}`;
    return target === location.pathname ? null : target + location.hash;
  }

  function applyLang(lang: string) {
    // state lives only on the standard `lang` attribute — see global.css
    // for why it must never also be set as data-lang on <html>
    document.documentElement.setAttribute('lang', lang);
    document.querySelectorAll('[data-lang-switch]').forEach((nav) => {
      nav.querySelectorAll('[data-lang-option]').forEach((btn) => {
        btn.setAttribute('aria-pressed', String(btn.getAttribute('data-lang-option') === lang));
      });
    });
    void applyScript(lang === 'zh-Hant');
  }

  function initSwitch() {
    document.querySelectorAll<HTMLButtonElement>('[data-lang-option]').forEach((btn) => {
      if (btn.dataset.langInit === '1') return;
      btn.dataset.langInit = '1';
      btn.addEventListener('click', () => {
        const lang = btn.dataset.langOption ?? 'en';
        if (lang === document.documentElement.getAttribute('lang')) return;
        try {
          localStorage.setItem(KEY, lang);
        } catch {
          /* private browsing */
        }
        const target = urlFor(lang);
        if (target) {
          // same page, other language: the reader stays where they were
          sessionStorage.setItem(SCROLL_KEY, String(window.scrollY));
          void navigate(target);
          return;
        }
        applyLang(lang);
        // a small reveal on the text that just became visible — the same
        // rise-and-fade language already used for the site's headings
        // (see reveal-text.ts), not a fade of the whole page.
        //
        // Animates the *parent* of each [data-lang] span, not the span
        // itself: transform has no effect on inline (non-replaced)
        // elements, and forcing display:inline-block on the span to work
        // around that would break normal word-wrap on longer paragraph
        // text. The parent (a <p>, <h1>, <li>, ...) is block-level and
        // already contains only the one now-visible-language span.
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const shown = lang === 'zh-Hant' ? 'zh' : lang;
          const seen = new Set<Element>();
          document.querySelectorAll<HTMLElement>(`[data-lang="${shown}"], [data-lang-block="${shown}"]`).forEach((el) => {
            const target = el.parentElement ?? el;
            if (seen.has(target)) return;
            seen.add(target);
            target.classList.remove('lang-pop-in');
            void (target as HTMLElement).offsetWidth;
            target.classList.add('lang-pop-in');
          });
        }
      });
    });

    // sync buttons to whatever the blocking head script already applied —
    // state lives only on the standard `lang` attribute, never data-lang
    // /zh/ pages are built in simplified Chinese; traditional is a reading
    // choice kept in the browser
    let current = document.documentElement.getAttribute('lang');
    try {
      if (current === 'zh' && localStorage.getItem(KEY) === 'zh-Hant') current = 'zh-Hant';
    } catch {
      /* private browsing */
    }
    if (current && VALID.includes(current)) applyLang(current);

    const kept = sessionStorage.getItem(SCROLL_KEY);
    if (kept !== null) {
      sessionStorage.removeItem(SCROLL_KEY);
      requestAnimationFrame(() => {
        const y = Number(kept);
        const lenis = (window as Window & { __lenis?: { scrollTo: (y: number, o: object) => void } }).__lenis;
        if (lenis) lenis.scrollTo(y, { immediate: true, force: true });
        else window.scrollTo(0, y);
      });
    }
  }

  document.addEventListener('astro:page-load', initSwitch);
</script>
